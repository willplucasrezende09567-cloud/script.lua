    W.states.bringThread = task.spawn(function()
        local st=tick()
        while W.states.isBringing and (tick()-st)<0.5 do W.stickBall(); task.wait(0.03) end
        W.states.isBringing=false
    end)
end
W.startLoopBring = function()
