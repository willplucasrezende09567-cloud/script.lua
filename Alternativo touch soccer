            if W.UI.langBlur and W.UI.langBlur.Parent then W.UI.langBlur:Destroy() end
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA("BlurEffect") then v:Destroy() end
            end
        end)
        pcall(function() W.UI.ScreenGui:Destroy() end)
    end
    W.addTap(YesBtn, function() ConfirmOverlay.Visible=false; closeGUI() end)
    W.addTap(NoBtn, function()
        TS:Create(ConfirmOverlay, TweenInfo.new(0.2), {BackgroundTransparency=1}):Play()
        task.wait(0.2); ConfirmOverlay.Visible=false
        if COBlur and COBlur.Parent then COBlur:Destroy(); COBlur=nil end
    end)
    W.addTap(W.UI.MinBtn, function()
        if animating then return end
        if minimized then
            minimized=false; animating=true
            W.UI.TabBar.Visible=true; W.UI.ContentArea.Visible=true
            W.UI.MinBtn.Text="−"
            local tw=TS:Create(W.UI.MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quad), {Size=FULL})
            tw:Play(); tw.Completed:Connect(function() animating=false end)
        else
            minimized=true; animating=true
            W.UI.TabBar.Visible=false; W.UI.ContentArea.Visible=false
            W.UI.MinBtn.Text="+"
            local tw=TS:Create(W.UI.MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quad), {Size=MIN})
            tw:Play(); tw.Completed:Connect(function() animating=false end)
        end
