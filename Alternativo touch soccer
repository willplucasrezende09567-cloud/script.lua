W.tryDefend = function()
    local b = W.getBall()
    if not b then return end
    local goal = W.GOALS[W.defendSelectedGoal == "A" and 1 or 2].pos
    if (b.Position - goal).Magnitude > W.DEFEND.radius then return end
    local now = tick()
    if now - W.states.defendLastKick < W.DEFEND.cooldown then return end
    W.states.defendLastKick = now
    local sz = b.Position.Z > goal.Z and 1 or -1
    local f = (Vector3.new(0,0,sz) * W.DEFEND.force) + Vector3.new(0, W.DEFEND.lift, 0)
    if f.Magnitude > 8000 then f = f.Unit * 8000 end
    local n2 = tick()
    if n2 - W.states.defendLastFire < 0.1 then return end
    W.states.defendLastFire = n2
    W.safeFire(W.TKN, W.UID, "", b.Position, f, Vector3.new(0,0,0))
end

W.startDefend = function()
    W.states.defendThread = task.spawn(function()
        while W.states.isDefending do
            pcall(W.tryDefend)
            task.wait(W.DEFEND.delay)
