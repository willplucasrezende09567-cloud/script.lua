        local tg = W.toggles[name]
        if tg then tg() end
        return
    end
    W.loaded[name] = true
    local url = W.urls[name]
    if not url then
        warn("[Willnzx] URL nao configurada para: " .. name)
        W.loaded[name] = false
        return
    end
    local ok, err = pcall(function()
        local code = game:HttpGet(url)
        loadstring(code)()
    end)
    if not ok then
        W.loaded[name] = false
        warn("[Willnzx] Erro ao carregar " .. name .. ": " .. tostring(err))
    end
end

