    W.startOrbitCamera = function(targetPart)
        if W.camConn then W.camConn:Disconnect() end
        if W.camInputConn then W.camInputConn:Disconnect() end
        
        W.camSubject = targetPart
        local cam = workspace.CurrentCamera
        cam.CameraType = Enum.CameraType.Scriptable
        
        W.camConn = RunService.RenderStepped:Connect(function()
            if not W.camSubject or not W.camSubject.Parent then return end
            local focus = W.camSubject.Position
            local dir = Vector3.new(
                math.sin(W.camYaw) * math.cos(W.camPitch),
                math.sin(W.camPitch),
                math.cos(W.camYaw) * math.cos(W.camPitch)
            )
            cam.CFrame = CFrame.new(focus + dir * W.camDistance, focus)
        end)
        
        W.camInputConn = UIS.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Delta
                W.camYaw = W.camYaw - delta.X * 0.005
                W.camPitch = math.clamp(W.camPitch + delta.Y * 0.005, -math.pi/2 + 0.1, math.pi/2 - 0.1)
            end
        end)
    end

    W.stopOrbitCamera = function()
        if W.camConn then W.camConn:Disconnect(); W.camConn = nil end
        if W.camInputConn then W.camInputConn:Disconnect(); W.camInputConn = nil end
        W.camSubject = nil
        local cam = workspace.CurrentCamera
        if cam then
            cam.CameraType = Enum.CameraType.Custom
            local c = LP.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if h then cam.CameraSubject = h end
        end
    end

