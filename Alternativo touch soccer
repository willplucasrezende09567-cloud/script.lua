    if not h then return end
    local bv = h:FindFirstChild("FlingVelocity")
    if bv then bv:Destroy() end
end

local _kpLastSafeLand = 0
local function kpSafeLand()
    if tick() - _kpLastSafeLand < 1.0 then return end
    _kpLastSafeLand = tick()
    local c = LP.Character
    local h = c and c:FindFirstChild("HumanoidRootPart")
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    if not h or not hum or hum.Health <= 0 then return end
    local refPos = W.kp.myOriginalCFrame and W.kp.myOriginalCFrame.Position or h.Position
    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = {c}
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local res = workspace:Raycast(Vector3.new(refPos.X, refPos.Y + 50, refPos.Z), Vector3.new(0, -1000, 0), rp)
    local groundY = res and res.Position.Y or refPos.Y
    local finalCF = CFrame.new(refPos.X, groundY + W.kp.SafeLandOffset, refPos.Z)
    pcall(function() h.CFrame = finalCF end)
    pcall(function()
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
    end)
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.zero
    bv.Parent = h
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 3000; bg.D = 500
    bg.CFrame = finalCF
    bg.Parent = h
    pcall(function() hum.PlatformStand = true end)
    task.wait(W.kp.SafeFlyDuration)
    if bv.Parent then bv:Destroy() end
    if bg.Parent then bg:Destroy() end
    pcall(function()
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
    end)
    pcall(function() hum.PlatformStand = false end)
    W.kp.myOriginalCFrame = nil
end

W.kpCleanup = function()
    kpKillFlingVel()
    kpRemoveNoclip()
    local c = LP.Character
    local h = c and c:FindFirstChild("HumanoidRootPart")
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    if h and hum then
        pcall(function() hum.PlatformStand = false end)
        pcall(function()
            h.AssemblyLinearVelocity = Vector3.zero
            h.AssemblyAngularVelocity = Vector3.zero
        end)
    end
    kpSafeLand()
    W.kp.spikePaused = false
    W.kp.spikeStartTime = 0
    kpRestoreCamera()
end

local function kpMoveDir(tRoot, tHum)
    local v = tRoot.AssemblyLinearVelocity
    local flat = Vector3.new(v.X, 0, v.Z)
    if flat.Magnitude > 0.1 then return flat.Unit
    elseif tHum and tHum.MoveDirection.Magnitude > 0.1 then return tHum.MoveDirection.Unit end
    return Vector3.zero
end

local function kpUpdateDir(cur, new)
    if new.Magnitude < 0.1 then return cur end
    if not cur or cur.Magnitude < 0.1 then return new end
    local dot = math.clamp(cur:Dot(new), -1, 1)
    local angle = math.deg(math.acos(dot))
    if angle > W.kp.DirectionChangeThreshold then return new end
    return cur
end

W.kpStop = function()
    W.kp.active = false
    W.kp.moving = false
    W.kp.dir = nil
    W.kp.targetStartY = nil
    W.kp.airFrames = 0
    W.kp.spikePaused = false
    W.kp.spikeStartTime = 0
    W.kp.activeTarget = nil
    kpStopSpectate()
    W.kpCleanup()
end

W.kpStart = function(target)
    if not target or kpIsDead(target) then return end
    W.kp.active = true
    W.kp.moving = false
    W.kp.dir = nil
    W.kp.targetStartY = nil
    W.kp.airFrames = 0
    W.kp.spikePaused = false
    W.kp.spikeStartTime = 0
    kpSaveMyPosition()
    kpApplyNoclip()
    kpSpectate(target)

    task.spawn(function()
        local stepDown = false
        while W.kp.active do
            local c = LP.Character
            if not c then
                LP.CharacterAdded:Wait()
                task.wait(0.2)
                c = LP.Character
            end
            if c then
                local hrp = c:FindFirstChild("HumanoidRootPart")
                local hum = c:FindFirstChildOfClass("Humanoid")
                if hrp and hum then
                    hum.PlatformStand = true
                    if hrp.Position.Y < W.kp.VoidY + 15 then
                        if W.kp.myOriginalCFrame then
                            pcall(function() hrp.CFrame = W.kp.myOriginalCFrame end)
                        end
                        kpKillFlingVel()
                        RunService.Heartbeat:Wait()
                        continue
                    end
                    for _, d in ipairs(c:GetDescendants()) do
                        if d:IsA("BasePart") and d.Name ~= "__BigHitbox" then
                            local isTorso = (d.Name == "UpperTorso" or d.Name == "Torso")
                            if d.CanCollide ~= isTorso then d.CanCollide = isTorso end
                        end
                    end
                    local t = W.kp.activeTarget
                    if not t or kpIsDead(t) or kpIsGone(t) then
                        kpKillFlingVel()
                        pcall(function()
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                        end)
                        W.kp.active = false
                        break
                    end
                    local tRoot = kpGetRoot(t)
                    local tHum = kpGetHumanoid(t)
                    local tTorso = kpGetTorso(t)
                    if tRoot and tRoot.Parent then
                        local spd = tRoot.AssemblyLinearVelocity.Magnitude
                        if spd > W.kp.SpikeThreshold then
                            if not W.kp.spikePaused then
                                W.kp.spikePaused = true
                                W.kp.spikeStartTime = tick()
                                kpKillFlingVel()
                                pcall(function()
                                    hrp.AssemblyLinearVelocity = Vector3.zero
                                    hrp.AssemblyAngularVelocity = Vector3.zero
                                end)
                            end
                            if W.kp.myOriginalCFrame then
                                pcall(function() hrp.CFrame = W.kp.myOriginalCFrame end)
                            end
                            hum.PlatformStand = true
                            if not W.kp.spectating then kpSpectate(t) end
                            RunService.Heartbeat:Wait()
                            continue
                        else
                            W.kp.spikePaused = false
                        end
                        if spd > W.kp.FloatTopStopVelocity then
                            W.kp.active = false
                            break
                        end
                        if not W.kp.targetStartY then W.kp.targetStartY = tRoot.Position.Y end
                        if tRoot.AssemblyLinearVelocity.Y > 300 or (tRoot.Position.Y - W.kp.targetStartY) > 60 then
                            W.kp.airFrames = W.kp.airFrames + 1
                        else
                            W.kp.airFrames = 0
                        end
                        if W.kp.airFrames >= W.kp.AirMinFrames then
                            W.kp.active = false
                            break
                        end
                        stepDown = not stepDown
                        local yOff = stepDown and -W.kp.FloatTopStepDown or 0
                        local refPos = (tTorso and tTorso.Position) or tRoot.Position
                        local tVel = tRoot.AssemblyLinearVelocity.Magnitude
                        if tVel >= W.kp.MoveVelocityThreshold then W.kp.moving = true
                        elseif tVel < W.kp.StopVelocityThreshold then W.kp.moving = false; W.kp.dir = nil end
                        local isMoving = W.kp.moving
                        if isMoving then
                            local newDir = kpMoveDir(tRoot, tHum)
                            W.kp.dir = kpUpdateDir(W.kp.dir, newDir)
                        end
                        local moveDir = W.kp.dir or Vector3.zero
                        local hasDir = moveDir.Magnitude > 0.1
                        local velY = tRoot.AssemblyLinearVelocity.Y
                        local isRising = velY > W.kp.FloatRisingThreshold
                        local basePos
                        if isRising and isMoving and hasDir then
                            basePos = refPos + (moveDir * W.kp.FloatTopFrontOffset) + Vector3.new(0, W.kp.FloatRisingOffset, 0)
                        elseif isRising then
                            basePos = refPos + Vector3.new(0, W.kp.FloatRisingOffset, 0)
                        elseif isMoving and hasDir then
                            basePos = refPos + (moveDir * W.kp.FloatTopFrontOffset) + Vector3.new(0, W.kp.FloatTopOffset, 0)
                        else
                            basePos = refPos + Vector3.new(0, W.kp.FloatTopOffset, 0)
                        end
                        local posDest = basePos + Vector3.new(0, yOff, 0)
                        hrp.CFrame = CFrame.lookAt(posDest, posDest + Vector3.new(0, -1, 0))
                        hrp.Velocity = Vector3.new(0, W.kp.FloatTopVelocity, 0)
                        hrp.RotVelocity = Vector3.zero
                        local bv = hrp:FindFirstChild("FlingVelocity")
                        if not bv then
                            bv = Instance.new("BodyVelocity")
                            bv.Name = "FlingVelocity"
                            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                            bv.Parent = hrp
                        end
                        bv.Velocity = Vector3.new(0, W.kp.FloatTopVelocity, 0)
                    end
                end
            end
            RunService.Heartbeat:Wait()
        end
        W.kpStop()
    end)
end

