W.processCommand = function(msg)
    local m = msg:lower():gsub("^%s+", ""):gsub("%s+$", "")
    if m:sub(1,1) == ";" then m = m:sub(2) end

    if m == "cmds" then W.loadModule("cmds"); return end
    if m == "cmdbar2" then W.loadModule("cmdbar2"); return end
    if m == "control" then W.loadModule("control"); return end
    if m == "trackerga" or m == "tracker g-a" or m == "tracker" then W.loadModule("trackerga"); return end

    -- 🌐 Idioma via comando
    if m == "lang pt" or m == "lang portugues" or m == "lang pt-br" then
        W.lang = "pt"; W.langRefresh()
        if W.sendToChat then W.sendToChat("[Willnzx] Idioma: Portugues") end
        return
    end
    if m == "lang en" or m == "lang english" or m == "lang ingles" then
        W.lang = "en"; W.langRefresh()
        if W.sendToChat then W.sendToChat("[Willnzx] Language: English") end
        return
    end

    if m == "update" then
        _G.Willnzx = nil
        W.loaded_base = nil
        W.loaded = {}
        pcall(function()
            local o = CoreGui:FindFirstChild("WillnzxGUI")
            if o then o:Destroy() end
        end)
        task.wait(0.3)
        loadstring(game:HttpGet("https://pastefy.app/HtWcu7oC/raw"))()
        return
    end

    if m == "resetgui" then
        _G.Willnzx = nil
        W.loaded_base = nil
        W.loaded = {}
        pcall(function()
            local o = CoreGui:FindFirstChild("WillnzxGUI")
            if o then o:Destroy() end
            local o2 = CoreGui:FindFirstChild("WillnzxCmdsGUI")
            if o2 then o2:Destroy() end
            local o3 = CoreGui:FindFirstChild("WillnzxCmdBarGUI")
            if o3 then o3:Destroy() end
            local o4 = CoreGui:FindFirstChild("ArrowControlGUI")
            if o4 then o4:Destroy() end
        end)
        task.wait(0.3)
        loadstring(game:HttpGet("https://pastefy.app/HtWcu7oC/raw"))()
        return
    end

    if m == "farmcoins" or m == "farm" then
        if W.states.isFarming then
            W.stopFarmCoins()
            W.setBtnInactive(FarmCoinsBtn, W.t("farm_off"))
        else
            W.startFarmCoins()
            W.setBtnActive(FarmCoinsBtn, W.t("farm_on"))
        end
        return
    end

    if m == "loop goal a" then
        W.stopAll(); W.selectedGoalIndex = 1; W.updGoals()
        W.states.isActive = true; W.setBtnActive(Button, W.t("auto_gol_on")); W.startAutoGoal(); return
    end
    if m == "loop goal b" then
        W.stopAll(); W.selectedGoalIndex = 2; W.updGoals()
        W.states.isActive = true; W.setBtnActive(Button, W.t("auto_gol_on")); W.startAutoGoal(); return
    end
    if m == "unloop goal" or m == "unloop goal a" or m == "unloop goal b" then
        W.states.isActive = false
        if W.states.loopThread then task.cancel(W.states.loopThread); W.states.loopThread = nil end
        W.setBtnInactive(Button, W.t("auto_gol_off")); return
    end

    if m == "gol a" then W.fireSingle(1); return end
    if m == "gol b" then W.fireSingle(2); return end

    if m == "tpgoal" then
        W.stopAll(); W.states.isTpGoal = true
        W.setBtnActive(TpGoalBtn, W.t("tp_goal_on"))
        W.startSpectating(); W.startTpGoal(); return
    end
    if m == "untpgoal" then
        W.states.isTpGoal = false
        if W.states.tpGoalThread then task.cancel(W.states.tpGoalThread); W.states.tpGoalThread = nil end
        W.stopSpectating(); W.setBtnInactive(TpGoalBtn, W.t("tp_goal_off")); return
    end

    if m == "defendgoal" then
        if W.states.isDefending then
            W.stopDefend(); W.setBtnInactive(DefendGoalBtn, W.t("defend_off"))
        else
            W.setBtnActive(DefendGoalBtn, W.t("defend_on") .. " (" .. W.t("goal_" .. string.lower(W.defendSelectedGoal)) .. ")")
            W.states.isDefending = true; W.startDefend()
        end
        return
    end
    if m == "defendgol a" or m == "defendgoal a" then
        W.defendSelectedGoal = "A"
        if not W.states.isDefending then
            W.setBtnActive(DefendGoalBtn, W.t("defend_on") .. " (" .. W.t("goal_a") .. ")")
            W.states.isDefending = true; W.startDefend()
        end
        return
    end
    if m == "defendgol b" or m == "defendgoal b" then
        W.defendSelectedGoal = "B"
        if not W.states.isDefending then
            W.setBtnActive(DefendGoalBtn, W.t("defend_on") .. " (" .. W.t("goal_b") .. ")")
            W.states.isDefending = true; W.startDefend()
        end
        return
    end
    if m == "undefend" or m == "undefendgoal" then
        W.stopDefend(); W.setBtnInactive(DefendGoalBtn, W.t("defend_off")); return
    end

    if m == "bringball" then
        W.stopAll(); W.states.isBringing = true
        W.setBtnActive(BringBtn, W.t("bring_on")); W.startBring(); return
    end
    if m == "unbringball" then
        W.states.isBringing = false
        if W.states.bringThread then task.cancel(W.states.bringThread); W.states.bringThread = nil end
        W.setBtnInactive(BringBtn, W.t("bring_off")); return
    end

    if m == "loopbring" then
        W.stopAll(); W.states.isLoopBringing = true
        W.setBtnActive(LoopBringBtn, W.t("loop_bring_on")); W.startLoopBring(); return
    end
    if m == "unloopbring" then
        W.states.isLoopBringing = false
        if W.states.loopBringThread then task.cancel(W.states.loopBringThread); W.states.loopBringThread = nil end
        W.setBtnInactive(LoopBringBtn, W.t("loop_bring_off")); return
    end

    if m == "skyball" then
        W.stopAll(); W.states.isSkying = true
        W.setBtnActive(SkyBtn, W.t("sky_on")); W.startSky(); return
    end
    if m == "unskyball" then
        W.states.isSkying = false
        if W.states.skyThread then task.cancel(W.states.skyThread); W.states.skyThread = nil end
        W.setBtnInactive(SkyBtn, W.t("sky_off")); return
    end

    if m == "freezeball" then
        W.stopAll(); W.setBtnActive(FreezeAllBtn, W.t("freeze_on")); W.startFreeze(); return
    end
    if m == "unfreezeball" then
        W.stopFreeze(); W.setBtnInactive(FreezeAllBtn, W.t("freeze_off")); return
    end

    if m == "bugball" then
        if W.states.isBugBall then return end
        W.stopAll(); W.states.isBugBall = true
        W.setBtnActive(BugBallBtn, W.t("bug_on")); W.startBugBall()
        return
    end

    if m == "boostall" then
        W.stopAll(); W.states.isBoostingAll = true
        W.setBtnActive(BoostAllBtn, W.t("boost_on") .. " (" .. W.boostMultiplier .. "x)"); W.startBoostAll(); return
    end
    if m == "unboostall" then
        W.states.isBoostingAll = false
        if W.states.boostAllThread then task.cancel(W.states.boostAllThread); W.states.boostAllThread = nil end
        W.setBtnInactive(BoostAllBtn, W.t("boost_off")); return
    end

    if m == "touchgoal" then
        W.stopAll(); W.states.isTouchGoal = true
        W.setBtnActive(TouchGoalBtn, W.t("touch_goal_on")); W.startTouchGoal(); return
    end
    if m == "untouchgoal" then
        W.states.isTouchGoal = false
        if W.states.touchGoalThread then task.cancel(W.states.touchGoalThread); W.states.touchGoalThread = nil end
        W.setBtnInactive(TouchGoalBtn, W.t("touch_goal_off")); return
    end

    if m == "moveball" then
        W.stopAll(); W.states.isMoveBall = true
        W.setBtnActive(MoveBallBtn, W.t("move_on")); W.startMoveBall(); return
    end
    if m == "unmoveball" then
        W.states.isMoveBall = false
        if W.states.moveBallThread then task.cancel(W.states.moveBallThread); W.states.moveBallThread = nil end
        W.setBtnInactive(MoveBallBtn, W.t("move_off")); return
    end

    if m == "orbitball" then
        W.stopAll(); W.states.isOrbitBall = true
        W.setBtnActive(OrbitBallBtn, W.t("orbit_on")); W.startOrbitBall(); return
    end
    if m == "unorbitball" then
        W.states.isOrbitBall = false
        if W.states.orbitBallThread then task.cancel(W.states.orbitBallThread); W.states.orbitBallThread = nil end
        W.setBtnInactive(OrbitBallBtn, W.t("orbit_off")); return
    end

    local mult = m:match("^boostmult%s+(%d+)$")
    if mult then
        local v = math.clamp(tonumber(mult), 1, 6)
        W.Knob.Position = UDim2.new((v-1)/5, -11, 0.5, -11)
        W.updDots(v)
        return
    end
end

