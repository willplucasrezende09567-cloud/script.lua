local DEFEND = {radius=5, force=5000, lift=50, delay=0.08, cooldown=0.15}

local function tryDefend()
    local b = getBall()
    if not b then return end
    local goal = GOALS[defendSelectedGoal == "A" and 1 or 2].pos
    if (b.Position - goal).Magnitude > DEFEND.radius then return end
    local now = tick()
    if now - defendLastKick < DEFEND.cooldown then return end
    defendLastKick = now
    local sideZ = b.Position.Z > goal.Z and 1 or -1
    local dir = Vector3.new(0, 0, sideZ)
    local f = (dir * DEFEND.force) + Vector3.new(0, DEFEND.lift, 0)
    if f.Magnitude > 8000 then f = f.Unit * 8000 end
    local now2 = tick()
    if now2 - defendLastFire < 0.1 then return end
    defendLastFire = now2
    safeFire(TKN, UID, "", b.Position, f, Vector3.new(0, 0, 0))
end

local function startDefend()
    defendThread = task.spawn(function()
        while isDefending do pcall(tryDefend); task.wait(DEFEND.delay) end
        defendThread = nil
    end)
end

local function stopDefend()
    isDefending = false
    if defendThread then task.cancel(defendThread); defendThread = nil end
end

