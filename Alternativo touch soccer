-- 🌤️ MINI GUI: BALL → SKY TARGET
-- ════════════════════════════════════════════════════════════
local initBallSkyMini = function()
    local SKY_TARGET  = Vector3.new(-323.04, 47.33, 21.16)
    local FORCE_XZ    = 3500
    local SKY_FORCE   = 5000
    local DELAY       = 0.05
    local TOLERANCE_XZ = 5
    local AUTO_STOP   = true
    pcall(function()
        local ex = CoreGui:FindFirstChild("BallSkyMiniGUI"); if ex then ex:Destroy() end
    end)
    pcall(function()
        local pg = LP:FindFirstChild("PlayerGui")
        local ex = pg and pg:FindFirstChild("BallSkyMiniGUI"); if ex then ex:Destroy() end
    end)
    local C = W.Colors
    local isActive = false
    local thread = nil
    local statusLabel, distLabel, yInfoLbl, toggleBtn
    local gui = Instance.new("ScreenGui")
    gui.Name = "BallSkyMiniGUI"; gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true; gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    pcall(function() gui.Parent = CoreGui end)
    if not gui.Parent then gui.Parent = LP:WaitForChild("PlayerGui") end
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 250, 0, 155)
    frame.Position = UDim2.new(1, -270, 0, 380)
    frame.BackgroundColor3 = C.bg; frame.BackgroundTransparency = 0.1
    frame.BorderSizePixel = 0; frame.Active = true; frame.ClipsDescendants = true
    frame.Parent = gui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Thickness = 1.5; stroke.Color = C.accent; stroke.Transparency = 0.3
    local grad = Instance.new("UIGradient", frame)
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(230, 240, 255)),
    })
    grad.Rotation = 45
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -70, 0, 24); title.Position = UDim2.new(0, 12, 0, 8)
    title.BackgroundTransparency = 1; title.Text = "🌤️ BALL → SKY TARGET"
    title.TextColor3 = C.textDark; title.TextSize = 12
    title.Font = Enum.Font.GothamBold; title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = frame
    local coordLabel = Instance.new("TextLabel")
    coordLabel.Size = UDim2.new(1, -24, 0, 14); coordLabel.Position = UDim2.new(0, 12, 0, 30)
    coordLabel.BackgroundTransparency = 1
    coordLabel.Text = string.format("X: %.2f  Y: %.2f  Z: %.2f", SKY_TARGET.X, SKY_TARGET.Y, SKY_TARGET.Z)
    coordLabel.TextColor3 = C.accent; coordLabel.TextSize = 10
    coordLabel.Font = Enum.Font.Code; coordLabel.TextXAlignment = Enum.TextXAlignment.Left
    coordLabel.Parent = frame
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 22, 0, 22); closeBtn.Position = UDim2.new(1, -30, 0, 10)
    closeBtn.BackgroundColor3 = C.btnIdle; closeBtn.BackgroundTransparency = 0.3
    closeBtn.Text = "×"; closeBtn.TextColor3 = C.red; closeBtn.TextSize = 14
    closeBtn.Font = Enum.Font.GothamBold; closeBtn.AutoButtonColor = false
    closeBtn.Parent = frame
    Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 6)
    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.new(1, -24, 0, 40); toggle.Position = UDim2.new(0, 12, 0, 52)
    toggle.BackgroundColor3 = C.btnIdle; toggle.Text = "▶ ATIVAR"
    toggle.TextSize = 13; toggle.Font = Enum.Font.GothamBold
    toggle.TextColor3 = C.accent; toggle.AutoButtonColor = false
    toggle.Parent = frame
    Instance.new("UICorner", toggle).CornerRadius = UDim.new(0, 8)
    toggleBtn = toggle
    local tStroke = Instance.new("UIStroke", toggle)
    tStroke.Thickness = 1.5; tStroke.Color = C.accent; tStroke.Transparency = 0.3
    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, -24, 0, 14); status.Position = UDim2.new(0, 12, 0, 100)
    status.BackgroundTransparency = 1; status.Text = "aguardando..."
    status.TextColor3 = C.accent; status.TextSize = 10
    status.Font = Enum.Font.Code; status.TextXAlignment = Enum.TextXAlignment.Left
    status.Parent = frame
    statusLabel = status
    local distLbl = Instance.new("TextLabel")
    distLbl.Size = UDim2.new(1, -24, 0, 14); distLbl.Position = UDim2.new(0, 12, 0, 116)
    distLbl.BackgroundTransparency = 1; distLbl.Text = "XZ: --"
    distLbl.TextColor3 = C.textDark; distLbl.TextSize = 10
    distLbl.Font = Enum.Font.Code; distLbl.TextXAlignment = Enum.TextXAlignment.Left
    distLbl.Parent = frame
    distLabel = distLbl
    local yInfoLbl = Instance.new("TextLabel")
    yInfoLbl.Size = UDim2.new(1, -24, 0, 14); yInfoLbl.Position = UDim2.new(0, 12, 0, 132)
    yInfoLbl.BackgroundTransparency = 1
    yInfoLbl.Text = "Y: --  (sky +" .. SKY_FORCE .. ")"
    yInfoLbl.TextColor3 = C.textDark; yInfoLbl.TextSize = 10
    yInfoLbl.Font = Enum.Font.Code; yInfoLbl.TextXAlignment = Enum.TextXAlignment.Left
    yInfoLbl.Parent = frame
    local function setActiveUI()
        toggle:SetAttribute("IsActive", true); toggle.Text = "🛑 DESATIVAR"
        TS:Create(toggle, TweenInfo.new(0.2), {
            BackgroundColor3 = C.btnPress, TextColor3 = C.textLight,
        }):Play()
        TS:Create(tStroke, TweenInfo.new(0.2), {Transparency = 0}):Play()
    end
    local function setInactiveUI()
        toggle:SetAttribute("IsActive", false); toggle.Text = "▶ ATIVAR"
        TS:Create(toggle, TweenInfo.new(0.2), {
            BackgroundColor3 = C.btnIdle, TextColor3 = C.accent,
        }):Play()
        TS:Create(tStroke, TweenInfo.new(0.2), {Transparency = 0.3}):Play()
        status.Text = "aguardando..."; status.TextColor3 = C.accent
    end
    local function startToTarget()
        if thread then task.cancel(thread); thread = nil end
        isActive = true
        thread = task.spawn(function()
            while isActive do
                local b = W.getBall()
                if b then
                    local diff = SKY_TARGET - b.Position
                    local flat = Vector3.new(diff.X, 0, diff.Z)
                    local distXZ = flat.Magnitude
                    if distXZ <= TOLERANCE_XZ then
                        if statusLabel then
                            statusLabel.Text = string.format("✅ XZ OK | Y: %.0f (alvo %.0f)", b.Position.Y, SKY_TARGET.Y)
                            statusLabel.TextColor3 = C.green
                        end
                        if AUTO_STOP then
                            isActive = false
                            if toggleBtn then
                                toggleBtn:SetAttribute("IsActive", false)
                                toggleBtn.Text = "▶ ATIVAR"
                                TS:Create(toggleBtn, TweenInfo.new(0.2), {
                                    BackgroundColor3 = C.btnIdle, TextColor3 = C.accent,
                                }):Play()
                            end
                            break
                        end
                    else
                        local dir = flat.Unit
                        local f = dir * FORCE_XZ + Vector3.new(0, SKY_FORCE, 0)
                        if f.Magnitude > 8000 then f = f.Unit * 8000 end
                        pcall(function()
                            W.KBE:FireServer(LP.Name, LP.UserId, "", b.Position, f, Vector3.new(0, 0, 0))
                        end)
                        if statusLabel then
                            statusLabel.Text = string.format("🚀 XZ %.0f | Y %.0f (alvo %.0f)", distXZ, b.Position.Y, SKY_TARGET.Y)
                            statusLabel.TextColor3 = C.red
                        end
                    end
                else
                    if statusLabel then
                        statusLabel.Text = "⏳ aguardando bola..."
                        statusLabel.TextColor3 = C.accent
                    end
                end
                task.wait(DELAY)
            end
        end)
    end
    local function stopToTarget()
        isActive = false
        if thread then task.cancel(thread); thread = nil end
    end
    W.addTap(toggle, function()
        if isActive then stopToTarget(); setInactiveUI()
        else startToTarget(); setActiveUI() end
    end)
    W.addTap(closeBtn, function()
        stopToTarget(); pcall(function() gui:Destroy() end)
    end)
    task.spawn(function()
        while gui and gui.Parent do
            local b = W.getBall()
            if b and distLabel and yInfoLbl then
                local diff = SKY_TARGET - b.Position
                local flat = Vector3.new(diff.X, 0, diff.Z)
                distLabel.Text = string.format("XZ: %.1f studs", flat.Magnitude)
                distLabel.TextColor3 = flat.Magnitude < TOLERANCE_XZ and C.green or C.textDark
                yInfoLbl.Text = string.format("Y: %.0f  (sky +%d)", b.Position.Y, SKY_FORCE)
                yInfoLbl.TextColor3 = math.abs(diff.Y) < 5 and C.green or C.textDark
            else
                if distLabel then distLabel.Text = "XZ: --" end
                if yInfoLbl then yInfoLbl.Text = "Y: --" end
            end
            task.wait(0.2)
        end
    end)
    toggle.MouseEnter:Connect(function()
        if not toggle:GetAttribute("IsActive") then
            TS:Create(tStroke, TweenInfo.new(0.2), {Transparency = 0}):Play()
        end
    end)
    toggle.MouseLeave:Connect(function()
        if not toggle:GetAttribute("IsActive") then
            TS:Create(tStroke, TweenInfo.new(0.2), {Transparency = 0.3}):Play()
        end
    end)
    closeBtn.MouseEnter:Connect(function() TS:Create(closeBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play() end)
    closeBtn.MouseLeave:Connect(function() TS:Create(closeBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0.3}):Play() end)
    local dragging, dragInput, dragStart, startPos
    local function updateDrag(input)
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    title.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragging then updateDrag(input) end
    end)
end

