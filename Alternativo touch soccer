local function kpApplyNoclip()
    local c = LP.Character
    if not c then return end
    for _, d in ipairs(c:GetDescendants()) do
        if d:IsA("BasePart") and d.Name ~= "__BigHitbox" then
            if d:GetAttribute("__KPNoclipOrig") == nil then
                d:SetAttribute("__KPNoclipOrig", d.CanCollide)
            end
            local isTorso = (d.Name == "UpperTorso" or d.Name == "Torso")
            d.CanCollide = isTorso
        end
    end
    W.kp.noclipActive = true
end

local function kpRemoveNoclip()
    if not W.kp.noclipActive then return end
    local c = LP.Character
    if c then
        for _, d in ipairs(c:GetDescendants()) do
            if d:IsA("BasePart") then
                local orig = d:GetAttribute("__KPNoclipOrig")
                if orig ~= nil then
                    d.CanCollide = orig
                    d:SetAttribute("__KPNoclipOrig", nil)
                end
            end
        end
    end
    W.kp.noclipActive = false
end

local function kpKillFlingVel()
    local c = LP.Character
