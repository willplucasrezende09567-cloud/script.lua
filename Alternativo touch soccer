local function collectCoins()
    if isCollectingCoins then return end
    local c = LP.Character
    local h = c and c:FindFirstChild("HumanoidRootPart")
    if not h then return end
    local folder = workspace:FindFirstChild("Coins")
    if not folder then
        if CoinTpBtn and setBtnInactive then setBtnInactive(CoinTpBtn, "COLETAR COINS") end
        return
    end
    isCollectingCoins = true
    local orig = h.CFrame
    local list = {}
    for _, o in ipairs(folder:GetChildren()) do
        if o:IsA("BasePart") then table.insert(list, o)
        elseif o:IsA("Model") then
            local p = o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart")
            if p then table.insert(list, p) end
        end
    end
    coinTpThread = task.spawn(function()
        for _, coin in ipairs(list) do
            if coin and coin.Parent and h and h.Parent then
                pcall(function() h.CFrame = CFrame.new(coin.Position + Vector3.new(0, 3, 0)) end)
                task.wait(0.1)
            end
        end
        if h and h.Parent then pcall(function() h.CFrame = orig end) end
        isCollectingCoins = false
        coinTpThread = nil
        if CoinTpBtn and setBtnInactive then setBtnInactive(CoinTpBtn, "COLETAR COINS") end
    end)
end

local CONTROL = {force=5000, lift=50, cooldown=0.15, holdRepeat=0.12}

local function ctrlFire(...)
    local now = tick()
    if now - controlLastFire < CONTROL.cooldown then return false end
    controlLastFire = now
    safeFire(...)
    return true
end

local DIRS = {
    up = function(c) return c.CFrame.LookVector end,
    down = function(c) return -c.CFrame.LookVector end,
    left = function(c) return -c.CFrame.RightVector end,
    right = function(c) return c.CFrame.RightVector end,
    upleft = function(c) return (c.CFrame.LookVector - c.CFrame.RightVector).Unit end,
    upright = function(c) return (c.CFrame.LookVector + c.CFrame.RightVector).Unit end,
    downleft = function(c) return (-c.CFrame.LookVector - c.CFrame.RightVector).Unit end,
    downright = function(c) return (-c.CFrame.LookVector + c.CFrame.RightVector).Unit end,
}

local function ctrlKick(name)
    local b = getBall()
    local cam = workspace.CurrentCamera
    if not b or not cam then return end
    local fn = DIRS[name]
    if not fn then return end
    local dir = fn(cam)
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.01 then return end
    dir = dir.Unit
    local f = (dir * CONTROL.force) + Vector3.new(0, CONTROL.lift, 0)
    if f.Magnitude > 8000 then f = f.Unit * 8000 end
    ctrlFire(TKN, UID, "", b.Position, f, Vector3.new(0,0,0))
end

