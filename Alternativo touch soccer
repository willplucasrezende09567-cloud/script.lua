local function drawTrajectory(list, pos, vel, totalTime)
    local gravity = Vector3.new(0, -workspace.Gravity, 0)
    local dt = totalTime / #list
    for i, dot in ipairs(list) do
        if not dot or not dot.Parent then break end
        local t = i * dt
        local p = pos + vel * t + 0.5 * gravity * t * t
        dot.Position = p
        dot.Transparency = 0.05
    end
end

local function calcFinalPos(pos, vel, totalTime)
    local gravity = Vector3.new(0, -workspace.Gravity, 0)
    return pos + vel * totalTime + 0.5 * gravity * totalTime * totalTime
end

local function updatePredicts()
    local now = tick()
    if now - W.states.predictLastUpdate < 0.03 then return end
    W.states.predictLastUpdate = now
    local b = W.getBall()
    local totalTime = W.CFGV.predictTime or 1.2
    if not b then
        if W.states.predictDots then hideList(W.states.predictDots) end
        if W.states.predictKickDots then hideList(W.states.predictKickDots) end
        if W.states.predictKickTarget and W.states.predictKickTarget.Parent then
            W.states.predictKickTarget.Transparency = 1
        end
        return
    end
    if W.states.isPredict and W.states.predictDots then
        drawTrajectory(W.states.predictDots, b.Position, b.Velocity, totalTime)
    elseif W.states.predictDots then
        hideList(W.states.predictDots)
    end
    if W.states.isPredictKick and W.states.predictKickDots then
        local cam = workspace.CurrentCamera
        local lookDir = cam.CFrame.LookVector
        local flatDir = Vector3.new(lookDir.X, 0, lookDir.Z)
        if flatDir.Magnitude > 0.001 then flatDir = flatDir.Unit
        else flatDir = Vector3.new(0, 0, -1) end
        local force = W.CFGV.predictKickForce or 250
        local lift = W.CFGV.predictKickLift or 45
        local kickVel = flatDir * force + Vector3.new(0, lift, 0)
        drawTrajectory(W.states.predictKickDots, b.Position, kickVel, totalTime)
        if W.states.predictKickTarget and W.states.predictKickTarget.Parent then
            local finalPos = calcFinalPos(b.Position, kickVel, totalTime)
            W.states.predictKickTarget.Position = finalPos
            W.states.predictKickTarget.Transparency = 0.05
        end
    else
        if W.states.predictKickDots then hideList(W.states.predictKickDots) end
        if W.states.predictKickTarget and W.states.predictKickTarget.Parent then
            W.states.predictKickTarget.Transparency = 1
        end
    end
    if not W.states.isPredict and not W.states.isPredictKick then
        if W.states.predictConn then W.states.predictConn:Disconnect(); W.states.predictConn = nil end
        if W.states.predictFolder and W.states.predictFolder.Parent then W.states.predictFolder:Destroy() end
        W.states.predictFolder = nil
        W.states.predictDots = nil
        W.states.predictKickDots = nil
        W.states.predictKickTarget = nil
    end
end

W.ensurePredictSystem = function()
    if not W.states.predictFolder or not W.states.predictFolder.Parent then
        local folder = Instance.new("Folder")
        folder.Name = "WillnzxPredictDots"
        folder.Parent = workspace
        W.states.predictFolder = folder
    end
    local dotCount = W.CFGV.predictDotCount or 35
    local dotSize = W.CFGV.predictDotSize or 0.7
    local targetSize = W.CFGV.predictTargetSize or 2
    if not W.states.predictDots or #W.states.predictDots == 0 then
        W.states.predictDots = buildDots(W.states.predictFolder, dotCount, dotSize, Color3.fromRGB(255, 220, 0))
    end
    if not W.states.predictKickDots or #W.states.predictKickDots == 0 then
        W.states.predictKickDots = buildDots(W.states.predictFolder, dotCount, dotSize, Color3.fromRGB(255, 220, 0))
    end
    if not W.states.predictKickTarget or not W.states.predictKickTarget.Parent then
        W.states.predictKickTarget = makeTargetBall(W.states.predictFolder, targetSize, Color3.fromRGB(255, 220, 0))
    end
    if not W.states.predictConn then
        W.states.predictConn = RunService.RenderStepped:Connect(updatePredicts)
    end
end

