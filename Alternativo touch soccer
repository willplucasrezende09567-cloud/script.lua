                    Size = UDim2.new(0, 300, 0, 300), Position = UDim2.new(0.5, -150, 0.5, -150),
                    BackgroundTransparency = 1
                }):Play()
                task.delay(0.6, function() Ripple:Destroy() end)
            end
            btn.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                    createRipple()
                    TS:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
                        Size = UDim2.new(1, -2, 0, 32),
                        Position = UDim2.new(0, 1, 0, y + 2),
                    }):Play()
                    TS:Create(s, TweenInfo.new(0.1), {Transparency=0}):Play()
                end
