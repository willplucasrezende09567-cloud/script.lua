W.DEFEND={radius=5,force=5000,lift=50,delay=0.08,cooldown=0.15}
W.states.defendLastKick=0
W.tryDefend = function()
    local b=W.getBall(); if not b then return end
    local goal=W.GOALS[W.defendSelectedGoal=="A" and 1 or 2].pos
    if (b.Position-goal).Magnitude>W.DEFEND.radius then return end
    local now=tick()
    if now-W.states.defendLastKick<W.DEFEND.cooldown then return end
    W.states.defendLastKick=now
    local sz=b.Position.Z>goal.Z and 1 or -1
    local f=(Vector3.new(0,0,sz)*W.DEFEND.force)+Vector3.new(0,W.DEFEND.lift,0)
    if f.Magnitude>8000 then f=f.Unit*8000 end
    W.safeFire(W.TKN,W.UID,"",b.Position,f,Vector3.new(0,0,0))
end
W.startDefend = function()
    W.states.defendThread = task.spawn(function()
        while W.states.isDefending do pcall(W.tryDefend); task.wait(W.DEFEND.delay) end
    end)
end
W.stopDefend = function()
    W.states.isDefending=false
    if W.states.defendThread then task.cancel(W.states.defendThread); W.states.defendThread=nil end
end

W.states.farmSeen={}; W.states.farmSeenTime={}; W.states.farmTotal=0
W.collectNewCoins = function()
    local c=LP.Character; local h=c and c:FindFirstChild("HumanoidRootPart")
    if not h then return end
    local folder=workspace:FindFirstChild("Coins"); if not folder then return end
    local now=tick()
    for k,t in pairs(W.states.farmSeenTime) do
        if now-t>3 then W.states.farmSeenTime[k]=nil; W.states.farmSeen[k]=nil end
    end
    for _,obj in ipairs(folder:GetChildren()) do
        if obj.Parent and not W.states.farmSeen[obj] then
            W.states.farmSeen[obj]=true; W.states.farmSeenTime[obj]=now
            local p
            if obj:IsA("BasePart") then p=obj
            elseif obj:IsA("Model") then p=obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") end
            if p and p.Parent then
                pcall(function() h.CFrame=CFrame.new(p.Position+Vector3.new(0,3,0)) end)
                W.states.farmTotal=W.states.farmTotal+1; task.wait(0.1)
            end
        end
    end
end
W.startFarmCoins = function()
    if W.states.farmThread then task.cancel(W.states.farmThread) end
    W.states.isFarming=true
    W.states.farmThread=task.spawn(function()
        while W.states.isFarming do W.collectNewCoins(); task.wait(0.1) end
    end)
end
W.stopFarmCoins = function()
