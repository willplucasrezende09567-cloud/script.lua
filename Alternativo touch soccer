local function buildDots(folder, count, size, color)
    local list = {}
    for i = 1, count do
        local dot = Instance.new("Part")
        dot.Shape = Enum.PartType.Ball
        dot.Size = Vector3.new(size, size, size)
        dot.Color = color
        dot.Material = Enum.Material.Neon
        dot.Anchored = true
        dot.CanCollide = false
        dot.CanQuery = false
        dot.CanTouch = false
        dot.CastShadow = false
        dot.Transparency = 0.05
        dot.Parent = folder
        table.insert(list, dot)
    end
    return list
end

local function makeTargetBall(folder, size, color)
    local ball = Instance.new("Part")
    ball.Shape = Enum.PartType.Ball
