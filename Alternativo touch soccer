W.startMoveBall = function()
    W.states.moveBallThread = task.spawn(function()
        local target = W.MOVEB
        while W.states.isMoveBall do
            local b = W.getBall()
            if not b then task.wait(0.2); continue end
            local diff = target - b.Position
            local flat = Vector3.new(diff.X, 0, diff.Z)
            local dist = flat.Magnitude
            if dist < 5 then
                target = (target == W.MOVEA) and W.MOVEB or W.MOVEA
                task.wait(0.15)
            else
                local v = b.Velocity
                local fv = Vector3.new(v.X, 0, v.Z)
                local indo = fv.Magnitude > 20 and fv.Unit:Dot(flat.Unit) > 0.7
                if not indo then
                    local f = flat.Unit * W.CFGV.moveForce + Vector3.new(0, W.CFGV.moveY, 0)
                    if f.Magnitude > 8000 then f = f.Unit * 8000 end
                    W.safeFire(W.TKN, W.UID, "", b.Position, f, Vector3.new(0, 0, 0))
                end
                task.wait(W.CFGV.moveDelay)
            end
        end
    end)
end
W.startOrbitBall = function()
    W.states.orbitBallThread = task.spawn(function()
        local n=#W.ORB; local seg,t,cnt=1,0,0
        while W.states.isOrbitBall do
            local b=W.getBall()
            if not b then 
                W.states.isOrbitBall=false; 
                if W.UI.OrbitBallBtn then W.setBtnInactive(W.UI.OrbitBallBtn, W.btn("orbit", false)) end
                break 
            end
            local p0=W.ORB[((seg-2)%n)+1]; local p1=W.ORB[seg]
            local p2=W.ORB[(seg%n)+1]; local p3=W.ORB[((seg+1)%n)+1]
            local tg=W.catmull(p0,p1,p2,p3,t)
            cnt=cnt+1
            if cnt%4==0 then W.safeFire(W.TKN,W.UID,"",b.Position,Vector3.new(0,0,0),Vector3.new(0,0,0)) end
            local diff=tg-b.Position
            local flat=Vector3.new(diff.X,0,diff.Z)
            if flat.Magnitude>1 then
                local f=flat.Unit*W.CFGV.orbitForce + Vector3.new(0,W.CFGV.orbitY,0)
                if f.Magnitude>8000 then f=f.Unit*8000 end
                W.safeFire(W.TKN,W.UID,"",b.Position,f,Vector3.new(0,0,0))
            end
            t=t+W.CFGV.orbitStep
            if t>=1 then t=0; seg=(seg%n)+1 end
            task.wait(W.CFGV.orbitDelay)
        end
    end)
end
