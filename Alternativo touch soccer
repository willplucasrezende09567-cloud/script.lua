W.loopResetActive = false
W.loopResetCharConn = nil

W.killPlayerNaN = function()
    local char = LP.Character or LP.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid", 3)
    local root = char:WaitForChild("HumanoidRootPart", 3)
    local camera = workspace.CurrentCamera
    if not hum or not root or not camera then return end

    local originalFallHeight = workspace.FallenPartsDestroyHeight
    local originalCamType = camera.CameraType

    camera.CameraType = Enum.CameraType.Scriptable

    pcall(function()
        workspace.FallenPartsDestroyHeight = 0/0
    end)

    pcall(function()
        root.CFrame = root.CFrame * Vector3.new(0/0, 0/0, 0/0)
    end)

    pcall(function()
        workspace.FallenPartsDestroyHeight = originalFallHeight
    end)

    task.wait(1)

    if hum and hum.Parent then
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
            hum.Health = 0
        end)
    end

    if camera then
        camera.CameraType = originalCamType
    end
end

W.startLoopReset = function()
    if W.loopResetCharConn then W.loopResetCharConn:Disconnect(); W.loopResetCharConn = nil end
    W.loopResetActive = true
    
    W.loopResetCharConn = LP.CharacterAdded:Connect(function()
        if not W.loopResetActive then return end
        task.spawn(function()
            task.wait(0.5)
            if W.loopResetActive then W.killPlayerNaN() end
        end)
    end)
    
    if LP.Character then
        task.spawn(function()
            W.killPlayerNaN()
        end)
    end
end

W.stopLoopReset = function()
    W.loopResetActive = false
    if W.loopResetCharConn then W.loopResetCharConn:Disconnect(); W.loopResetCharConn = nil end
end

