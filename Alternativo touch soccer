        local m = msg:lower():gsub("^%s+",""):gsub("%s+$","")
        if m:sub(1,1)==";" then m = m:sub(2) end
        if m == "cmds" then W.loadModule("cmds"); return end
        if m == "controle" then W.loadModule("controle"); return end
        if m == "trackerga" then W.loadModule("trackerga"); return end
        if m == "resetpos" then
            if W.UI.MainFrame then W.UI.MainFrame.Position = W.HOME_POS end
            return
        end
        if m == "loopreset" or m == "autobug" then
            if W.loopResetActive then W.stopLoopReset()
