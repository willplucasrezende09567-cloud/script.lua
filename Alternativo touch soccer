                local Ripple = Instance.new("Frame", btn)
                Ripple.Size = UDim2.new(0, 0, 0, 0); Ripple.Position = UDim2.new(0.5, 0, 0.5, 0)
                Ripple.BackgroundColor3 = C2.accent; Ripple.BackgroundTransparency = 0.5
                Ripple.BorderSizePixel = 0; Ripple.ZIndex = 2
