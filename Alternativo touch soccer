    W.addTap(W.UI.CloseBtn, function()
        if animating then return end
        if ConfirmOverlay.Visible then return end
        if minimized then
            minimized = false; animating = true
            W.UI.TabBar.Visible = true; W.UI.ContentArea.Visible = true
            W.UI.MinBtn.Text = "−"
            local tw = TS:Create(W.UI.MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quad), {Size = FULL})
            tw:Play(); tw.Completed:Wait(); animating = false
        end
        showConfirm()
    end)
    local dragging, dragInput, dragStart, startPos
    local function update(input)
        local delta = input.Position - dragStart
        W.UI.MainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
    W.UI.MainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = W.UI.MainFrame.Position
            TS:Create(W.UI.MainFrame, TweenInfo.new(0.2), {BackgroundTransparency=0.05}):Play()
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    TS:Create(W.UI.MainFrame, TweenInfo.new(0.3), {BackgroundTransparency=0.15}):Play()
                end
            end)
        end
    end)
    W.UI.MainFrame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragging then update(input) end
    end)
    local tabContents = {W.UI.Tab1, W.UI.Tab2, W.UI.Tab3, W.UI.Tab4}
    W.switchTab = function(index)
        for i,c in ipairs(tabContents) do c.Visible = (i==index) end
        for i,t in ipairs(W.UI.tabButtons) do
            if i==index then
                t:SetAttribute("IsTabActive", true)
                TS:Create(t, TweenInfo.new(0.25), {BackgroundColor3 = C.btnPress, TextColor3 = C.textLight}):Play()
                if t:FindFirstChildOfClass("UIStroke") then
                    TS:Create(t:FindFirstChildOfClass("UIStroke"), TweenInfo.new(0.25), {Transparency=0}):Play()
                end
            else
                t:SetAttribute("IsTabActive", false)
                TS:Create(t, TweenInfo.new(0.25), {BackgroundColor3 = C.btnIdle, TextColor3 = C.accent}):Play()
                if t:FindFirstChildOfClass("UIStroke") then
                    TS:Create(t:FindFirstChildOfClass("UIStroke"), TweenInfo.new(0.25), {Transparency=0.5}):Play()
                end
            end
        end
    end
    for i,t in ipairs(W.UI.tabButtons) do
        W.addTap(t, function() W.switchTab(i) end)
    end
    W.switchTab(1)
    task.spawn(function()
        task.wait(0.1)
        W.UI.MainFrame.BackgroundTransparency = 1
        W.UI.Stroke.Transparency = 1
        TS:Create(W.UI.MainFrame, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = FULL, Position = W.HOME_POS, BackgroundTransparency = 0.15
        }):Play()
        TS:Create(W.UI.Stroke, TweenInfo.new(0.5), {Transparency = 0.2}):Play()
    end)
end
