-- KICK PLAYER (Float Top)
W.kpFindPlayer = function(q)
    if not q or q == "" then return nil end
    q = tostring(q):lower():gsub("%s", "")
    local matches = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local n = p.Name:lower():gsub("%s", "")
            local d = (p.DisplayName or ""):lower():gsub("%s", "")
            if n:find(q, 1, true) or d:find(q, 1, true) then
                table.insert(matches, p)
            end
        end
    end
    local best, bs
    for _, p in ipairs(matches) do
        local n = p.Name:lower():gsub("%s", "")
        local d = (p.DisplayName or ""):lower():gsub("%s", "")
        local s = math.min(n:len(), d:len() > 0 and d:len() or 9999)
        if not best or s < bs then best = p; bs = s end
    end
    return best
end

local function kpGetRoot(p)
    local c = p and p.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function kpGetTorso(p)
    local c = p and p.Character
    if not c then return nil end
    return c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso")
end

local function kpGetHumanoid(p)
    local c = p and p.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function kpIsDead(p)
    if not p then return true end
    local c = p.Character
    if not c then return true end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h then return true end
    return h.Health <= 0
end

local function kpIsGone(p)
    if not p then return true end
    local ok, parent = pcall(function() return p.Parent end)
    if not ok or parent ~= Players then return true end
    return not Players:FindFirstChild(p.Name)
end

