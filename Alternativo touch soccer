local function startMoveBall()
    moveBallThread = task.spawn(function()
        local usingA, tStart, counter = true, tick(), 0
        while isMoveBall do
            local b = getBall()
            if not b then task.wait(0.2) continue end
            local target = usingA and MOVEA or MOVEB
            local dist = (target - b.Position).Magnitude
            if dist < 5 then usingA = not usingA; tStart = tick(); task.wait(0.05)
            else
                counter = counter + 1
                if counter % 3 == 0 then safeFire(TKN, UID, "", b.Position, Vector3.new(0,0,0), Vector3.new(0,0,0)) end
                local d = (target - b.Position).Unit
                local f = (d * CFGV.moveForce) + Vector3.new(0, CFGV.moveY, 0)
                safeFire(TKN, UID, "", b.Position, f, Vector3.new(0,0,0))
                task.wait(CFGV.moveDelay)
            end
            if (tick() - tStart) > 10 then usingA = not usingA; tStart = tick() end
        end
        moveBallThread = nil
    end)
end

local function startOrbitBall()
    orbitBallThread = task.spawn(function()
        local n = #ORB
        local seg, t, counter = 1, 0, 0
        while isOrbitBall do
            local b = getBall()
            if not b then
                isOrbitBall = false
                if OrbitBallBtn and setBtnInactive then setBtnInactive(OrbitBallBtn, "ORBIT BALL: DESATIVADO") end
                break
            end
            local p0 = ORB[((seg - 2) % n) + 1]
            local p1 = ORB[seg]
            local p2 = ORB[(seg % n) + 1]
            local p3 = ORB[((seg + 1) % n) + 1]
            local target = catmull(p0, p1, p2, p3, t)
            counter = counter + 1
            if counter % 2 == 0 then
                safeFire(TKN, UID, "", b.Position, Vector3.new(0,0,0), Vector3.new(0,0,0))
                safeFire(TKN, UID, "", b.Position, Vector3.new(0,0,0), Vector3.new(0,0,0))
                safeFire(TKN, UID, "", b.Position, Vector3.new(0,0,0), Vector3.new(0,0,0))
            end
            local dir = target - b.Position
            if dir.Magnitude > 1 then
                local f = dir * CFGV.orbitForce
                if f.Magnitude > 8000 then f = f.Unit * 8000 end
                f = f + Vector3.new(0, CFGV.orbitY, 0)
                safeFire(TKN, UID, "", b.Position, f, Vector3.new(0,0,0))
            end
            t = t + CFGV.orbitStep
            if t >= 1 then t = 0; seg = (seg % n) + 1 end
            task.wait(CFGV.orbitDelay)
        end
        orbitBallThread = nil
    end)
end

