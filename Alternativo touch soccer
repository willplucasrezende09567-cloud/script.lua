                    end
                else
                    t:SetAttribute("IsTabActive", false)
                    TS:Create(t, TweenInfo.new(0.25), {BackgroundColor3 = C.btnIdle, TextColor3 = C.accent}):Play()
                    if t:FindFirstChildOfClass("UIStroke") then
                        TS:Create(t:FindFirstChildOfClass("UIStroke"), TweenInfo.new(0.25), {Transparency=0.5}):Play()
                    end
                end
            end
