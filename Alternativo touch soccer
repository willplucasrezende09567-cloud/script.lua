W.exclusiveGroups = {atq = {}, bola = {}}

W.registerExclusive = function(group, btn, stateKey, keyName, startFn, stopFn, activeTextFn)
    table.insert(W.exclusiveGroups[group], {
        btn = btn, stateKey = stateKey, keyName = keyName,
        start = startFn, stop = stopFn, activeTextFn = activeTextFn,
    })
end

W.toggleExclusive = function(group, btn)
    local g = W.exclusiveGroups[group]
    local this
    for _, e in ipairs(g) do if e.btn == btn then this = e; break end end
    if not this then return end

    local isCurrentlyActive = W.states[this.stateKey] or btn:GetAttribute("IsActive")

    if isCurrentlyActive then
        W.states[this.stateKey] = false
        if this.stop then pcall(this.stop) end
        W.setBtnInactive(this.btn, W.btn(this.keyName, false))
    else
        for _, e in ipairs(g) do
            if e.btn ~= btn then
                W.states[e.stateKey] = false
                if e.stop then pcall(e.stop) end
                W.setBtnInactive(e.btn, W.btn(e.keyName, false))
            end
        end
        W.states[this.stateKey] = true
        local txt = this.activeTextFn and this.activeTextFn() or W.btn(this.keyName, true)
        W.setBtnActive(this.btn, txt)
        if this.start then pcall(this.start) end
    end
end

