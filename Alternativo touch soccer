        distLbl.Parent = frame
        distLabel = distLbl
        local yInfoLbl = Instance.new("TextLabel")
        yInfoLbl.Size = UDim2.new(1, -24, 0, 14); yInfoLbl.Position = UDim2.new(0, 12, 0, 132)
        yInfoLbl.BackgroundTransparency = 1
        yInfoLbl.Text = "Y: --  (sky +" .. SKY_FORCE .. ")"
        yInfoLbl.TextColor3 = C.textDark; yInfoLbl.TextSize = 10
        yInfoLbl.Font = Enum.Font.Code; yInfoLbl.TextXAlignment = Enum.TextXAlignment.Left
        yInfoLbl.Parent = frame
        local function setActiveUI()
            toggle:SetAttribute("IsActive", true); toggle.Text = "🛑 DISABLE"
            TS:Create(toggle, TweenInfo.new(0.2), {
                BackgroundColor3 = C.btnPress, TextColor3 = C.textLight,
            }):Play()
            TS:Create(tStroke, TweenInfo.new(0.2), {Transparency = 0}):Play()
        end
        local function setInactiveUI()
            toggle:SetAttribute("IsActive", false); toggle.Text = "▶ ENABLE"
            TS:Create(toggle, TweenInfo.new(0.2), {
                BackgroundColor3 = C.btnIdle, TextColor3 = C.accent,
            }):Play()
            TS:Create(tStroke, TweenInfo.new(0.2), {Transparency = 0.3}):Play()
            status.Text = "waiting..."; status.TextColor3 = C.accent
        end
        local function startToTarget()
            if thread then task.cancel(thread); thread = nil end
            isActive = true
            thread = task.spawn(function()
                while isActive do
                    local b = W.getBall()
                    if b then
                        local diff = SKY_TARGET - b.Position
                        local flat = Vector3.new(diff.X, 0, diff.Z)
                        local distXZ = flat.Magnitude
                        if distXZ <= TOLERANCE_XZ then
                            if statusLabel then
                                statusLabel.Text = string.format("✅ XZ OK | Y: %.0f (Target %.0f)", b.Position.Y, SKY_TARGET.Y)
                                statusLabel.TextColor3 = C.green
                            end
                            if AUTO_STOP then
                                isActive = false
                                if toggleBtn then
                                    toggleBtn:SetAttribute("IsActive", false)
                                    toggleBtn.Text = "▶ ENABLE"
                                    TS:Create(toggleBtn, TweenInfo.new(0.2), {
                                        BackgroundColor3 = C.btnIdle, TextColor3 = C.accent,
                                    }):Play()
                                end
                                break
                            end
                        else
                            local dir = flat.Unit
                            local f = dir * FORCE_XZ + Vector3.new(0, SKY_FORCE, 0)
                            if f.Magnitude > 8000 then f = f.Unit * 8000 end
                            pcall(function()
                                W.KBE:FireServer(LP.Name, LP.UserId, "", b.Position, f, Vector3.new(0, 0, 0))
                            end)
                            if statusLabel then
                                statusLabel.Text = string.format("🚀 XZ %.0f | Y %.0f (Target %.0f)", distXZ, b.Position.Y, SKY_TARGET.Y)
                                statusLabel.TextColor3 = C.red
                            end
                        end
                    else
                        if statusLabel then
                            statusLabel.Text = "⏳ waiting for ball..."
                            statusLabel.TextColor3 = C.accent
                        end
                    end
                    task.wait(DELAY)
                end
            end)
        end
        local function stopToTarget()
            isActive = false
            if thread then task.cancel(thread); thread = nil end
        end
        W.addTap(toggle, function()
            if isActive then stopToTarget(); setInactiveUI()
            else startToTarget(); setActiveUI() end
        end)
        W.addTap(closeBtn, function()
            stopToTarget(); pcall(function() gui:Destroy() end)
        end)
        task.spawn(function()
            while gui and gui.Parent do
                local b = W.getBall()
                if b and distLabel and yInfoLbl then
                    local diff = SKY_TARGET - b.Position
                    local flat = Vector3.new(diff.X, 0, diff.Z)
                    distLabel.Text = string.format("XZ: %.1f studs", flat.Magnitude)
                    distLabel.TextColor3 = flat.Magnitude < TOLERANCE_XZ and C.green or C.textDark
                    yInfoLbl.Text = string.format("Y: %.0f  (sky +%d)", b.Position.Y, SKY_FORCE)
                    yInfoLbl.TextColor3 = math.abs(diff.Y) < 5 and C.green or C.textDark
                else
                    if distLabel then distLabel.Text = "XZ: --" end
                    if yInfoLbl then yInfoLbl.Text = "Y: --" end
                end
                task.wait(0.2)
            end
        end)
        toggle.MouseEnter:Connect(function()
            if not toggle:GetAttribute("IsActive") then
                TS:Create(tStroke, TweenInfo.new(0.2), {Transparency = 0}):Play()
            end
        end)
        toggle.MouseLeave:Connect(function()
            if not toggle:GetAttribute("IsActive") then
                TS:Create(tStroke, TweenInfo.new(0.2), {Transparency = 0.3}):Play()
            end
        end)
        closeBtn.MouseEnter:Connect(function() TS:Create(closeBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play() end)
        closeBtn.MouseLeave:Connect(function() TS:Create(closeBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0.3}):Play() end)
        local dragging, dragInput, dragStart, startPos
        local function updateDrag(input)
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
        title.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true; dragStart = input.Position; startPos = frame.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then dragging = false end
                end)
            end
        end)
        title.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if input == dragInput and dragging then updateDrag(input) end
        end)
    end

