W.startMoveBall = function()
    W.states.moveBallThread = task.spawn(function()
        local uA, tS, cnt = true, tick(), 0
        while W.states.isMoveBall do
            local b = W.getBall()
            if not b then task.wait(0.2) continue end
            local tg = uA and W.MOVEA or W.MOVEB
            if (tg - b.Position).Magnitude < 5 then
                uA = not uA; tS = tick(); task.wait(0.05)
            else
                cnt = cnt + 1
                if cnt % 3 == 0 then
                    W.safeFire(W.TKN, W.UID, "", b.Position, Vector3.new(0,0,0), Vector3.new(0,0,0))
                end
                local d = (tg - b.Position).Unit
                local f = (d * W.CFGV.moveForce) + Vector3.new(0, W.CFGV.moveY, 0)
                W.safeFire(W.TKN, W.UID, "", b.Position, f, Vector3.new(0,0,0))
                task.wait(W.CFGV.moveDelay)
            end
            if (tick() - tS) > 10 then uA = not uA; tS = tick() end
        end
        W.states.moveBallThread = nil
    end)
end

W.startOrbitBall = function()
    W.states.orbitBallThread = task.spawn(function()
        local n = #W.ORB
        local seg, t, cnt = 1, 0, 0
        while W.states.isOrbitBall do
            local b = W.getBall()
            if not b then W.states.isOrbitBall = false; break end
            local p0 = W.ORB[((seg - 2) % n) + 1]
            local p1 = W.ORB[seg]
            local p2 = W.ORB[(seg % n) + 1]
            local p3 = W.ORB[((seg + 1) % n) + 1]
            local tg = W.catmull(p0, p1, p2, p3, t)
            cnt = cnt + 1
            if cnt % 2 == 0 then
                W.safeFire(W.TKN, W.UID, "", b.Position, Vector3.new(0,0,0), Vector3.new(0,0,0))
                W.safeFire(W.TKN, W.UID, "", b.Position, Vector3.new(0,0,0), Vector3.new(0,0,0))
                W.safeFire(W.TKN, W.UID, "", b.Position, Vector3.new(0,0,0), Vector3.new(0,0,0))
            end
            local dir = tg - b.Position
            if dir.Magnitude > 1 then
                local f = dir * W.CFGV.orbitForce
                if f.Magnitude > 8000 then f = f.Unit * 8000 end
                f = f + Vector3.new(0, W.CFGV.orbitY, 0)
                W.safeFire(W.TKN, W.UID, "", b.Position, f, Vector3.new(0,0,0))
            end
            t = t + W.CFGV.orbitStep
            if t >= 1 then t = 0; seg = (seg % n) + 1 end
            task.wait(W.CFGV.orbitDelay)
        end
        W.states.orbitBallThread = nil
    end)
end

W.startBugBall = function()
    W.states.bugBallThread = task.spawn(function()
        local t = 0
        while W.states.isBugBall do
            local b = W.getBall()
            local c = LP.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            if b and h then
                t = t + 0.1
                local tg = h.Position + Vector3.new(math.cos(t*W.CFGV.bugSpeed)*W.CFGV.bugRadius, W.CFGV.bugHeight, math.sin(t*W.CFGV.bugSpeed)*W.CFGV.bugRadius)
                local dir = tg - b.Position
                local f = dir.Unit * math.min(dir.Magnitude * W.CFGV.bugForceMult, W.CFGV.bugMaxForce)
                W.safeFire(W.TKN, W.UID, "", b.Position, f, Vector3.new(0,0,0))
            end
            task.wait(W.CFGV.bugDelay)
        end
        W.states.bugBallThread = nil
    end)
end

W.stickBall = function()
