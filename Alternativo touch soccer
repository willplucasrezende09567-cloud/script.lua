                        Size = UDim2.new(1, -4, 0, 36),
                        Position = UDim2.new(0, 2, 0, y),
                    }):Play()
                    local targetStroke = btn:GetAttribute("IsActive") and 0 or 0.3
                    TS:Create(s, TweenInfo.new(0.25), {Transparency=targetStroke}):Play()
                end
            end)
            btn:SetAttribute("IsActive", false)
            return btn
        end
