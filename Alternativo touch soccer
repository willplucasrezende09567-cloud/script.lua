W.kpGiveTool = function()
    if W.kpHasTool() then return false end
    W.kpRemoveTool()
    local tool = Instance.new("Tool")
    tool.Name = "ClickFloatTopTool"
    tool.RequiresHandle = false
    tool.CanBeDropped = false
    tool.ToolTip = "Clique/toca num player — Float Top"

    local function tryTarget()
        local m = LP:GetMouse()
        if not m then return nil end
        local target = m.Target
        if target then
            local model = target:FindFirstAncestorOfClass("Model")
            if model then
                local plr = Players:GetPlayerFromCharacter(model)
                if plr and plr ~= LP then return plr end
            end
        end
        local cam = workspace.CurrentCamera
        local ray = cam:ViewportPointToRay(m.X, m.Y)
        local rp = RaycastParams.new()
        rp.FilterDescendantsInstances = {LP.Character}
        rp.FilterType = Enum.RaycastFilterType.Exclude
        local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, rp)
        if result and result.Instance then
            local model = result.Instance:FindFirstAncestorOfClass("Model")
            if model then
                local plr = Players:GetPlayerFromCharacter(model)
                if plr and plr ~= LP then return plr end
            end
        end
        return nil
    end

    local function applyTarget()
        local plr = tryTarget()
        if plr then
            if W.kp.active and W.kp.activeTarget == plr then
                W.kpStop()
            else
                if W.kp.active then W.kpStop() end
                W.kp.activeTarget = plr
                W.kpStart(plr)
            end
        end
    end

    tool.Activated:Connect(applyTarget)

    tool.Equipped:Connect(function(mouse)
        if mouse then
            mouse.Button1Down:Connect(function()
                task.wait(0.05)
                if not W.kp.active then
                    applyTarget()
                end
            end)
        end
    end)

    tool.Destroying:Connect(function()
        if W.kp.toolObj == tool then
            W.kp.toolObj = nil
            if W.kp.active then W.kpStop() end
        end
    end)

    local bp = LP:FindFirstChildOfClass("Backpack")
    tool.Parent = bp or LP.Character or LP

    task.spawn(function()
        task.wait(0.1)
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and tool.Parent ~= char then
            pcall(function() hum:EquipTool(tool) end)
        end
    end)

    W.kp.toolObj = tool
    if not W.kpClickLoopRunning then
        W.kpClickLoopRunning = true
        task.spawn(function()
            kpClickLoop()
            W.kpClickLoopRunning = false
        end)
    end
    return true
end

