local hookSkip = false
W.getBall = function()
    local ff = workspace:FindFirstChild("FootballField")
    if ff then
        local sb = ff:FindFirstChild("SoccerBall")
        if sb then return sb end
        local f = ff:FindFirstChild("SoccerBall", true)
        if f then return f end
    end
    return workspace:FindFirstChild("SoccerBall", true)
end
W.safeFire = function(...)
    hookSkip=true; W.KBE:FireServer(...); hookSkip=false
end
W.addTap = function(btn, cb)
    local ts, tm, tt = nil,false,0
    btn.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            ts=i.Position; tm=false; tt=tick()
        end
    end)
    btn.InputChanged:Connect(function(i)
        if (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) and ts then
            if (i.Position-ts).Magnitude>12 then tm=true end
        end
    end)
    btn.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            if ts and not tm and (i.Position-ts).Magnitude<=12 and (tick()-tt)<=0.4 then cb() end
            ts=nil
        end
    end)
end
W.catmull = function(p0,p1,p2,p3,t)
    local t2,t3=t*t,t*t*t
    return 0.5*((2*p1)+(-p0+p2)*t+(2*p0-5*p1+4*p2-p3)*t2+(-p0+3*p1-3*p2+p3)*t3)
end
W.isInTeam = function()
    local tf=workspace:FindFirstChild("team")
    if tf then
        local m=tf:FindFirstChild(LP.Name)
        if m then
            for _,o in pairs(m:GetChildren()) do
                if o.Name:match("^Team%d%d%d%d$") then return true end
            end
        end
    end
    local c=LP.Character
    if c then
        for _,o in pairs(c:GetChildren()) do
            if o.Name:match("^Team%d%d%d%d$") then return true end
        end
    end
    return false
end
W.kpFindPlayer = function(q)
    if not q or q=="" then return nil end
    q=tostring(q):lower():gsub("%s","")
    local best, bs
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LP and p.Character then
            local n=p.Name:lower():gsub("%s","")
            local d=(p.DisplayName or ""):lower():gsub("%s","")
            if n:find(q,1,true) or d:find(q,1,true) then
                local s=math.min(n:len(), d:len()>0 and d:len() or 9999)
                if not best or s<bs then best=p; bs=s end
            end
        end
    end
    return best
end
