local function addTap(btn, cb)
    local touchStart, touchMoved, touchTime = nil, false, 0
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            touchStart = input.Position
            touchMoved = false
            touchTime = tick()
        end
    end)
    btn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if touchStart and (input.Position - touchStart).Magnitude > 12 then touchMoved = true end
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if touchStart then
                if not touchMoved and (input.Position - touchStart).Magnitude <= 12 and (tick() - touchTime) <= 0.4 then cb() end
                touchStart = nil
            end
        end
    end)
end

