local initOpenClose = function()
    local C = W.Colors
    local FULL = UDim2.new(0, 400, 0, 480)
    local MIN = UDim2.new(0, 400, 0, 46)
    W.HOME_POS = UDim2.new(0.5, -200, 0.5, -240)
    local minimized=false
    local animating=false
    local ConfirmOverlay = Instance.new("Frame", W.UI.MainFrame)
    ConfirmOverlay.Size=UDim2.new(1,0,1,0); ConfirmOverlay.BackgroundColor3=C.bg
    ConfirmOverlay.BackgroundTransparency=0.05; ConfirmOverlay.BorderSizePixel=0
    ConfirmOverlay.ZIndex=200; ConfirmOverlay.Active=true; ConfirmOverlay.Visible=false
    Instance.new("UICorner", ConfirmOverlay).CornerRadius=UDim.new(0,16)
    local COS=Instance.new("UIStroke", ConfirmOverlay)
