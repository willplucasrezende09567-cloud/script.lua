W.addTap = function(btn, cb)
    local ts, tm, tt = nil, false, 0
    btn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            ts = i.Position; tm = false; tt = tick()
        end
    end)
    btn.InputChanged:Connect(function(i)
        if (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) and ts then
            if (i.Position - ts).Magnitude > 12 then tm = true end
        end
    end)
    btn.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            if ts and not tm and (i.Position - ts).Magnitude <= 12 and (tick() - tt) <= 0.4 then cb() end
            ts = nil
        end
    end)
end

W.catmull = function(p0, p1, p2, p3, t)
    local t2, t3 = t*t, t*t*t
    return 0.5 * ((2*p1) + (-p0+p2)*t + (2*p0-5*p1+4*p2-p3)*t2 + (-p0+3*p1-3*p2+p3)*t3)
end

W.isInTeam = function()
    local c = LP.Character
    if not c then return false end
    for _, o in pairs(c:GetChildren()) do
        if o.Name:match("^Team%d+$") then return true end
        if o.Name == "Team" and (o:IsA("NumberValue") or o:IsA("IntValue")) and o.Value and o.Value > 0 then return true end
    end
    if LP.Team and tostring(LP.Team) ~= "" then return true end
    return false
end

W.getRandomPlayer = function()
    local l = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChildOfClass("Humanoid") then
            table.insert(l, p)
        end
    end
    if #l > 0 then return l[math.random(1, #l)] end
end

