W.stickBall = function()
    local b=W.getBall(); local c=LP.Character
    local h=c and c:FindFirstChild("HumanoidRootPart")
    if not b or not h then return end
    local diff=h.Position-b.Position
    local flat=Vector3.new(diff.X,0,diff.Z)
    if flat.Magnitude>1 then
        local f=flat.Unit*W.CFGV.bringForce + Vector3.new(0,W.CFGV.bringY,0)
        if f.Magnitude>8000 then f=f.Unit*8000 end
        W.safeFire(W.TKN,W.UID,"",b.Position,f,Vector3.new(0,0,0))
    end
end
