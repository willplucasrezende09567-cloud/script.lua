    COTitle.BackgroundTransparency=1; COTitle.Text="❓ Deseja fechar a GUI?"
    COTitle.TextColor3=C.textDark; COTitle.TextSize=15
    COTitle.Font=Enum.Font.GothamBold; COTitle.ZIndex=201
    local YesBtn = Instance.new("TextButton", ConfirmOverlay)
    YesBtn.Size=UDim2.new(0.5,-25,0,44); YesBtn.Position=UDim2.new(0,20,0,170)
    YesBtn.BackgroundColor3=C.red; YesBtn.Text="✔ SIM"; YesBtn.TextSize=14
    YesBtn.Font=Enum.Font.GothamBold; YesBtn.TextColor3=C.textLight
    YesBtn.AutoButtonColor=false; YesBtn.ZIndex=201
    Instance.new("UICorner", YesBtn).CornerRadius=UDim.new(0,10)
    local NoBtn = Instance.new("TextButton", ConfirmOverlay)
    NoBtn.Size=UDim2.new(0.5,-25,0,44); NoBtn.Position=UDim2.new(0.5,5,0,170)
    NoBtn.BackgroundColor3=C.green; NoBtn.Text="✖ NÃO"; NoBtn.TextSize=14
    NoBtn.Font=Enum.Font.GothamBold; NoBtn.TextColor3=C.textLight
    NoBtn.AutoButtonColor=false; NoBtn.ZIndex=201
    Instance.new("UICorner", NoBtn).CornerRadius=UDim.new(0,10)
    local COBlur=nil
    local function showConfirm()
        if not COBlur or not COBlur.Parent then
            COBlur = Instance.new("BlurEffect"); COBlur.Size = 14; COBlur.Parent = Lighting
        end
        ConfirmOverlay.Visible=true; ConfirmOverlay.BackgroundTransparency=1
        TS:Create(ConfirmOverlay, TweenInfo.new(0.25), {BackgroundTransparency=0.05}):Play()
    end
    local function closeGUI()
        _G.Willnzx_ANTIDUP = nil; _G.Willnzx = nil; W.loaded_base = nil
        pcall(function() W.stopSkidFling() end)
        pcall(function() W.stopLoopReset() end)
        pcall(function() W.stopFreeze() end)
        pcall(function() W.stopDefend() end)
        pcall(function() W.stopFarmCoins() end)
        pcall(function()
            local ex = CoreGui:FindFirstChild("BallSkyMiniGUI"); if ex then ex:Destroy() end
        end)
        W.states.isActive=false; W.states.isBringing=false; W.states.isLoopBringing=false
        W.states.isFreezing=false; W.states.isBoostingAll=false
        W.states.isSkying=false; W.states.isTouchGoal=false; W.states.isMoveBall=false
        W.states.isOrbitBall=false; W.states.isBugBall=false
        W.states.isTpGoal=false; W.states.isDefending=false; W.states.isFarming=false
        local threads = { W.states.loopThread, W.states.tpGoalThread, W.states.bringThread,
            W.states.loopBringThread, W.states.freezeThread, W.states.boostAllThread,
            W.states.skyThread, W.states.touchGoalThread, W.states.moveBallThread,
            W.states.orbitBallThread, W.states.bugBallThread, W.states.bugStopThread,
            W.states.defendThread, W.states.farmThread }
        for _, t in ipairs(threads) do
