local function processCommand(msg)
    local m = msg:lower():gsub("^%s+", ""):gsub("%s+$", "")
    if m == ";cmdbar2" then toggleCmdBar(); return end
    if m == ";cmds" then toggleCmds(); return end
    if m == ";loop goal a" then stopEverything(); selectedGoalIndex = 1; isActive = true; setBtnActive(Button, "AUTO-GOL: ATIVADO"); startAutoGoal(); return end
    if m == ";loop goal b" then stopEverything(); selectedGoalIndex = 2; isActive = true; setBtnActive(Button, "AUTO-GOL: ATIVADO"); startAutoGoal(); return end
    if m == ";unloop goal" or m == ";unloop goal a" or m == ";unloop goal b" then
        isActive = false
        if loopThread then task.cancel(loopThread); loopThread = nil end
        setBtnInactive(Button, "AUTO-GOL: DESATIVADO"); return
    end
    if m == ";gol a" then fireSingle(1); return end
    if m == ";gol b" then fireSingle(2); return end
    if m == ";tpgoal" then
        stopAll(); isTpGoal = true
        setBtnActive(TpGoalBtn, "TP GOAL: ATIVADO")
        startSpectating(); startTpGoal(); return
    end
    if m == ";untpgoal" then
        isTpGoal = false
        if tpGoalThread then task.cancel(tpGoalThread); tpGoalThread = nil end
        stopSpectating(); setBtnInactive(TpGoalBtn, "TP GOAL: DESATIVADO"); return
    end
    if m == ";control" then
        if isControl then stopControl(); setBtnInactive(ControlBtn, "CONTROL: DESATIVADO")
        else setBtnActive(ControlBtn, "CONTROL: ATIVADO"); startControl() end
        return
    end
    if m == ";defendgoal" then
        if isDefending then stopDefend(); setBtnInactive(DefendGoalBtn, "DEFEND GOAL: DESATIVADO")
        else setBtnActive(DefendGoalBtn, "DEFEND GOAL: ATIVADO (GOL " .. defendSelectedGoal .. ")"); isDefending = true; startDefend() end
        return
    end
    if m == ";defendgol a" or m == ";defendgoal a" then
        defendSelectedGoal = "A"
        if not isDefending then setBtnActive(DefendGoalBtn, "DEFEND GOAL: ATIVADO (GOL A)"); isDefending = true; startDefend() end
        return
    end
    if m == ";defendgol b" or m == ";defendgoal b" then
        defendSelectedGoal = "B"
        if not isDefending then setBtnActive(DefendGoalBtn, "DEFEND GOAL: ATIVADO (GOL B)"); isDefending = true; startDefend() end
        return
    end
    if m == ";undefend" or m == ";undefendgoal" then
        stopDefend(); setBtnInactive(DefendGoalBtn, "DEFEND GOAL: DESATIVADO"); return
    end
    if m == ";bringball" then stopAll(); isBringing = true; setBtnActive(BringBtn, "BRING BALL: ATIVADO"); startBring(); return end
    if m == ";unbringball" then isBringing = false; if bringThread then task.cancel(bringThread); bringThread = nil end; setBtnInactive(BringBtn, "BRING BALL: DESATIVADO"); return end
    if m == ";loopbring" then stopAll(); isLoopBringing = true; setBtnActive(LoopBringBtn, "LOOP BRING: ATIVADO"); startLoopBring(); return end
    if m == ";unloopbring" then isLoopBringing = false; if loopBringThread then task.cancel(loopBringThread); loopBringThread = nil end; setBtnInactive(LoopBringBtn, "LOOP BRING: DESATIVADO"); return end
    if m == ";skyball" then stopAll(); isSkying = true; setBtnActive(SkyBtn, "SKY BALL: ATIVADO"); startSky(); return end
    if m == ";unskyball" then isSkying = false; if skyThread then task.cancel(skyThread); skyThread = nil end; setBtnInactive(SkyBtn, "SKY BALL: DESATIVADO"); return end
    if m == ";freezeball" then stopAll(); setBtnActive(FreezeAllBtn, "FREEZE BALL: ATIVADO"); startFreeze(); return end
    if m == ";unfreezeball" then stopFreeze(); setBtnInactive(FreezeAllBtn, "FREEZE BALL: DESATIVADO"); return end
    if m == ";bugball" then
        if isBugBall then return end
        stopAll(); isBugBall = true; setBtnActive(BugBallBtn, "BUG BALL: ATIVADO"); startBugBall(); return
    end
    if m == ";boostall" then stopAll(); isBoostingAll = true; setBtnActive(BoostAllBtn, "BOOST ALL: ATIVADO (" .. boostMultiplier .. "x)"); startBoostAll(); return end
    if m == ";unboostall" then isBoostingAll = false; if boostAllThread then task.cancel(boostAllThread); boostAllThread = nil end; setBtnInactive(BoostAllBtn, "BOOST ALL: DESATIVADO"); return end
    if m == ";touchgoal" then stopAll(); isTouchGoal = true; setBtnActive(TouchGoalBtn, "TOUCH GOAL: ATIVADO"); startTouchGoal(); return end
    if m == ";untouchgoal" then isTouchGoal = false; if touchGoalThread then task.cancel(touchGoalThread); touchGoalThread = nil end; setBtnInactive(TouchGoalBtn, "TOUCH GOAL: DESATIVADO"); return end
    if m == ";moveball" then stopAll(); isMoveBall = true; setBtnActive(MoveBallBtn, "MOVE BALL: ATIVADO"); startMoveBall(); return end
    if m == ";unmoveball" then isMoveBall = false; if moveBallThread then task.cancel(moveBallThread); moveBallThread = nil end; setBtnInactive(MoveBallBtn, "MOVE BALL: DESATIVADO"); return end
    if m == ";orbitball" then stopAll(); isOrbitBall = true; setBtnActive(OrbitBallBtn, "ORBIT BALL: ATIVADO"); startOrbitBall(); return end
    if m == ";unorbitball" then isOrbitBall = false; if orbitBallThread then task.cancel(orbitBallThread); orbitBallThread = nil end; setBtnInactive(OrbitBallBtn, "ORBIT BALL: DESATIVADO"); return end
    local mult = m:match("^;boostmult%s+(%d+)$")
    if mult then
        local v = math.clamp(tonumber(mult), 1, 6)
        Knob.Position = UDim2.new((v-1)/5, -11, 0.5, -11); boostMultiplier = v; return
    end
end
