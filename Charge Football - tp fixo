local function criarBotaoPrincipal(nome, texto, cor, posicao)
    local btn = Instance.new("TextButton")
    btn.Name = nome
    btn.Size = UDim2.new(0, 130, 0, 40)
    btn.Position = posicao
    btn.BackgroundColor3 = cor
    btn.Text = texto
    btn.TextColor3 = COR_TEXTO
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Parent = mainFrame
    criarCorner(btn, 10)
    local s = criarStroke(btn, cor, 1.5)
    s.Transparency = 0.5

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {
            BackgroundColor3 = cor:Lerp(Color3.new(1, 1, 1), 0.3)
        }):Play()
        s.Transparency = 0.2
    end)
    btn.MouseLeave:Connect(function()
        if btn.Name == "TP" and tpAtivo then return end
        if btn.Name == "INTERCEPT" and interceptarAtivo then return end
        TweenService:Create(btn, TweenInfo.new(0.2), {
            BackgroundColor3 = cor
        }):Play()
        s.Transparency = 0.5
    end)

    return btn, s
end

