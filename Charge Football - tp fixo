-- ==================== Anti-flutuação ====================
-- Cria um BodyPosition que trava o personagem no lugar
local function garantirTrava()
    if not root or not root.Parent then return end
    if bodyPos and bodyPos.Parent then return end

    bodyPos = Instance.new("BodyPosition")
    bodyPos.MaxForce = Vector3.new(50000, 50000, 50000)
    bodyPos.P = 10000
    bodyPos.D = 500
    bodyPos.Position = root.Position
    bodyPos.Parent = root
end

local function removerTrava()
    if bodyPos then
        bodyPos:Destroy()
        bodyPos = nil
    end
end

-- Desativa estados que fazem o personagem subir/voar
local function desativarEstados()
    if not humanoid then return end
    pcall(function()
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
    end)
end

local function reativarEstados()
    if not humanoid then return end
    pcall(function()
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, true)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
    end)
end

-- ==================== Bola e Snapshot ====================
local bolaCache = nil
local ultimoSnapshot = { Position = Vector3.zero, Velocity = Vector3.zero }

local function getBola()
    if bolaCache and bolaCache.Parent then return bolaCache end
    bolaCache = workspace:FindFirstChild("LocalBall")
    return bolaCache
end

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ok, remotes = pcall(function()
    return ReplicatedStorage:WaitForChild("Framework"):WaitForChild("Remotes", 5)
end)

if ok and remotes then
    local BallSnapshot = remotes:FindFirstChild("BallSnapshot")
    if BallSnapshot then
        BallSnapshot.OnClientEvent:Connect(function(dados)
            if type(dados) == "table" then
                ultimoSnapshot.Position = dados.Position or ultimoSnapshot.Position
                ultimoSnapshot.Velocity = dados.Velocity or ultimoSnapshot.Velocity
            end
        end)
    end
end

