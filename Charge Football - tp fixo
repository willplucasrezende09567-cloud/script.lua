-- ==================== Interceptação ====================
local function calcularAntecipacao(distancia)
    if distancia < DIST_COLAR then
        return 0
    elseif distancia < DIST_CAPTURA then
        local fator = (distancia - DIST_COLAR) / (DIST_CAPTURA - DIST_COLAR)
        return ANTECIPACAO_MAX * fator
    else
        return ANTECIPACAO_MAX
    end
end

-- ==================== Loop principal ====================
RunService.RenderStepped:Connect(function()
    if not root or not root.Parent then return end
    local bola = getBola()
    if not bola then return end

    if tpAtivo then
        local posBola = bola.Position
        local rot = root.CFrame - root.CFrame.Position
        local novaPos = Vector3.new(posBola.X, Y_FIXO, posBola.Z)
        root.CFrame = CFrame.new(novaPos) * rot
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        if bodyPos and bodyPos.Parent then bodyPos.Position = novaPos end

        statusLabel.Text = "● TP ATIVO"
        statusLabel.TextColor3 = COR_VERDE
    end

    if interceptarAtivo then
        local posBola = bola.Position
        local velBola = ultimoSnapshot.Velocity
        if velBola.Magnitude < 0.5 then
            velBola = bola.AssemblyLinearVelocity
        end

        local dist = (root.Position - posBola).Magnitude
        local antecipacao = calcularAntecipacao(dist)

        local posAlvo
        if antecipacao > 0 and velBola.Magnitude > 1 then
            posAlvo = posBola + (velBola * antecipacao)
        else
            posAlvo = posBola
        end

        local rot = root.CFrame - root.CFrame.Position
        local novaPos = Vector3.new(posAlvo.X, Y_FIXO, posAlvo.Z)
        root.CFrame = CFrame.new(novaPos) * rot
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        if bodyPos and bodyPos.Parent then bodyPos.Position = novaPos end

        local modo, cor
        if dist < DIST_COLAR then
            modo = "● COLADO"; cor = COR_VERDE
        elseif dist < DIST_CAPTURA then
            modo = "● APROXIMANDO"; cor = COR_NEON
        else
            modo = "● INTERCEPTANDO"; cor = COR_AZUL
        end

        statusLabel.Text = modo
        statusLabel.TextColor3 = cor
        infoLabel.Text = string.format(
            "dist %.1f  ▸  vel %.1f\nantec %.2fs  ▸  y %.1f",
            dist, velBola.Magnitude, antecipacao, Y_FIXO
        )
    end

    if not tpAtivo and not interceptarAtivo then
        statusLabel.Text = "● INATIVO"
        statusLabel.TextColor3 = Color3.fromRGB(150, 150, 170)
        infoLabel.Text = ""
    end
end)
