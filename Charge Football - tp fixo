-- ==================== Funções de UI ====================
local function criarCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 12)
    c.Parent = parent
    return c
end

local function criarStroke(parent, cor, espessura)
    local s = Instance.new("UIStroke")
    s.Color = cor or COR_NEON
    s.Thickness = espessura or 1.5
    s.Transparency = 0.3
    s.Parent = parent
    return s
end

local function criarGradient(parent, cor1, cor2, rotacao)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(cor1, cor2)
    g.Rotation = rotacao or 45
    g.Parent = parent
    return g
end

