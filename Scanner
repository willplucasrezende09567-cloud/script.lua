-- FUNÇÕES DO SCANNER
-- ═══════════════════════════════════════════════
local function classificarRemote(obj)
    if obj:IsA("RemoteEvent") then return "RemoteEvent"
    elseif obj:IsA("RemoteFunction") then return "RemoteFunction"
    elseif obj:IsA("UnreliableRemoteEvent") then return "UnreliableRemoteEvent"
    elseif obj:IsA("BindableEvent") then return "BindableEvent"
    elseif obj:IsA("BindableFunction") then return "BindableFunction"
    end
    return "Desconhecido"
end

local function identificarFuncao(nome)
    nome = nome:lower()
    if nome:find("attack") or nome:find("atacar") or nome:find("hit") then return "⚔️ Ataque/Dano"
    elseif nome:find("damage") or nome:find("dano") then return "💥 Dano"
    elseif nome:find("kill") or nome:find("matar") then return "💀 Kill"
    elseif nome:find("money") or nome:find("cash") or nome:find("coin") then return "💰 Dinheiro"
    elseif nome:find("buy") or nome:find("purchase") then return "🛒 Compra"
    elseif nome:find("sell") then return "💵 Venda"
    elseif nome:find("equip") then return "🎒 Equipar"
    elseif nome:find("drop") then return "📦 Drop"
    elseif nome:find("teleport") or nome:find("tp") then return "🌀 Teleporte"
    elseif nome:find("speed") then return "🏃 Velocidade"
    elseif nome:find("jump") then return "🦘 Pulo"
    elseif nome:find("health") then return "❤️ Vida"
    elseif nome:find("respawn") or nome:find("revive") then return "🔄 Respawn"
    elseif nome:find("chat") or nome:find("message") then return "💬 Chat"
    elseif nome:find("trade") then return "🔁 Troca"
    elseif nome:find("quest") or nome:find("missao") then return "📜 Missão"
    elseif nome:find("level") or nome:find("xp") or nome:find("exp") then return "⭐ Level/XP"
    elseif nome:find("admin") or nome:find("command") then return "👑 Admin"
    elseif nome:find("ban") or nome:find("kick") then return "🚫 Moderação"
    elseif nome:find("update") or nome:find("sync") then return "🔄 Sync"
    elseif nome:find("request") or nome:find("get") then return "📡 Requisição"
    elseif nome:find("give") or nome:find("add") then return "🎁 Dar"
    elseif nome:find("remove") or nome:find("delete") then return "🗑️ Remover"
    elseif nome:find("spawn") then return "✨ Spawn"
    elseif nome:find("skill") or nome:find("ability") then return "✨ Habilidade"
    elseif nome:find("pet") then return "🐾 Pet"
    elseif nome:find("inventory") or nome:find("inv") then return "🎒 Inventário"
    elseif nome:find("shop") then return "🏪 Loja"
    elseif nome:find("reward") then return "🏆 Recompensa"
    elseif nome:find("spin") then return "🎰 Roleta"
    elseif nome:find("claim") then return "📥 Resgatar"
    elseif nome:find("daily") then return "📅 Diário"
    elseif nome:find("code") then return "🎟️ Código"
    end
    return "❓ Desconhecido"
end

local function getCaminho(obj)
    local caminho = obj.Name
    local pai = obj.Parent
    while pai and pai ~= game do
        caminho = pai.Name .. "." .. caminho
        pai = pai.Parent
    end
    return caminho
end

local function executarScanner()
    print("\n========================================")
    print("   WILLNZX SCANNER - GUI MODE           ")
    print("========================================")
    print("Jogo: " .. game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name)
    print("PlaceId: " .. game.PlaceId)
    print("Data: " .. os.date("%d/%m/%Y %H:%M:%S"))
    print("========================================\n")
    
    logLines = {}
    pushLog("> Iniciando varredura neural...", Colors.Cyan)
    setProgress(0.05)
    
    local contador = {RemoteEvent=0, RemoteFunction=0, UnreliableRemoteEvent=0, BindableEvent=0, BindableFunction=0, Total=0}
    local remotesEncontrados = {}
    
    local locais = {
        {ReplicatedStorage, "ReplicatedStorage"},
        {game:GetService("ServerScriptService"), "ServerScriptService"},
        {game:GetService("ServerStorage"), "ServerStorage"},
        {game:GetService("StarterGui"), "StarterGui"},
        {game:GetService("StarterPlayer"), "StarterPlayer"},
        {workspace, "Workspace"},
        {game:GetService("Lighting"), "Lighting"},
        {game:GetService("Chat"), "Chat"},
        {LocalPlayer, "Player"},
        {LocalPlayer:FindFirstChild("PlayerGui"), "PlayerGui"},
        {LocalPlayer.Character, "Character"},
        {LocalPlayer:FindFirstChild("Backpack"), "Backpack"},
        {Players, "Players"},
    }
    
    local total = #locais
    
    for idx, entry in ipairs(locais) do
        local container, nome = entry[1], entry[2]
        if container then
            pushLog("> Escaneando " .. nome .. "...", Colors.Purple)
            setProgress(idx / total)
            
            for _, obj in ipairs(container:GetDescendants()) do
                if obj:IsA("RemoteEvent") 
                or obj:IsA("RemoteFunction") 
                or obj:IsA("UnreliableRemoteEvent")
                or obj:IsA("BindableEvent")
                or obj:IsA("BindableFunction") then
                    
                    local tipo = classificarRemote(obj)
                    local caminho = getCaminho(obj)
                    local funcao = identificarFuncao(obj.Name)
                    
                    contador[tipo] = (contador[tipo] or 0) + 1
                    contador.Total = contador.Total + 1
                    
                    table.insert(remotesEncontrados, {
                        Nome = obj.Name, Tipo = tipo, Caminho = caminho,
                        Local = nome, Funcao = funcao,
                    })
                end
            end
            task.wait(0.1)
        end
    end
    
    print("\n========== RESULTADOS ==========\n")
    local localAtual = ""
    for i, remote in ipairs(remotesEncontrados) do
        if remote.Local ~= localAtual then
            localAtual = remote.Local
            print("\n📁 === " .. localAtual .. " ===\n")
        end
        print(string.format("[%d] 📡 %s", i, remote.Nome))
        print(string.format("    ├─ Tipo: %s", remote.Tipo))
        print(string.format("    ├─ Caminho: %s", remote.Caminho))
        print(string.format("    └─ Função: %s", remote.Funcao))
        print("")
    end
    
    print("\n========== RESUMO ==========")
    print(string.format("🔹 RemoteEvents:        %d", contador.RemoteEvent))
    print(string.format("🔹 RemoteFunctions:     %d", contador.RemoteFunction))
    print(string.format("🔹 UnreliableRemotes:   %d", contador.UnreliableRemoteEvent))
    print(string.format("🔹 BindableEvents:      %d", contador.BindableEvent))
    print(string.format("🔹 BindableFunctions:   %d", contador.BindableFunction))
    print("----------------------------------------")
    print(string.format("🔸 TOTAL:               %d", contador.Total))
    print("============================\n")
    
    pcall(function()
        if writefile then
            local texto = "=== WILLNZX SCANNER ===\n"
            texto = texto .. "Jogo: " .. game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name .. "\n"
            texto = texto .. "PlaceId: " .. game.PlaceId .. "\n"
            texto = texto .. "Data: " .. os.date("%d/%m/%Y %H:%M:%S") .. "\n\n"
            for i, remote in ipairs(remotesEncontrados) do
                texto = texto .. string.format("[%d] %s\n    Tipo: %s\n    Caminho: %s\n    Função: %s\n\n", i, remote.Nome, remote.Tipo, remote.Caminho, remote.Funcao)
            end
            texto = texto .. "\n=== RESUMO ===\n"
            texto = texto .. "RemoteEvents: " .. contador.RemoteEvent .. "\n"
            texto = texto .. "RemoteFunctions: " .. contador.RemoteFunction .. "\n"
            texto = texto .. "TOTAL: " .. contador.Total .. "\n"
            writefile("willnzx_scanner.txt", texto)
            print("💾 Lista salva em: willnzx_scanner.txt")
        end
    end)
    
    setProgress(1)
    pushLog("> Scan completo! " .. contador.Total .. " remotes encontrados.", Colors.Success)
    setStatus("SCAN COMPLETO // " .. contador.Total .. " REMOTES", Colors.Success)
    print("\n✅ Scan completo!")
    
    task.wait(3)
    setProgress(0)
end

ScanBtn.MouseButton1Click:Connect(function()
    tween(ScanBtn, 0.1, {BackgroundTransparency = 0}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    task.wait(0.1)
