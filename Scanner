    setStatus("ESCANEANDO...", Colors.Warning)
    
    task.spawn(function()
        local ok, err = pcall(executarScanner)
        if not ok then
            pushLog("> Erro: " .. tostring(err), Colors.Error)
            setStatus("ERRO NO SCAN", Colors.Error)
        end
    end)
end)

