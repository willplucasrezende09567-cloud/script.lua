-- DRAG
-- ═══════════════════════════════════════════════
local dragging = false
local dragStart, startPos

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainPanel.Position
    end
end)

TitleBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement 
    or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainPanel.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

-- ═══════════════════════════════════════════════
-- ✨ ANIMAÇÕES DE GRID (VERSÃO CORRIGIDA)
-- ═══════════════════════════════════════════════
local function resetGridToBubble()
    -- Coloca todas as linhas no centro da bolha (estado "sugado")
    for _, entry in ipairs(hLines) do
        entry.obj.Position = UDim2.new(0, 45, 0.5, 0)
        entry.obj.Size = UDim2.new(0, 0, 0, 1)
        entry.obj.BackgroundTransparency = 1
    end
    for _, entry in ipairs(vLines) do
        entry.obj.Position = UDim2.new(0, 45, 0.5, 0)
        entry.obj.Size = UDim2.new(0, 1, 0, 0)
        entry.obj.BackgroundTransparency = 1
    end
end

local function gridSuckIntoBubble(duration)
    duration = duration or 0.4
    local ti = TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    
    for _, entry in ipairs(hLines) do
        TweenService:Create(entry.obj, ti, {
            Position = UDim2.new(0, 45, 0.5, 0),
            Size = UDim2.new(0, 0, 0, 1),
            BackgroundTransparency = 1
        }):Play()
    end
    for _, entry in ipairs(vLines) do
        TweenService:Create(entry.obj, ti, {
            Position = UDim2.new(0, 45, 0.5, 0),
            Size = UDim2.new(0, 1, 0, 0),
            BackgroundTransparency = 1
        }):Play()
    end
    
    -- Fundo fade out RÁPIDO junto
    TweenService:Create(BackgroundContainer, 
        TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.In), 
        { BackgroundTransparency = 1 }
    ):Play()
end

local function gridEmergeFromBubble(duration)
    duration = duration or 0.55
    local ti = TweenInfo.new(duration, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    
    resetGridToBubble()
    BackgroundContainer.BackgroundTransparency = 1
    BackgroundContainer.Visible = true
    
    task.wait(0.03)
    
    for _, entry in ipairs(hLines) do
        TweenService:Create(entry.obj, ti, {
            Position = entry.basePos,
            Size = UDim2.new(1, 0, 0, 1),
            BackgroundTransparency = entry.baseTrans
        }):Play()
    end
    for _, entry in ipairs(vLines) do
        TweenService:Create(entry.obj, ti, {
            Position = entry.basePos,
            Size = UDim2.new(0, 1, 1, 0),
            BackgroundTransparency = entry.baseTrans
        }):Play()
    end
    
    TweenService:Create(BackgroundContainer, 
        TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), 
        { BackgroundTransparency = 0.15 }
    ):Play()
end

