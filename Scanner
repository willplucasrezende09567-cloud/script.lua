    tween(floatStroke, 0.4, {Transparency = 0.2})
    tween(floatGlow, 0.4, {BackgroundTransparency = 0.7})
    
    task.wait(0.4)
    -- Assentar
    tween(FloatBtn, 0.2, {
        Size = UDim2.new(0, 50, 0, 50),
        Position = BUBBLE_POS
    })
    
    isAnimating = false
end

