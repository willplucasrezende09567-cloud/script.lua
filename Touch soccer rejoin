local GuiService = game:GetService("GuiService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- =======================================================
-- ANTI-DUPLICAÇÃO: executa APENAS UMA VEZ POR SESSÃO
-- =======================================================
local FLAG = "__TOUCH_SOCCER_RUNNING__"
local env = (getgenv and getgenv()) or _G

if env[FLAG] then
    warn("[Touch Soccer] Bloqueado: script já está em execução.")
    return
end
env[FLAG] = true

-- Remove GUI antiga se sobrar de execução anterior
pcall(function()
    local antigo = game.CoreGui:FindFirstChild("DeltaMobileHub")
    if antigo then antigo:Destroy() end
end)
-- =======================================================

-- Link do script principal
local SCRIPT_URL = "https://raw.githubusercontent.com/willplucasrezende09567-cloud/script.lua/refs/heads/main/Touch%20soccer%20script"
local LOAD_CMD = 'loadstring(game:HttpGet("' .. SCRIPT_URL .. '"))()'

-- 1) Carrega o script principal
loadstring(game:HttpGet(SCRIPT_URL))()

-- 2) Agenda para o próximo servidor (se o executor suportar)
if type(queue_on_teleport) == "function" then
    pcall(function() queue_on_teleport(LOAD_CMD) end)
end

-- Função que limpa a flag e reentra
local function fazerRejoin()
    -- ⚠️ LIMPA A FLAG antes de teleportar, para o script poder rodar no novo servidor
    if getgenv then
        getgenv()[FLAG] = nil
    else
        _G[FLAG] = nil
    end

    -- Re-agenda o script para rodar no próximo servidor
    if type(queue_on_teleport) == "function" then
        pcall(function() queue_on_teleport(LOAD_CMD) end)
    end

    -- Reentra no mesmo servidor
    pcall(function()
        TeleportService:Teleport(game.PlaceId, player)
    end)
end

-- 3) Detecta kick pela mensagem do GuiService (método Infinity Yield)
GuiService.ErrorMessageChanged:Connect(function(errorMessage)
    if errorMessage and errorMessage ~= "" then
        print("[Auto-Rejoin] Kick detectado: " .. errorMessage)
        fazerRejoin()
    end
end)

print("[Auto-Rejoin] Ativado.")
