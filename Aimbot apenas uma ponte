RunService.RenderStepped:Connect(function()
    if not ATIVO then
        if bolinha then bolinha.Visible = false end
        return
    end

    alvoAtual = pegarAlvo()

    if not bolinha then return end

    if alvoAtual and alvoValido(alvoAtual) then
        local posMostrar = posicaoPrevista(alvoAtual)
        local screenPos, onScreen = Camera:WorldToViewportPoint(posMostrar)
        if onScreen then
            bolinha.Visible = true
            bolinha.Position = UDim2.new(0, screenPos.X - 5, 0, screenPos.Y - 5)
        else
            bolinha.Visible = false
        end
    else
        if MODO == "center" then
            bolinha.Visible = true
            bolinha.Position = UDim2.new(0.5, -5, 0.5, -5)
        else
            bolinha.Visible = false
        end
    end
end)

