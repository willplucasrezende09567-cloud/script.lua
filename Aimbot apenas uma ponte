local function acharArma(nome)
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if char then
        local arma = char:FindFirstChild(nome)
        if arma and arma:IsA("Tool") then return arma end
    end
    if backpack then
        local arma = backpack:FindFirstChild(nome)
        if arma and arma:IsA("Tool") then return arma end
    end
    return nil
end

local function equiparArma(nome)
    local arma = acharArma(nome)
    if arma then
        pcall(function()
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:EquipTool(arma)
            end
        end)
        return true
    end
    return false
end

local function alternarArma()
    local proxima = ARMAS[INDICE_ARMA]
    local equipou = equiparArma(proxima)
    if equipou then
        INDICE_ARMA = INDICE_ARMA + 1
        if INDICE_ARMA > #ARMAS then INDICE_ARMA = 1 end
    end
end

