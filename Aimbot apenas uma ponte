local function acharMaisProximo()
    local meuChar = LocalPlayer.Character
    if not meuChar then return nil end
    local meuHrp = meuChar:FindFirstChild("HumanoidRootPart")
    if not meuHrp then return nil end

    local maisPerto, menorDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local head = plr.Character:FindFirstChild("Head")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                local dist = (head.Position - meuHrp.Position).Magnitude
                if dist < menorDist then
                    menorDist = dist
                    maisPerto = head
                end
            end
        end
    end
    return maisPerto
end

local function acharFixo()
    if not JOGADOR_FIXO or not JOGADOR_FIXO.Character then return nil end
    local head = JOGADOR_FIXO.Character:FindFirstChild("Head")
    local hum = JOGADOR_FIXO.Character:FindFirstChildOfClass("Humanoid")
    if head and hum and hum.Health > 0 then
        return head
    end
    return nil
end

local function alvoValido(alvo)
    if not alvo or not alvo.Parent then return false end
    local hum = alvo.Parent:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function pegarAlvo()
    if MODO == "center" then return nil end
    if MODO == "fixo" then return acharFixo() end
    if MODO == "todos" then return acharMaisProximo() end
    return nil
end

local function posicaoPrevista(alvo)
    if not alvo then return nil end
    local hrp = alvo.Parent:FindFirstChild("HumanoidRootPart")
    local posBase = alvo.Position

    local direcaoMovimento = Vector3.new(0, 0, 0)
    if hrp then
        local velocidade = hrp.Velocity
        local velHorizontal = Vector3.new(velocidade.X, 0, velocidade.Z)
        if velHorizontal.Magnitude > 1 then
            direcaoMovimento = velHorizontal.Unit
            posBase = posBase + (velHorizontal * TEMPO_PREVISAO)
        end
    end

    local direcaoFrente = direcaoMovimento
    if direcaoFrente.Magnitude < 0.1 then
        local char = LocalPlayer.Character
        if char then
            local meuHrp = char:FindFirstChild("HumanoidRootPart")
            if meuHrp then
                direcaoFrente = (alvo.Position - meuHrp.Position).Unit
            end
        end
    end

    if direcaoFrente.Magnitude > 0.1 then
        posBase = posBase + (direcaoFrente * OFFSET_FRENTE)
    end

    return posBase
end

local function posicaoFinal()
    if ATIVO and alvoAtual and alvoValido(alvoAtual) then
        return posicaoPrevista(alvoAtual)
    end
    local camCF = Camera.CFrame
    local origin = camCF.Position
    local dir = camCF.LookVector * 1000
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    local result = workspace:Raycast(origin, dir, params)
    if result then return result.Position end
    return origin + dir
end

local function aplicarOverride()
    if not fetchMouseAtual or not fetchMouseAtual.Parent then return end
    pcall(function()
        fetchMouseAtual.OnClientInvoke = function(...)
            return posicaoFinal()
        end
        overrideAtivo = true
    end)
end

local function setupLauncher(tool)
    if not tool:IsA("Tool") then return end
    local nome = tool.Name:lower()
    if not (nome:find("rocket") or nome:find("launcher") or nome:find("gun")) then return end

    tool.Equipped:Connect(function()
        fetchMouseAtual = tool:FindFirstChild("FetchMousePos")
        if fetchMouseAtual then aplicarOverride() end
    end)

    tool.Unequipped:Connect(function()
        overrideAtivo = false
    end)
end

local function monitorarChar(char)
    for _, obj in ipairs(char:GetChildren()) do
        setupLauncher(obj)
    end
    char.ChildAdded:Connect(setupLauncher)
end

if LocalPlayer.Character then monitorarChar(LocalPlayer.Character) end
