--[[
    LolCube (UI) | cubo preto na tela com "lol" + texto pequeno
    Re-agendamento via queue_on_teleport
]]

local SELF_URL = "https://raw.githubusercontent.com/willplucasrezende09567-cloud/script.lua/refs/heads/main/Touch%20soccer%20tem%20um"

-- ════════════════════════════════════════════════════════════════
-- 1) Work: cria tudo na CoreGui
-- ════════════════════════════════════════════════════════════════
local function work()
    local coreGui = game:GetService("CoreGui")
    local old = coreGui:FindFirstChild("LolTextGui")
    if old then old:Destroy() end

    local sg = Instance.new("ScreenGui")
    sg.Name = "LolTextGui"
    sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.Parent = coreGui

    -- ── Textinho no canto ──────────────────────────────────────
    local lbl = Instance.new("TextLabel")
    lbl.Size                   = UDim2.fromOffset(110, 26)
    lbl.Position               = UDim2.fromOffset(12, 12)
    lbl.BackgroundColor3       = Color3.new(0, 0, 0)
    lbl.BackgroundTransparency = 0.2
    lbl.TextColor3             = Color3.new(1, 1, 1)
    lbl.Text                   = "small lol text"
    lbl.Font                   = Enum.Font.GothamBold
    lbl.TextSize               = 14
    lbl.Parent                 = sg

    -- ── Cubo preto (UI) com "lol" ──────────────────────────────
    local cube = Instance.new("Frame")
    cube.Name                  = "LolCube"
    cube.Size                  = UDim2.fromOffset(120, 120)
    cube.Position              = UDim2.new(0.5, -60, 0.5, -60)  -- centro da tela
    cube.BackgroundColor3      = Color3.new(0, 0, 0)
    cube.BorderSizePixel       = 0
    cube.Active                = true
    cube.Parent                = sg

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = cube

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.new(1, 1, 1)
    stroke.Thickness = 1
    stroke.Transparency = 0.3
    stroke.Parent = cube

    local txt = Instance.new("TextLabel")
    txt.Size                   = UDim2.fromScale(1, 1)
    txt.BackgroundTransparency = 1
    txt.Text                   = "lol"
    txt.TextColor3             = Color3.new(1, 1, 1)
    txt.Font                   = Enum.Font.GothamBlack
    txt.TextScaled             = true
    txt.Parent                 = cube

    -- ── Arrastar o cubo ────────────────────────────────────────
    local UIS = game:GetService("UserInputService")
    local dragging, dragStart, startPos

    cube.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch)
            and UIS:GetFocusedTextBox() == nil then
            dragging = true
            dragStart = input.Position
            startPos = cube.Position
        end
    end)

    cube.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            cube.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

work()

-- ════════════════════════════════════════════════════════════════
-- 2) Re-agendamento
-- ════════════════════════════════════════════════════════════════
local queue = (syn    and syn.queue_on_teleport)
           or queue_on_teleport
           or (fluxus and fluxus.queue_on_teleport)

if not queue then
    warn("[LolCube] Sem queue_on_teleport nesse executor — sem persistência.")
    return
end

queue(("loadstring(game:HttpGet('%s'))()"):format(SELF_URL))
print("[LolCube] Re-agendado via URL.")
