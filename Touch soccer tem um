--[[
    LolCube | texto pequeno + cubo preto com "lol" + re-agendamento

    URL usada para persistência via queue_on_teleport.
]]

local SELF_URL = "https://raw.githubusercontent.com/willplucasrezende09567-cloud/script.lua/refs/heads/main/Touch%20soccer%20tem%20um"

-- ════════════════════════════════════════════════════════════════
-- 1) Trabalho: texto pequeno + cubo preto com "lol"
-- ════════════════════════════════════════════════════════════════
local function work()
    -- 1.1) Textinho no canto
    local coreGui = game:GetService("CoreGui")
    local oldGui = coreGui:FindFirstChild("LolTextGui")
    if oldGui then oldGui:Destroy() end

    local sg = Instance.new("ScreenGui")
    sg.Name = "LolTextGui"
    sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true
    sg.Parent = coreGui

    local lbl = Instance.new("TextLabel")
    lbl.Size                   = UDim2.fromOffset(110, 26)
    lbl.Position               = UDim2.fromOffset(12, 12)
    lbl.BackgroundColor3       = Color3.new(0, 0, 0)
    lbl.BackgroundTransparency = 0.2
    lbl.TextColor3             = Color3.new(1, 1, 1)
    lbl.Text                   = "small lol text"
    lbl.Font                   = Enum.Font.GothamBold
    lbl.TextSize               = 14
    lbl.Parent                 = sg

    -- 1.2) Cubo preto 4x4x4 com "lol" em cada face
    local oldCube = workspace:FindFirstChild("LolCube")
    if oldCube then oldCube:Destroy() end

    local cube = Instance.new("Part")
    cube.Name       = "LolCube"
    cube.Size       = Vector3.new(4, 4, 4)
    cube.Anchored   = true
    cube.CanCollide = false
    cube.Color      = Color3.new(0, 0, 0)
    cube.Material   = Enum.Material.SmoothPlastic
    cube.CFrame     = (workspace.CurrentCamera
                       and workspace.CurrentCamera.CFrame * CFrame.new(0, 0, -10))
                      or CFrame.new(0, 10, 0)
    cube.Parent     = workspace

    for _, face in ipairs({
        Enum.NormalId.Front, Enum.NormalId.Back,
        Enum.NormalId.Left,  Enum.NormalId.Right,
        Enum.NormalId.Top,   Enum.NormalId.Bottom,
    }) do
        local surf = Instance.new("SurfaceGui")
        surf.Face          = face
        surf.SizingMode    = Enum.SurfaceGuiSizingMode.PixelsPerStud
        surf.PixelsPerStud = 100
        surf.Parent        = cube

        local t = Instance.new("TextLabel")
        t.Size                   = UDim2.fromScale(1, 1)
        t.BackgroundTransparency = 1
        t.Text                   = "lol"
        t.TextColor3             = Color3.new(1, 1, 1)
        t.Font                   = Enum.Font.GothamBlack
        t.TextScaled             = true
        t.Parent                 = surf
    end
end

-- Executa já
work()

-- ════════════════════════════════════════════════════════════════
-- 2) Re-agendamento via queue_on_teleport
-- ════════════════════════════════════════════════════════════════
local queue = (syn    and syn.queue_on_teleport)
           or queue_on_teleport
           or (fluxus and fluxus.queue_on_teleport)

if not queue then
    warn("[LolCube] Este executor não expõe queue_on_teleport — sem persistência.")
    return
end

queue(("loadstring(game:HttpGet('%s'))()"):format(SELF_URL))
print("[LolCube] Re-agendado via URL.")
