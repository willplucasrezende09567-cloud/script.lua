-- PARTE 1: Remover o _Index (O Isca)
-- ==========================================
local function removeIndex()
    local targets = {"CorePackages", "Workspace"}
    for _, serviceName in ipairs(targets) do
        local success, service = pcall(function()
            return game:GetService(serviceName)
        end)
        if not success or not service then
            success, service = pcall(function()
                return cloneref(game:GetService(serviceName))
            end)
        end
        if success and service then
            local packages = service:FindFirstChild("Packages")
            local indexObj = packages and packages:FindFirstChild("_Index")
            if indexObj then
                indexObj:Destroy()
            else
                local recursiveIndex = service:FindFirstChild("_Index", true)
                if recursiveIndex then
                    recursiveIndex:Destroy()
                end
            end
        end
    end
end
removeIndex()

