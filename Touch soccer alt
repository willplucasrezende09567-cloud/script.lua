local initFling = function()
    W.FL = {
        active=false, thread=nil,
        oldCFrame=nil, targetStartY=nil,
        frontFlip=false, killTarget=nil, kickTarget=nil,
        forceMode="full",
    }

    local function flGetHum(p) local c=p and p.Character; return c and c:FindFirstChildOfClass("Humanoid") end
    local function flIsDead(p) if not p then return true end; local h=flGetHum(p); return (not h) or h.Health<=0 end
    local function flIsGone(p)
        if not p then return true end
        local ok,par=pcall(function() return p.Parent end)
        if not ok or par~=Players then return true end
        return not Players:FindFirstChild(p.Name)
    end
    local function flRestoreCam()
        local c=LP.Character; local h=c and c:FindFirstChildOfClass("Humanoid")
        if h then pcall(function()
            workspace.CurrentCamera.CameraSubject=h
            workspace.CurrentCamera.CameraType=Enum.CameraType.Custom
        end) end
    end
    local function flSpectate(t)
        local h=t and flGetHum(t); if not h then return end
        workspace.CurrentCamera.CameraSubject=h
        workspace.CurrentCamera.CameraType=Enum.CameraType.Custom
    end

    local flOnStatus = function() end
    W.flOnStatus = function(fn) flOnStatus = fn end

    local function flTick(target)
        local c=LP.Character
        local hum=c and c:FindFirstChildOfClass("Humanoid")
        local hrp=c and c:FindFirstChild("HumanoidRootPart")
        if not hrp or not hum then return "stop" end

        local tChar=target.Character; if not tChar then return "stop" end
        local tHum=tChar:FindFirstChildOfClass("Humanoid")
        local tRoot=tHum and tHum.RootPart
        local tHead=tChar:FindFirstChild("Head")
        local tBase=tRoot or tHead
        if not tBase then return "stop" end

        local tiltDeg=math.deg(math.acos(math.clamp(tBase.CFrame.UpVector.Y,-1,1)))
        if tiltDeg>W.FL_TILT then return "stop" end
        if W.FL.targetStartY and (W.FL.targetStartY-tBase.Position.Y) >= W.FL_DROP then return "stop" end

        local basePart = tBase
        if tRoot and tHead then
            if (tRoot.Position - tHead.Position).Magnitude > W.FL_HEAD_DIST then
                basePart = tHead
            end
        end

        local bv = hrp:FindFirstChild("__FL_BV")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name="__FL_BV"
            bv.MaxForce=Vector3.new(9e9,9e9,9e9)
            bv.Velocity=Vector3.zero
            bv.Parent=hrp
        end

        local velXZ,velY,rot
        if W.FL.forceMode=="reduced" then
            velXZ=W.FL_KICK_XZ; velY=W.FL_KICK_Y; rot=W.FL_KICK_ROT
        else
            velXZ=W.FL_KILL_XZ; velY=W.FL_KILL_Y; rot=W.FL_KILL_ROT
        end

        local tVel=basePart.AssemblyLinearVelocity
        local flatVel=Vector3.new(tVel.X,0,tVel.Z)
        local moveDir=tHum.MoveDirection or Vector3.zero
        local flatMove=Vector3.new(moveDir.X,0,moveDir.Z)
        local dir
        if flatVel.Magnitude>0.5 then dir=flatVel.Unit
        elseif flatMove.Magnitude>0.01 then dir=flatMove.Unit
        else
            local lk=basePart.CFrame.LookVector
            local flk=Vector3.new(lk.X,0,lk.Z)
            dir=flk.Magnitude>0.01 and flk.Unit or Vector3.new(0,0,1)
        end

        local frontMag = basePart.Velocity.Magnitude / W.FL_STUD
        W.FL.frontFlip = not W.FL.frontFlip
        local frontSign = W.FL.frontFlip and 1 or -1
        local frontOffset = tHum.MoveDirection * frontMag * frontSign

        local yOff = W.FL_Y
        local basePos = basePart.Position + Vector3.new(0, yOff, 0)
        local destPos = basePos + frontOffset

        hrp.CFrame = CFrame.lookAt(destPos, destPos + Vector3.new(0, -1, 0), dir)
        hrp.Velocity = Vector3.new((math.random()-0.5)*velXZ, -velY, (math.random()-0.5)*velXZ)
        hrp.RotVelocity = Vector3.new((math.random()-0.5)*rot, (math.random()-0.5)*rot, (math.random()-0.5)*rot)

        local dropNow = W.FL.targetStartY and (W.FL.targetStartY-basePart.Position.Y) or 0
        local mode = W.FL.forceMode=="reduced" and "💥" or "🔥"
        local dirInfo = W.FL.frontFlip and "➡ FRENTE" or "⬅ TRÁS"
        flOnStatus(mode.." "..target.Name.." | "..dirInfo.." | Y "..math.floor(basePart.Position.Y)..
            " | drop "..string.format("%.1f",dropNow).."/"..W.FL_DROP,
            Color3.fromRGB(100,150,255))
        return "ok"
    end

    local function flCleanup()
        local c=LP.Character
        local h=c and c:FindFirstChild("HumanoidRootPart")
        if h then
            pcall(function()
                h.AssemblyLinearVelocity=Vector3.zero
                h.AssemblyAngularVelocity=Vector3.zero
                h.Velocity=Vector3.zero
                h.RotVelocity=Vector3.zero
            end)
            for _,d in ipairs(h:GetChildren()) do
                if d:IsA("BodyMover") then pcall(function() d:Destroy() end) end
            end
        end
        local hum=c and c:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function() hum.PlatformStand=false end)
            pcall(function()
                hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
            end)
        end
        if c then
            for _,d in ipairs(c:GetDescendants()) do
                if d:IsA("BasePart") then pcall(function() d.CanCollide=true end) end
            end
        end
        workspace.FallenPartsDestroyHeight = getgenv().FPDH or workspace.FallenPartsDestroyHeight
        flRestoreCam()
    end

    local function flReturn()
        if not W.FL.oldCFrame then return end
        local c=LP.Character; if not c then return end
        local h=c:FindFirstChild("HumanoidRootPart")
        local hum=c:FindFirstChildOfClass("Humanoid")
        if not h or not hum or hum.Health<=0 then return end
        pcall(function()
            h.AssemblyLinearVelocity=Vector3.zero
            h.AssemblyAngularVelocity=Vector3.zero
            h.Velocity=Vector3.zero
            h.RotVelocity=Vector3.zero
        end)
        RunService.Heartbeat:Wait()
        RunService.Heartbeat:Wait()
        pcall(function() h.CFrame = W.FL.oldCFrame * CFrame.new(0, W.FL_LIFT, 0) end)
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        task.wait(0.1)
        pcall(function()
            h.AssemblyLinearVelocity=Vector3.zero
            h.AssemblyAngularVelocity=Vector3.zero
        end)
        task.wait(0.15)
        if h and h.Parent and (h.Position - W.FL.oldCFrame.Position).Magnitude > 25 then
            pcall(function() h.CFrame = W.FL.oldCFrame * CFrame.new(0, W.FL_LIFT, 0) end)
        end
        if W.FL_REFILL then
            task.wait(0.15)
            local c2=LP.Character
            local h2=c2 and c2:FindFirstChildOfClass("Humanoid")
            if h2 and h2.Health>0 and h2.Health<h2.MaxHealth then
                pcall(function() h2.Health=h2.MaxHealth end)
            end
        end
    end

    local function flStart(target, forceMode)
        if not target or flIsDead(target) then return end
        if W.FL.thread then task.cancel(W.FL.thread); W.FL.thread=nil end
        W.FL.forceMode = forceMode or "full"
        W.FL.frontFlip = false

        local c=LP.Character
        local h=c and c:FindFirstChild("HumanoidRootPart")
        if h then W.FL.oldCFrame=h.CFrame end

        local tRootP = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        local tHeadP = target.Character and target.Character:FindFirstChild("Head")
        local tRef = tRootP or tHeadP
        W.FL.targetStartY = tRef and tRef.Position.Y or nil

        getgenv().FPDH = workspace.FallenPartsDestroyHeight
        workspace.FallenPartsDestroyHeight = 0/0

        W.FL.active = true
        flSpectate(target)

        local hum=c and c:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.PlatformStand=true
            pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false) end)
        end

        W.FL.thread = task.spawn(function()
            local interval = 1/W.FL_RATE
            local tStart = tick()
            while W.FL.active do
                if (tick()-tStart) > W.FL_MAX_TIME then break end
                if not target or flIsDead(target) or flIsGone(target) then W.FL.active=false; break end
                local cc=LP.Character
                local hh=cc and cc:FindFirstChild("HumanoidRootPart")
                local hh_hum=cc and cc:FindFirstChildOfClass("Humanoid")
                if hh and hh_hum then
                    hh_hum.PlatformStand=true
                    if hh.Position.Y < -65 then
                        if W.FL.oldCFrame then pcall(function() hh.CFrame=W.FL.oldCFrame end) end
                        RunService.Heartbeat:Wait(); continue
                    end
                    if flTick(target)=="stop" then W.FL.active=false; break end
                end
                task.wait(interval)
            end
            W.FL.active=false
            flCleanup()
            task.wait(0.15)
            flReturn()
            task.wait(0.1)
            flCleanup()
            W.FL.oldCFrame=nil
            W.FL.targetStartY=nil
            flOnStatus("pronto", W.Colors.accent)
        end)
    end

    W.flStart = flStart
    W.flStop = function()
        W.FL.active=false
        if W.FL.thread then task.cancel(W.FL.thread); W.FL.thread=nil end
        flCleanup()
        task.wait(0.05)
        flReturn()
        flCleanup()
        W.FL.oldCFrame=nil
        W.FL.targetStartY=nil
    end
    W.flIsDead = flIsDead
end
