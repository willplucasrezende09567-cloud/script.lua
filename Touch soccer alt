W.RETURN_POS=Vector3.new(-214.75,7.68,3.49)
W.TP_X=-259.91; W.TP_Z=-13.53
W.TP_UNDERGROUND_Y=-90; W.KILLZONE_Y=-500
W.STOP_ABOVE_KILLZONE=4; W.MICRO_STEP=100
W.STEP_DELAY=0.001; W.FALL_TIMEOUT=8; W.CYCLE_DELAY=0.1
W.voidFlingLoop=false; W.voidFlingThread=nil
W.loopResetActive=false; W.loopResetThread=nil; W.loopResetCharConn=nil

-- ⬅️ FIX DO TP VOID E HEALTH
W._microTPReset = function(char)
    local c = char or LP.Character
    if not c then return false end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end

    task.wait(0.5) -- Aguarda carregar
    if not c or not c.Parent then return false end
    hrp = c:FindFirstChild("HumanoidRootPart")
    hum = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end

    local savedCollide = {}
    local function applyNoclip()
        if not c or not c.Parent then return end
        for _, d in ipairs(c:GetDescendants()) do
            if d:IsA("BasePart") then
                if savedCollide[d] == nil then savedCollide[d] = d.CanCollide end
                d.CanCollide = false
            end
        end
    end
    
    applyNoclip()
    local nt = task.spawn(function()
        while LP.Character == c do
            applyNoclip()
            task.wait(0.1)
        end
    end)

    pcall(function() hum.PlatformStand = false; hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true) end)

    local bv = Instance.new("BodyVelocity")
    bv.Name = "__ResetBV"
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    local bp = Instance.new("BodyPosition")
    bp.Name = "__ResetBP"
    bp.MaxForce = Vector3.new(0, math.huge, 0)
    bp.P = 100000
    bp.D = 10000
    bp.Position = hrp.Position
    bp.Parent = hrp

    local cy = W.TP_UNDERGROUND_Y
    local ty = W.KILLZONE_Y + W.STOP_ABOVE_KILLZONE
    local startTime = tick()

    -- Loop de micro-TPs (versão antiga, sem forçar Health=0)
    while LP.Character == c and hum.Health > 0 and tick() - startTime < 3 do
        local chrp = c:FindFirstChild("HumanoidRootPart")
        if not chrp then break end

        bp.Position = Vector3.new(W.TP_X, cy, W.TP_Z)
        pcall(function()
            chrp.CFrame = CFrame.new(W.TP_X, cy, W.TP_Z)
            chrp.AssemblyLinearVelocity = Vector3.zero
        end)

        if cy > ty then
            cy = cy - W.MICRO_STEP
            if cy < ty then cy = ty end
        end
        task.wait(W.STEP_DELAY)
    end

    if bv.Parent then bv:Destroy() end
    if bp.Parent then bp:Destroy() end
    if nt then task.cancel(nt) end

    -- ⬅️ CHECAGEM DE HEALTH
    if LP.Character == c and hum.Health > 0 then
        -- Se sim (vivo): faz voltar na hora
        local ts = tick()
        while LP.Character == c and (tick() - ts) < 5 do
            local hh = c:FindFirstChild("HumanoidRootPart")
            if hh then
                pcall(function()
                    hh.CFrame = CFrame.new(W.RETURN_POS)
                    hh.AssemblyLinearVelocity = Vector3.zero
                end)
            end
            if W.isInTeam() then break end
            task.wait(0.1)
        end
        return false
    else
        -- Se não (morto): espera voltar (o CharacterAdded no startLoopReset cuida disso)
        return true
    end
end

W.startLoopReset = function()
    if W.loopResetThread then task.cancel(W.loopResetThread); W.loopResetThread=nil end
    if W.loopResetCharConn then W.loopResetCharConn:Disconnect(); W.loopResetCharConn=nil end
    W.loopResetActive = true
    W.loopResetCycle = 0

    local function doReset(nc)
        task.spawn(function()
            W.loopResetCycle = W.loopResetCycle + 1
            local target = nc or LP.Character
            if target then
                pcall(W._microTPReset, target)
            end
            task.wait(W.CYCLE_DELAY)
        end)
    end

    W.loopResetCharConn = LP.CharacterAdded:Connect(function(nc)
        if not W.loopResetActive then return end
        doReset(nc)
    end)

    W.loopResetThread = task.spawn(function()
        while W.loopResetActive do task.wait(0.5) end
        if W.loopResetCharConn then W.loopResetCharConn:Disconnect(); W.loopResetCharConn=nil end
        W.loopResetThread = nil
    end)

    if LP.Character then
        doReset(LP.Character)
    end
end

W.stopLoopReset = function()
    W.loopResetActive=false
    if W.loopResetThread then task.cancel(W.loopResetThread); W.loopResetThread=nil end
    if W.loopResetCharConn then W.loopResetCharConn:Disconnect(); W.loopResetCharConn=nil end
end

W.voidFlingOnce = function()
    local died=W._microTPReset(LP.Character)
    if died then
        task.wait(0.5)
        local c=LP.Character
        local hum=c and c:FindFirstChildOfClass("Humanoid")
        local t=tick()+8
        while tick()<t and (not hum or hum.Health<=0) do
            task.wait(0.2); c=LP.Character; hum=c and c:FindFirstChildOfClass("Humanoid")
        end
        task.wait(0.5)
        local ts=tick()
        while LP.Character and (tick()-ts)<20 do
            local cc=LP.Character
            local hh=cc and cc:FindFirstChild("HumanoidRootPart")
            if hh then pcall(function() hh.CFrame=CFrame.new(W.RETURN_POS); hh.AssemblyLinearVelocity=Vector3.zero end) end
            if W.isInTeam() then break end
            task.wait(0.12)
        end
        return true
    end
    return false
end

W.startVoidFling = function(onFinish)
    if W.voidFlingThread then task.cancel(W.voidFlingThread); W.voidFlingThread=nil end
    W.voidFlingLoop=true
    W.voidFlingThread = task.spawn(function()
        local MAX=10; local DELAY=2.5; local tr=0
        while W.voidFlingLoop and tr<MAX do
            tr=tr+1
            local c=LP.Character
            local hum=c and c:FindFirstChildOfClass("Humanoid")
            local ws=tick()
            while W.voidFlingLoop and (not hum or hum.Health<=0) and tick()-ws<5 do
                task.wait(0.1); c=LP.Character; hum=c and c:FindFirstChildOfClass("Humanoid")
            end
            if not W.voidFlingLoop then break end
            local before=LP.Character
            W.voidFlingOnce()
            task.wait(0.5)
            if LP.Character~=before then break end
            local t=tick()+DELAY
            while W.voidFlingLoop and tick()<t do task.wait(0.1) end
        end
        W.voidFlingLoop=false; W.voidFlingThread=nil
        if onFinish then onFinish() end
    end)
end
W.stopVoidFling = function()
    W.voidFlingLoop=false
    if W.voidFlingThread then task.cancel(W.voidFlingThread); W.voidFlingThread=nil end
end

