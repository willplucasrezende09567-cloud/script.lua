W.collectNewCoins = function()
    local c = LP.Character
    local h = c and c:FindFirstChild("HumanoidRootPart")
    if not h then return end
    local folder = workspace:FindFirstChild("Coins")
    if not folder then return end
    local now = tick()
    for k, t in pairs(W.states.farmSeenTime) do
        if now - t > 3 then
            W.states.farmSeenTime[k] = nil
            W.states.farmSeen[k] = nil
        end
    end
    for _, obj in ipairs(folder:GetChildren()) do
        if obj.Parent and not W.states.farmSeen[obj] then
            W.states.farmSeen[obj] = true
            W.states.farmSeenTime[obj] = now
            local p
            if obj:IsA("BasePart") then p = obj
            elseif obj:IsA("Model") then p = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") end
            if p and p.Parent then
                pcall(function() h.CFrame = CFrame.new(p.Position + Vector3.new(0, 3, 0)) end)
                W.states.farmTotal = W.states.farmTotal + 1
                task.wait(0.1)
            end
        end
    end
end

W.startFarmCoins = function()
    if W.states.farmThread then task.cancel(W.states.farmThread) end
    W.states.isFarming = true
    W.states.farmThread = task.spawn(function()
        while W.states.isFarming do
            W.collectNewCoins()
            task.wait(0.1)
        end
    end)
end

W.stopFarmCoins = function()
    W.states.isFarming = false
    if W.states.farmThread then task.cancel(W.states.farmThread); W.states.farmThread = nil end
end

