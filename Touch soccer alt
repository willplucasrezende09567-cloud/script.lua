    btn.TextColor3 = Color3.fromRGB(255, 255, 255); btn.TextStrokeTransparency = 0.4
    btn.TextStrokeColor3 = Color3.fromRGB(0, 0, 0); btn.AutoButtonColor = false
    btn.Active = true; btn.ZIndex = 5; btn.Parent = parent
    if name then btn.Name = name end
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 8); c.Parent = btn
    local s = Instance.new("UIStroke"); s.Thickness = 1.5; s.Color = color1; s.Transparency = 0.3; s.Parent = btn
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, color1), ColorSequenceKeypoint.new(1, color2)})
    g.Rotation = 90
    g.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0.7)})
    g.Parent = btn
    btn:SetAttribute("IsActive", false)
    return btn
end
