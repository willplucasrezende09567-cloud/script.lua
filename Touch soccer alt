W.processCommand = function(msg)
    local m = msg:lower():gsub("^%s+", ""):gsub("%s+$", "")
    if m:sub(1,1) == ";" then m = m:sub(2) end

    if m == "cmds" then W.loadModule("cmds"); return end
    if m == "cmdbar2" then W.loadModule("cmdbar2"); return end
    if m == "control" then W.loadModule("control"); return end
    if m == "farmcoins" or m == "farm" then
        if W.states.isFarming then
            W.stopFarmCoins()
            W.setBtnInactive(FarmCoinsBtn, "🪙 FARM COINS: OFF")
        else
            W.startFarmCoins()
            W.setBtnActive(FarmCoinsBtn, "🪙 FARM COINS: ON")
        end
        return
    end

    if m == "loop goal a" then
        W.stopAll(); W.selectedGoalIndex = 1; W.updGoals()
        W.states.isActive = true; W.setBtnActive(Button, "AUTO-GOL: ATIVADO"); W.startAutoGoal(); return
    end
    if m == "loop goal b" then
        W.stopAll(); W.selectedGoalIndex = 2; W.updGoals()
        W.states.isActive = true; W.setBtnActive(Button, "AUTO-GOL: ATIVADO"); W.startAutoGoal(); return
    end
    if m == "unloop goal" or m == "unloop goal a" or m == "unloop goal b" then
        W.states.isActive = false
        if W.states.loopThread then task.cancel(W.states.loopThread); W.states.loopThread = nil end
        W.setBtnInactive(Button, "AUTO-GOL: DESATIVADO"); return
    end
    if m == "gol a" then W.fireSingle(1); return end
    if m == "gol b" then W.fireSingle(2); return end
    if m == "tpgoal" then
        W.stopAll(); W.states.isTpGoal = true
        W.setBtnActive(TpGoalBtn, "TP GOAL: ATIVADO")
        W.startSpectating(); W.startTpGoal(); return
    end
    if m == "untpgoal" then
        W.states.isTpGoal = false
        if W.states.tpGoalThread then task.cancel(W.states.tpGoalThread); W.states.tpGoalThread = nil end
        W.stopSpectating(); W.setBtnInactive(TpGoalBtn, "TP GOAL: DESATIVADO"); return
    end
    if m == "defendgoal" then
        if W.states.isDefending then W.stopDefend(); W.setBtnInactive(DefendGoalBtn, "DEFEND GOAL: DESATIVADO")
        else W.setBtnActive(DefendGoalBtn, "DEFEND GOAL: ATIVADO (GOL " .. W.defendSelectedGoal .. ")"); W.states.isDefending = true; W.startDefend() end
        return
    end
    if m == "defendgol a" or m == "defendgoal a" then
        W.defendSelectedGoal = "A"
        if not W.states.isDefending then W.setBtnActive(DefendGoalBtn, "DEFEND GOAL: ATIVADO (GOL A)"); W.states.isDefending = true; W.startDefend() end
        return
    end
    if m == "defendgol b" or m == "defendgoal b" then
        W.defendSelectedGoal = "B"
        if not W.states.isDefending then W.setBtnActive(DefendGoalBtn, "DEFEND GOAL: ATIVADO (GOL B)"); W.states.isDefending = true; W.startDefend() end
        return
    end
    if m == "undefend" or m == "undefendgoal" then
        W.stopDefend(); W.setBtnInactive(DefendGoalBtn, "DEFEND GOAL: DESATIVADO"); return
    end
    if m == "bringball" then W.stopAll(); W.states.isBringing = true; W.setBtnActive(BringBtn, "BRING BALL: ATIVADO"); W.startBring(); return end
    if m == "unbringball" then W.states.isBringing = false; if W.states.bringThread then task.cancel(W.states.bringThread); W.states.bringThread = nil end; W.setBtnInactive(BringBtn, "BRING BALL: DESATIVADO"); return end
    if m == "loopbring" then W.stopAll(); W.states.isLoopBringing = true; W.setBtnActive(LoopBringBtn, "LOOP BRING: ATIVADO"); W.startLoopBring(); return end
    if m == "unloopbring" then W.states.isLoopBringing = false; if W.states.loopBringThread then task.cancel(W.states.loopBringThread); W.states.loopBringThread = nil end; W.setBtnInactive(LoopBringBtn, "LOOP BRING: DESATIVADO"); return end
    if m == "skyball" then W.stopAll(); W.states.isSkying = true; W.setBtnActive(SkyBtn, "SKY BALL: ATIVADO"); W.startSky(); return end
    if m == "unskyball" then W.states.isSkying = false; if W.states.skyThread then task.cancel(W.states.skyThread); W.states.skyThread = nil end; W.setBtnInactive(SkyBtn, "SKY BALL: DESATIVADO"); return end
    if m == "freezeball" then W.stopAll(); W.setBtnActive(FreezeAllBtn, "FREEZE BALL: ATIVADO"); W.startFreeze(); return end
    if m == "unfreezeball" then W.stopFreeze(); W.setBtnInactive(FreezeAllBtn, "FREEZE BALL: DESATIVADO"); return end
    if m == "bugball" then
        if W.states.isBugBall then return end
        W.stopAll(); W.states.isBugBall = true; W.setBtnActive(BugBallBtn, "BUG BALL: ATIVADO"); W.startBugBall(); return
    end
    if m == "boostall" then W.stopAll(); W.states.isBoostingAll = true; W.setBtnActive(BoostAllBtn, "BOOST ALL: ATIVADO (" .. W.boostMultiplier .. "x)"); W.startBoostAll(); return end
    if m == "unboostall" then W.states.isBoostingAll = false; if W.states.boostAllThread then task.cancel(W.states.boostAllThread); W.states.boostAllThread = nil end; W.setBtnInactive(BoostAllBtn, "BOOST ALL: DESATIVADO"); return end
    if m == "touchgoal" then W.stopAll(); W.states.isTouchGoal = true; W.setBtnActive(TouchGoalBtn, "TOUCH GOAL: ATIVADO"); W.startTouchGoal(); return end
    if m == "untouchgoal" then W.states.isTouchGoal = false; if W.states.touchGoalThread then task.cancel(W.states.touchGoalThread); W.states.touchGoalThread = nil end; W.setBtnInactive(TouchGoalBtn, "TOUCH GOAL: DESATIVADO"); return end
    if m == "moveball" then W.stopAll(); W.states.isMoveBall = true; W.setBtnActive(MoveBallBtn, "MOVE BALL: ATIVADO"); W.startMoveBall(); return end
    if m == "unmoveball" then W.states.isMoveBall = false; if W.states.moveBallThread then task.cancel(W.states.moveBallThread); W.states.moveBallThread = nil end; W.setBtnInactive(MoveBallBtn, "MOVE BALL: DESATIVADO"); return end
    if m == "orbitball" then W.stopAll(); W.states.isOrbitBall = true; W.setBtnActive(OrbitBallBtn, "ORBIT BALL: ATIVADO"); W.startOrbitBall(); return end
    if m == "unorbitball" then W.states.isOrbitBall = false; if W.states.orbitBallThread then task.cancel(W.states.orbitBallThread); W.states.orbitBallThread = nil end; W.setBtnInactive(OrbitBallBtn, "ORBIT BALL: DESATIVADO"); return end

    local mult = m:match("^boostmult%s+(%d+)$")
    if mult then
        local v = math.clamp(tonumber(mult), 1, 6)
        W.Knob.Position = UDim2.new((v-1)/5, -11, 0.5, -11); W.updDots(v); return
    end
end

