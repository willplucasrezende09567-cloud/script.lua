W.processCommand = function(msg)
    local m = msg:lower():gsub("^%s+",""):gsub("%s+$","")
    if m:sub(1,1)==";" then m = m:sub(2) end
    if m == "cmds" then W.loadModule("cmds"); return end
    if m == "control" then W.loadModule("control"); return end
    if m == "trackerga" then W.loadModule("trackerga"); return end
    if m == "resetpos" then if W.UI.MainFrame then W.UI.MainFrame.Position = W.HOME_POS end; return end
    if m == "loopreset" or m == "autobug" then
        if W.loopResetActive then W.stopLoopReset() else W.stopVoidFling(); W.startLoopReset() end
    elseif m == "resetpartida" or m == "voidfling" then
        if W.voidFlingLoop then W.stopVoidFling() else W.startVoidFling() end
    elseif m == "lang pt" then W.lang = "pt"
    elseif m == "lang en" then W.lang = "en" end
end

LP.Chatted:Connect(W.processCommand)

