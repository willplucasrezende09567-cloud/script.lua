W.stickBall = function()
    local b=W.getBall()
    local c=LP.Character; local h=c and c:FindFirstChild("HumanoidRootPart")
    if not b or not h then return end
    local dir=h.Position-b.Position
    if dir.Magnitude>1 then
        local f=dir*W.CFGV.bringForce
        if f.Magnitude>8000 then f=f.Unit*8000 end
        f=f+Vector3.new(0,W.CFGV.bringY,0)
        W.safeFire(W.TKN,W.UID,"",b.Position,f,Vector3.new(0,0,0))
    end
end

