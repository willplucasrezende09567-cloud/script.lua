do
    local d, di, ds, sp
    MainFrame.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            local okT, isBtn = pcall(function()
                return i.Target and (i.Target:IsA("TextButton") or i.Target:IsA("TextBox") or i.Target:IsA("ScrollingFrame"))
            end)
            if okT and isBtn then return end
            d = true
