-- 1. SPAM TOOLS
btnSpam.MouseButton1Click:Connect(function()
    animarClique(btnSpam)
    setStatus("SPAMANDO TOOLS...", Color3.fromRGB(255, 200, 0))
    
    local gearMachine = Workspace:FindFirstChild("Gear Machine")
    if not gearMachine then
        setStatus("GEAR MACHINE NÃO ENCONTRADA", Color3.fromRGB(255, 50, 50))
        return
    end
    
    local clickDetectors = {}
    for _, obj in ipairs(gearMachine:GetDescendants()) do
        if obj:IsA("ClickDetector") then
            table.insert(clickDetectors, obj)
        end
    end
    
    setStatus("CLICANDO EM " .. #clickDetectors .. " BOTÕES...", Color3.fromRGB(255, 200, 0))
    
    local sucessos = 0
    for _, detector in ipairs(clickDetectors) do
        pcall(function()
            fireclickdetector(detector)
            sucessos = sucessos + 1
        end)
        task.wait(0.01)
    end
    
    setStatus("✅ " .. sucessos .. " TOOLS SPAWNADAS!", Color3.fromRGB(0, 255, 100))
    print("💥 Spam Tools: " .. sucessos .. " cliques enviados!")
end)

-- 2. EQUIPAR TODOS
btnEquip.MouseButton1Click:Connect(function()
    animarClique(btnEquip)
    setStatus("EQUIPANDO TODOS OS ITENS...", Color3.fromRGB(0, 200, 255))
    
    local char = player.Character
    if not char then
        setStatus("PERSONAGEM NÃO ENCONTRADO", Color3.fromRGB(255, 50, 50))
        return
    end
    
    local backpack = player:FindFirstChild("Backpack")
    if not backpack then
        setStatus("BACKPACK NÃO ENCONTRADO", Color3.fromRGB(255, 50, 50))
        return
    end
    
    local equipados = 0
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            pcall(function()
                tool.Parent = char
                equipados = equipados + 1
            end)
            task.wait(0.01)
        end
    end
    
    setStatus("✅ " .. equipados .. " ITENS EQUIPADOS!", Color3.fromRGB(0, 255, 100))
    print("⚔️ Equipar Todos: " .. equipados .. " itens equipados!")
end)

-- 3. TROLL
local trollAtivo = false
local trollLoop = nil

btnTroll.MouseButton1Click:Connect(function()
    animarClique(btnTroll)
    trollAtivo = not trollAtivo
    
    if trollAtivo then
        btnTroll.Text = "😈 TROLL [ON]"
        btnTroll.BackgroundColor3 = Color3.fromRGB(150, 0, 50)
        btnStroke3.Color = Color3.fromRGB(255, 0, 100)
        setStatus("😈 ROUBANDO ITENS...", Color3.fromRGB(255, 0, 100))
        
        trollLoop = task.spawn(function()
            while trollAtivo do
                task.wait(0.03)
                
                local char = player.Character
                if not char then continue end
                
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then continue end
                
                local backpack = player:FindFirstChild("Backpack")
                if not backpack then continue end
                
                for _, obj in ipairs(Workspace:GetChildren()) do
                    if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
                        pcall(function()
                            hrp.CFrame = obj.Handle.CFrame + Vector3.new(0, 1, 0)
                        end)
                        task.wait(0.01)
                        pcall(function()
                            obj.Parent = backpack
                        end)
                    end
                end
            end
        end)
    else
        btnTroll.Text = "😈 TROLL [OFF]"
        btnTroll.BackgroundColor3 = Color3.fromRGB(70, 20, 30)
        btnStroke3.Color = Color3.fromRGB(255, 50, 80)
        setStatus("TROLL DESATIVADO", Color3.fromRGB(255, 200, 0))
    end
end)

