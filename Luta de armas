-- Animação de minimizar
local function minimizar()
    -- Animação do Hub encolhendo e desaparecendo
    local tween1 = TweenService:Create(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(bolha.Position.X.Scale, bolha.Position.X.Offset, bolha.Position.Y.Scale, bolha.Position.Y.Offset),
        BackgroundTransparency = 1
    })
    
    -- Animação da bolha aparecendo
    local tween2 = TweenService:Create(bolha, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 60, 0, 60),
        Visible = true
    })
    
    tween1:Play()
    tween2:Play()
    
    tween1.Completed:Connect(function()
        mainFrame.Visible = false
    end)
end

-- Animação de restaurar
local function restaurar()
    mainFrame.Visible = true
    mainFrame.Size = UDim2.new(0, 0, 0, 0)
    mainFrame.BackgroundTransparency = 1
    
    -- Animação do Hub aparecendo
    local tween1 = TweenService:Create(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 280, 0, 280),
        Position = UDim2.new(0.5, -140, 0.3, 0),
        BackgroundTransparency = 0
    })
    
    -- Animação da bolha encolhendo
    local tween2 = TweenService:Create(bolha, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0)
    })
    
    tween1:Play()
    tween2:Play()
    
    tween2.Completed:Connect(function()
        bolha.Visible = false
    end)
end

-- Botão de minimizar
minimizeBtn.MouseButton1Click:Connect(function()
