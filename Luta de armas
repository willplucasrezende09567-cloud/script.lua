-- Função auxiliar para atualizar o status
local function setStatus(texto, cor)
    statusLabel.Text = "STATUS: " .. texto
    statusLabel.TextColor3 = cor or Color3.fromRGB(0, 255, 100)
end

-- Função para animar clique
local function animarClique(botao)
    local tween = TweenService:Create(botao, TweenInfo.new(0.1), {Size = UDim2.new(0, 240, 0, 45)})
    tween:Play()
    tween.Completed:Connect(function()
        TweenService:Create(botao, TweenInfo.new(0.1), {Size = UDim2.new(0, 240, 0, 40)}):Play()
    end)
end

