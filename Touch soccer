end

local function selecionarGoalA(desligarAuto)
    if desligarAuto then
        AUTO_GOL_ATIVADO = false
        autoAtivo = false
        atualizarVisualAuto(false)
    end
    golSelecionado = 1
    atualizarBotoesGoalGlobal()
end

local function selecionarGoalB(desligarAuto)
    if desligarAuto then
        AUTO_GOL_ATIVADO = false
        autoAtivo = false
        atualizarVisualAuto(false)
    end
    golSelecionado = 2
    atualizarBotoesGoalGlobal()
end

local function ativarSkill()
    if not seguirBolaAtivado then
        if not tenhoTeam() then
            garantirTeam(function()
                if not tenhoTeam() then return end
                if not existeBolaNoMapa() then return end
                if flingBallAtivado then desativarFlingBall() end
                if wallPhaseAtivado then wallPhaseAtivado = false; desativarWallPhase() end
                if headFlingAtivado then desativarHeadFling() end
                seguirBolaAtivado = true
                speedLoopAtivo = true
                atualizarVisualSkill(true)
                aplicarSpeed()
            end)
        else
            if not existeBolaNoMapa() then return end
            if flingBallAtivado then desativarFlingBall() end
            if wallPhaseAtivado then wallPhaseAtivado = false; desativarWallPhase() end
            if headFlingAtivado then desativarHeadFling() end
            seguirBolaAtivado = true
            speedLoopAtivo = true
            atualizarVisualSkill(true)
            aplicarSpeed()
        end
    else
        resetarBotaoSkill()
        resetarSpeed()
    end
end

