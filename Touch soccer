local transparentFrameCache = nil

local function tenhoTeam()
    if player.Team ~= nil then return true end
    local char = player.Character
    if char then
        for _, obj in pairs(char:GetChildren()) do
            if obj.Name:match("^Team%d+$") then return true end
            if obj.Name == "Team" and (obj:IsA("NumberValue") or obj:IsA("IntValue")) then
                if obj.Value and obj.Value > 0 then return true end
            end
        end
    end
    return false
end

local function outrosPlayersTemTeam()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player then
            if plr.Team ~= nil then return true end
            if plr.Character then
                for _, obj in pairs(plr.Character:GetChildren()) do
                    if obj.Name:match("^Team%d+$") then return true end
                    if obj.Name == "Team" and (obj:IsA("NumberValue") or obj:IsA("IntValue")) then
                        if obj.Value and obj.Value > 0 then return true end
                    end
                end
            end
        end
    end
    return false
end

local function encontrarTransparentFrame()
    if transparentFrameCache and transparentFrameCache.Parent and transparentFrameCache:IsDescendantOf(workspace) then
        return transparentFrameCache
    end
    local jp = workspace:FindFirstChild("JoinPortal")
    if jp then
        local f = jp:FindFirstChild("TransparentFrame")
        if f and f:IsA("BasePart") then transparentFrameCache = f; return f end
    end
    local nt = workspace:FindFirstChild("PortalNewTouchFootball")
    if nt then
        local f = nt:FindFirstChild("TransparentFrame")
        if f and f:IsA("BasePart") then transparentFrameCache = f; return f end
    end
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj.Name == "TransparentFrame" and obj:IsA("BasePart") then
            transparentFrameCache = obj
            return obj
        end
    end
    return nil
end

local function teleportarProTransparentFrame()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local frame = encontrarTransparentFrame()
    if not frame then return end
    local tp = frame.Position + Vector3.new(0, 3, 0)
    if not posicaoValida(tp) then return end
    hrp.CFrame = CFrame.new(tp)
    pararMeuMovimento()
end

local function garantirTeam(continuar)
    if tenhoTeam() then continuar(); return end
    teleportarProTransparentFrame()
    task.spawn(function()
        local tempo = 0
        while not tenhoTeam() and tempo < TEAM_WAIT_TIMEOUT do
            task.wait(0.1)
            tempo = tempo + 0.1
        end
        if tenhoTeam() then continuar() end
    end)
end

-- =======================================================
-- 🚪 AUTO-ENTER
-- =======================================================
local function podeEntrarPartida()
    if tenhoTeam() then return false end
    if not outrosPlayersTemTeam() then return false end
    return true
end

local function tentarEntrarPartida()
    if not AUTO_ENTER_ATIVADO then return end
    if not podeEntrarPartida() then return end
    if autoEnterJaDisparou then return end
    autoEnterJaDisparou = true

    task.spawn(function()
        local tempo = 0
        while tempo < AUTO_ENTER_TIMEOUT do
            if not outrosPlayersTemTeam() and not tenhoTeam() then
                autoEnterJaDisparou = false
                return
            end
            if tenhoTeam() then return end
            teleportarProTransparentFrame()
            task.wait(0.8)
            tempo = tempo + 0.8
        end
        autoEnterJaDisparou = false
    end)
end

