-- ============ HELPERS ============
local function getBall()
    local field = workspace:FindFirstChild("FootballField")
    if field then return field:FindFirstChild("SoccerBall") end
    return nil
end

local function safeFire(...)
    hookSkip = true
    KickBallEvent:FireServer(...)
    hookSkip = false
end

local function catmullRom(p0, p1, p2, p3, t)
    local t2 = t * t
    local t3 = t2 * t
    return 0.5 * (
        (2 * p1) +
        (-p0 + p2) * t +
        (2 * p0 - 5 * p1 + 4 * p2 - p3) * t2 +
        (-p0 + 3 * p1 - 3 * p2 + p3) * t3
    )
end

-- ============ HOOK KICKBALL ============
local oldNamecall
pcall(function()
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" and self.Name == "KickBall" then
            if hookSkip then
                return oldNamecall(self, ...)
            end
            local args = {...}
            if isBoostingMe and args[5] and typeof(args[5]) == "Vector3" then
                args[5] = args[5] * boostMultiplier
                return oldNamecall(self, table.unpack(args))
            end
        end
        return oldNamecall(self, ...)
    end))
end)

-- ============ AÇÕES ============
local function fireSingleKick(goalIndex)
    local ball = getBall()
    if not ball then return end
    local dir = (GOALS[goalIndex].pos - ball.Position).Unit
    local forcaFinal = (dir * CONFIG_VALUES.autoGoalForce) + Vector3.new(0, CONFIG_VALUES.autoGoalY, 0)
    safeFire(TOKEN, USER_ID, "", ball.Position, forcaFinal, Vector3.new(0,0,0))
end

local function startAutoGoal()
    loopThread = task.spawn(function()
        while isActive do
            local ball = getBall()
            if ball then
                local dir = (GOALS[selectedGoalIndex].pos - ball.Position).Unit
                local forcaFinal = (dir * CONFIG_VALUES.autoGoalForce) + Vector3.new(0, CONFIG_VALUES.autoGoalY, 0)
                safeFire(TOKEN, USER_ID, "", ball.Position, forcaFinal, Vector3.new(0,0,0))
            end
            task.wait(0.05)
        end
    end)
end

local function startTouchGoal()
    touchGoalThread = task.spawn(function()
        while isTouchGoal do
            local ball = getBall()
            if not ball then
                isTouchGoal = false
                if TouchGoalBtn and setBtnInactive then
                    setBtnInactive(TouchGoalBtn, "TOUCH GOAL: DESATIVADO")
                end
                break
            end
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (ball.Position - hrp.Position).Magnitude
                if dist < CONFIG_VALUES.touchGoalDist then
                    local targetGoal = GOALS[selectedGoalIndex].pos
                    local dir = (targetGoal - ball.Position).Unit
                    local forcaFinal = (dir * CONFIG_VALUES.autoGoalForce) + Vector3.new(0, CONFIG_VALUES.autoGoalY, 0)
                    safeFire(TOKEN, USER_ID, "", ball.Position, forcaFinal, Vector3.new(0,0,0))
                end
            end
            task.wait(0.03)
        end
        touchGoalThread = nil
    end)
end

local function startMoveBall()
    moveBallThread = task.spawn(function()
        local usingA = true
        local timeoutStart = tick()
        local MAX_TIMEOUT = 10
        local counter = 0
        
        while isMoveBall do
            local ball = getBall()
            if not ball then
                task.wait(0.2)
                continue
            end
            
            local targetPos = usingA and MOVE_POS_A or MOVE_POS_B
            local dist = (targetPos - ball.Position).Magnitude
            
            if dist < 5 then
                usingA = not usingA
                timeoutStart = tick()
                task.wait(0.05)
            else
                counter = counter + 1
                if counter % 3 == 0 then
                    safeFire(TOKEN, USER_ID, "", ball.Position, Vector3.new(0,0,0), Vector3.new(0,0,0))
                end
                local dir = (targetPos - ball.Position).Unit
                local forca = (dir * CONFIG_VALUES.moveForce) + Vector3.new(0, CONFIG_VALUES.moveY, 0)
                safeFire(TOKEN, USER_ID, "", ball.Position, forca, Vector3.new(0,0,0))
                task.wait(CONFIG_VALUES.moveDelay)
            end
            
            if (tick() - timeoutStart) > MAX_TIMEOUT then
                usingA = not usingA
                timeoutStart = tick()
            end
        end
        moveBallThread = nil
    end)
end

local function startOrbitBall()
    orbitBallThread = task.spawn(function()
        local n = #ORBIT_POINTS
        local currentSegment = 1
        local t = 0
        local step = CONFIG_VALUES.orbitStep
        local counter = 0
        
        while isOrbitBall do
            local ball = getBall()
            if not ball then
                isOrbitBall = false
                if OrbitBallBtn and setBtnInactive then
                    setBtnInactive(OrbitBallBtn, "ORBIT BALL: DESATIVADO")
                end
                break
            end
            
            local p0 = ORBIT_POINTS[((currentSegment - 2) % n) + 1]
            local p1 = ORBIT_POINTS[currentSegment]
            local p2 = ORBIT_POINTS[(currentSegment % n) + 1]
            local p3 = ORBIT_POINTS[((currentSegment + 1) % n) + 1]
            local targetPos = catmullRom(p0, p1, p2, p3, t)
            
            counter = counter + 1
            if counter % 2 == 0 then
                safeFire(TOKEN, USER_ID, "", ball.Position, Vector3.new(0,0,0), Vector3.new(0,0,0))
                safeFire(TOKEN, USER_ID, "", ball.Position, Vector3.new(0,0,0), Vector3.new(0,0,0))
                safeFire(TOKEN, USER_ID, "", ball.Position, Vector3.new(0,0,0), Vector3.new(0,0,0))
            end
            
            local dir = targetPos - ball.Position
            local dist = dir.Magnitude
            if dist > 1 then
                local forca = dir * CONFIG_VALUES.orbitForce
                if forca.Magnitude > 8000 then forca = forca.Unit * 8000 end
                forca = forca + Vector3.new(0, CONFIG_VALUES.orbitY, 0)
                safeFire(TOKEN, USER_ID, "", ball.Position, forca, Vector3.new(0,0,0))
            end
            
            t = t + step
            if t >= 1 then
                t = 0
                currentSegment = (currentSegment % n) + 1
            end
            task.wait(CONFIG_VALUES.orbitDelay)
        end
        orbitBallThread = nil
    end)
end

local function stickBallToPlayer()
    local ball = getBall()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not ball or not hrp then return end
    local dir = (hrp.Position - ball.Position)
    local dist = dir.Magnitude
    if dist > 1 then
        local forcaPuxar = dir * CONFIG_VALUES.bringForce
        if forcaPuxar.Magnitude > 8000 then forcaPuxar = forcaPuxar.Unit * 8000 end
        forcaPuxar = forcaPuxar + Vector3.new(0, CONFIG_VALUES.bringY, 0)
        safeFire(TOKEN, USER_ID, "", ball.Position, forcaPuxar, Vector3.new(0,0,0))
    end
end

local function startBring()
    bringThread = task.spawn(function()
        local startTime = tick()
        while isBringing and (tick() - startTime) < 0.5 do
            stickBallToPlayer()
            task.wait(0.03)
        end
        isBringing = false
        if BringBtn and setBtnInactive then
            setBtnInactive(BringBtn, "BRING BALL: DESATIVADO")
        end
        bringThread = nil
    end)
end

local function startLoopBring()
    loopBringThread = task.spawn(function()
        while isLoopBringing do
            stickBallToPlayer()
            task.wait(0.03)
        end
        loopBringThread = nil
    end)
end

local function startSky()
    skyThread = task.spawn(function()
        while isSkying do
            local ball = getBall()
            if ball then
                safeFire(TOKEN, USER_ID, "", ball.Position, Vector3.new(0, CONFIG_VALUES.skyForce, 0), Vector3.new(0,0,0))
