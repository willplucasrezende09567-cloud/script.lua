local function buscarAlvoPorTexto(search)
    search = search:lower():gsub("^%s+", ""):gsub("%s+$", "")
    if #search == 0 then return nil end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player then
            if plr.Name:lower():sub(1, #search) == search then return plr end
        end
    end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player then
            if plr.Name:lower():find(search, 1, true) then return plr end
        end
    end
    return nil
end

