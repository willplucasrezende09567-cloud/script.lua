local function removerConstraintsHeadFling()
    if headFlingAlignPos then headFlingAlignPos:Destroy(); headFlingAlignPos = nil end
    if headFlingAlignOri then headFlingAlignOri:Destroy(); headFlingAlignOri = nil end
    if headFlingAngVel then headFlingAngVel:Destroy(); headFlingAngVel = nil end
    if headFlingAttachment then headFlingAttachment:Destroy(); headFlingAttachment = nil end
end

local function pausarHeadFlingAgora(manterAtivado)
    if not headFlingRodandoAgora then return end
    headFlingRodandoAgora = false
    removerConstraintsHeadFling()

    local char = player.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
            humanoid.AutoRotate = true
        end
    end

    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        hrp.Velocity = Vector3.zero
    end
    headFlingZerarAte = tick() + HEAD_FLING_ZERAR_DURACAO

    if not manterAtivado then
        headFlingAtivado = false
        atualizarVisualHeadFling(false)
    end

    pararMeuMovimento()
end

local function ativarHeadFlingAgora()
    if headFlingRodandoAgora then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    humanoid.PlatformStand = true
    humanoid.AutoRotate = false
    headFlingRodandoAgora = true

    removerConstraintsHeadFling()

    headFlingAttachment = Instance.new("Attachment")
    headFlingAttachment.Name = "HeadFlingAttach"
    headFlingAttachment.Parent = hrp

    headFlingAlignPos = Instance.new("AlignPosition")
    headFlingAlignPos.Name = "HeadFlingAlignPos"
    headFlingAlignPos.Attachment0 = headFlingAttachment
    headFlingAlignPos.Mode = Enum.PositionAlignmentMode.OneAttachment
    headFlingAlignPos.Position = hrp.Position
    headFlingAlignPos.MaxForce = HEAD_FLING_ALIGN_FORCE
    headFlingAlignPos.Responsiveness = 200
    headFlingAlignPos.Parent = hrp

    headFlingAlignOri = Instance.new("AlignOrientation")
    headFlingAlignOri.Name = "HeadFlingAlignOri"
    headFlingAlignOri.Attachment0 = headFlingAttachment
    headFlingAlignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment
    headFlingAlignOri.CFrame = hrp.CFrame
    headFlingAlignOri.MaxTorque = HEAD_FLING_ALIGN_TORQUE
    headFlingAlignOri.Responsiveness = 200
    headFlingAlignOri.PrimaryAxisOnly = false
    headFlingAlignOri.Parent = hrp

    headFlingAngVel = Instance.new("AngularVelocity")
    headFlingAngVel.Name = "HeadFlingAngVel"
    headFlingAngVel.Attachment0 = headFlingAttachment
    headFlingAngVel.AngularVelocity = Vector3.new(0, HEAD_FLING_ANGULAR, 0)
    headFlingAngVel.MaxTorque = 1e6
    headFlingAngVel.Parent = hrp
end

