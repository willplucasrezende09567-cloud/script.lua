local function removerConstraintsHeadFling()
    if headFlingAlignPos then headFlingAlignPos:Destroy(); headFlingAlignPos = nil end
    if headFlingAlignOri then headFlingAlignOri:Destroy(); headFlingAlignOri = nil end
    if headFlingAngVel then headFlingAngVel:Destroy(); headFlingAngVel = nil end
    if headFlingAttachment then headFlingAttachment:Destroy(); headFlingAttachment = nil end
end

local function pausarHeadFlingAgora(manterAtivado)
    if not headFlingRodandoAgora then return end
    headFlingRodandoAgora = false
    removerConstraintsHeadFling()
    local char = player.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
            humanoid.AutoRotate = true
        end
    end
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        hrp.Velocity = Vector3.zero
    end
    headFlingZerarAte = tick() + HEAD_FLING_ZERAR_DURACAO
    if not manterAtivado then
        headFlingAtivado = false
        atualizarVisualHeadFling(false)
    end
    pararMeuMovimento()
end

local function ativarHeadFlingAgora()
    if headFlingRodandoAgora then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end
    humanoid.PlatformStand = true
    humanoid.AutoRotate = false
    headFlingRodandoAgora = true
    removerConstraintsHeadFling()
    headFlingAttachment = Instance.new("Attachment")
    headFlingAttachment.Name = "HeadFlingAttach"
    headFlingAttachment.Parent = hrp
    headFlingAlignPos = Instance.new("AlignPosition")
    headFlingAlignPos.Name = "HeadFlingAlignPos"
    headFlingAlignPos.Attachment0 = headFlingAttachment
    headFlingAlignPos.Mode = Enum.PositionAlignmentMode.OneAttachment
    headFlingAlignPos.Position = hrp.Position
    headFlingAlignPos.MaxForce = HEAD_FLING_ALIGN_FORCE
    headFlingAlignPos.Responsiveness = 200
    headFlingAlignPos.Parent = hrp
    headFlingAlignOri = Instance.new("AlignOrientation")
    headFlingAlignOri.Name = "HeadFlingAlignOri"
    headFlingAlignOri.Attachment0 = headFlingAttachment
    headFlingAlignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment
    headFlingAlignOri.CFrame = hrp.CFrame
    headFlingAlignOri.MaxTorque = HEAD_FLING_ALIGN_TORQUE
    headFlingAlignOri.Responsiveness = 200
    headFlingAlignOri.PrimaryAxisOnly = false
    headFlingAlignOri.Parent = hrp
    headFlingAngVel = Instance.new("AngularVelocity")
    headFlingAngVel.Name = "HeadFlingAngVel"
    headFlingAngVel.Attachment0 = headFlingAttachment
    headFlingAngVel.AngularVelocity = Vector3.new(0, HEAD_FLING_ANGULAR, 0)
    headFlingAngVel.MaxTorque = 1e6
    headFlingAngVel.Parent = hrp
end

function desativarHeadFling()
    headFlingAtivado = false
    headFlingRodandoAgora = false
    removerConstraintsHeadFling()
    local char = player.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
            humanoid.AutoRotate = true
        end
    end
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        hrp.Velocity = Vector3.zero
    end
    pararSpectate()
    if headFlingAlvoMorreuConn then
        headFlingAlvoMorreuConn:Disconnect()
        headFlingAlvoMorreuConn = nil
    end
    if headFlingConnection then
        headFlingConnection:Disconnect()
        headFlingConnection = nil
    end
    headFlingZerarAte = tick() + HEAD_FLING_ZERAR_DURACAO
    pararMeuMovimento()
    atualizarVisualHeadFling(false)
end

local function conectarMonitorMorte(alvoPlayer)
    if headFlingAlvoMorreuConn then
        headFlingAlvoMorreuConn:Disconnect()
        headFlingAlvoMorreuConn = nil
    end
    local function aoAlvoMorrer()
        if not headFlingAtivado then return end
        desativarHeadFling()
    end
    local function monitorarHumanoid(h)
        if not h then return end
        headFlingAlvoMorreuConn = h.Died:Connect(aoAlvoMorrer)
    end
    if alvoPlayer.Character then
        local hum = alvoPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then monitorarHumanoid(hum) end
    end
    alvoPlayer.CharacterAdded:Connect(function(newChar)
        if not headFlingAtivado then return end
        task.wait(0.5)
        local hum = newChar:FindFirstChildOfClass("Humanoid")
        monitorarHumanoid(hum)
    end)
end

local function ativarHeadFling()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end
    ativarHeadFlingAgora()
    headFlingFramesVoo = 0
    headFlingFramesSubida = 0
    local ativadoEm = tick()
    if headFlingAlvo then
        iniciarSpectate(headFlingAlvo)
        conectarMonitorMorte(headFlingAlvo)
    end
    if headFlingConnection then headFlingConnection:Disconnect() end
    headFlingConnection = runService.Heartbeat:Connect(function(dt)
        if not headFlingAtivado then return end
        local c = player.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h then return end
        if not headFlingRodandoAgora then ativarHeadFlingAgora() end
        if not headFlingAlignPos or not headFlingAlignPos.Parent then
            headFlingAlignPos = nil; headFlingAlignOri = nil; headFlingAngVel = nil; headFlingAttachment = nil
            return
        end
        if not headFlingAlvo or not headFlingAlvo.Parent or not headFlingAlvo.Character then
            pausarHeadFlingAgora(true)
            return
        end
        local alvoChar = headFlingAlvo.Character
        local alvoCabeca = obterCabeca(alvoChar)
        local alvoTorso = obterTorso(alvoChar)
        local alvoHum = alvoChar:FindFirstChildOfClass("Humanoid")
        if not alvoCabeca or not alvoTorso or not alvoHum or alvoHum.Health <= 0 then
            desativarHeadFling()
            return
        end
        local cabecaPos = alvoCabeca.Position
        if not posicaoValida(cabecaPos) then pausarHeadFlingAgora(true); return end
        local minhaPos = h.Position
        local velTorso = alvoTorso.AssemblyLinearVelocity
        local velFlat = Vector3.new(velTorso.X, 0, velTorso.Z)
        local velY = velTorso.Y
        local passouGrace = (tick() - ativadoEm) > 0.5
        if passouGrace then
            local alvoRealmenteVoou = math.abs(velY) > HEAD_FLING_VOOU_LIMITE or velTorso.Magnitude > HEAD_FLING_VEL_LIMITE
            if alvoRealmenteVoou then
                headFlingFramesVoo = headFlingFramesVoo + 1
            else
                headFlingFramesVoo = 0
            end
            if headFlingFramesVoo >= 3 then pausarHeadFlingAgora(true); return end
            if minhaPos.Y < HEAD_FLING_Y_MINIMO then pausarHeadFlingAgora(true); return end
            local subiMuito = (minhaPos.Y > cabecaPos.Y + 5)
            if subiMuito then
                headFlingFramesSubida = headFlingFramesSubida + 1
            else
                headFlingFramesSubida = 0
            end
            if headFlingFramesSubida >= 3 then pausarHeadFlingAgora(true); return end
        end
        local alvoAndando = velFlat.Magnitude > 10
        local destinoPos
        if alvoAndando then
            destinoPos = cabecaPos + velFlat.Unit * HEAD_FLING_FRENTE + Vector3.new(0, HEAD_FLING_PROFUNDIDADE, 0)
        else
            destinoPos = cabecaPos + Vector3.new(0, HEAD_FLING_PROFUNDIDADE, 0)
        end
        if not posicaoValida(destinoPos) then pausarHeadFlingAgora(true); return end
        if minhaPos.Y < cabecaPos.Y - HEAD_FLING_Y_DIF_MAX then
            h.CFrame = CFrame.new(destinoPos)
            h.AssemblyLinearVelocity = Vector3.zero
            h.AssemblyAngularVelocity = Vector3.zero
            if headFlingAlignPos then headFlingAlignPos.Position = destinoPos end
            return
        end
        local diff = destinoPos - minhaPos
        local dist = diff.Magnitude
        if dist > HEAD_FLING_RECUPERAR_DIST then
            if destinoPos.Y >= HEAD_FLING_Y_MINIMO and minhaPos.Y >= HEAD_FLING_Y_MINIMO then
                h.CFrame = CFrame.new(destinoPos)
                h.AssemblyLinearVelocity = Vector3.zero
                h.AssemblyAngularVelocity = Vector3.zero
            end
            return
        end
        local targetVel = diff * HEAD_FLING_SEGUIR_VEL
        h.AssemblyLinearVelocity = targetVel
        h.Velocity = targetVel
        if headFlingAlignPos then
            headFlingAlignPos.Position = destinoPos
            headFlingAlignPos.Responsiveness = 200
        end
        local flatDir
        if velFlat.Magnitude > 1 then
            flatDir = velFlat.Unit
        else
            local minhaLook = h.CFrame.LookVector
            flatDir = Vector3.new(minhaLook.X, 0, minhaLook.Z)
            if flatDir.Magnitude < 0.1 then
                local cam = workspace.CurrentCamera
                local camLook = cam and cam.CFrame.LookVector or Vector3.new(0, 0, 1)
                flatDir = Vector3.new(camLook.X, 0, camLook.Z).Unit
            else
                flatDir = flatDir.Unit
            end
        end
        local baseCFrame = CFrame.lookAt(destinoPos, destinoPos + flatDir)
        local orientacaoFinal = baseCFrame * CFrame.Angles(math.rad(HEAD_FLING_INCLINACAO), 0, 0)
        if headFlingAlignOri then
            headFlingAlignOri.CFrame = orientacaoFinal
        end
        if headFlingAngVel then
            headFlingAngVel.AngularVelocity = Vector3.new(0, HEAD_FLING_ANGULAR, 0)
        end
    end)
end

