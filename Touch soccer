local function pararMeuMovimento()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
    end
end

local function obterTorso(character)
    if not character then return nil end
    return character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("LowerTorso")
end

local function obterCabeca(character)
    if not character then return nil end
    return character:FindFirstChild("Head")
end

local function posicaoValida(pos)
    if not pos then return false end
    if pos.X ~= pos.X then return false end
    if pos.Y ~= pos.Y then return false end
    if pos.Z ~= pos.Z then return false end
    if pos.Magnitude > 1e8 then return false end
    if pos.Y < -500 then return false end
    return true
end

