-- 🧠 DETECÇÃO INTELIGENTE DE ALVO (1 letra)
-- =======================================================
local function buscarAlvoPorTexto(search)
    search = search:lower():gsub("^%s+", ""):gsub("%s+$", "")
    if #search == 0 then return nil end

    -- 1) Prefixo (mais preciso)
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player then
            local nome = plr.Name:lower()
            if nome:sub(1, #search) == search then
                return plr
            end
        end
    end

    -- 2) Substring (fallback)
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player then
            if plr.Name:lower():find(search, 1, true) then
                return plr
            end
        end
    end

    return nil
end

