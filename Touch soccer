local function extrairAnimationId(assetId)
    local sucesso, resultado = pcall(function()
        local objetos = game:GetObjects("rbxassetid://" .. tostring(assetId))
        for _, obj in pairs(objetos) do
            if obj:IsA("Animation") then return obj.AnimationId end
            local child = obj:FindFirstChildWhichIsA("Animation", true)
            if child then return child.AnimationId end
        end
        return nil
    end)
    if sucesso and resultado then
        print("✅ AnimationId extraído:", resultado)
        return resultado
    else
        warn("❌ Falha ao extrair AnimationId:", assetId)
        return nil
    end
end

local function criarLoopAnimacao(humanoid, animationId, setTrackCallback, isStillActiveFn)
    local anim = Instance.new("Animation")
    anim.AnimationId = animationId
    local track = humanoid:LoadAnimation(anim)
    track.Looped = true
    track.Priority = Enum.AnimationPriority.Action4
    track:Play()
    setTrackCallback(track)

    local conn = track.Stopped:Connect(function()
        if not isStillActiveFn or not isStillActiveFn() then return end
        task.wait(0.05)
        if not isStillActiveFn() then return end
        local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if h and track.Parent == h then
            local ok = pcall(function() track:Play(0) end)
            if not ok then
                local novo = h:LoadAnimation(anim)
                novo.Looped = true
                novo.Priority = Enum.AnimationPriority.Action4
                novo:Play()
                setTrackCallback(novo)
            end
        end
    end)
    return conn
end

-- =======================================================
-- 🛡️ ANTI-DUMPING / TEAM
-- =======================================================
local transparentFrameCache = nil

local function tenhoTeam()
    if player.Team ~= nil then return true end
    local char = player.Character
    if char then
        for _, obj in pairs(char:GetChildren()) do
            if obj.Name:match("^Team%d+$") then return true end
            if obj.Name == "Team" and (obj:IsA("NumberValue") or obj:IsA("IntValue")) then
                if obj.Value and obj.Value > 0 then return true end
            end
        end
    end
    return false
end

local function encontrarTransparentFrame()
    if transparentFrameCache and transparentFrameCache.Parent and transparentFrameCache:IsDescendantOf(workspace) then
        return transparentFrameCache
    end
    local joinPortal = workspace:FindFirstChild("JoinPortal")
    if joinPortal then
        local frame = joinPortal:FindFirstChild("TransparentFrame")
        if frame and frame:IsA("BasePart") then
            transparentFrameCache = frame
            return frame
        end
    end
    local newTouch = workspace:FindFirstChild("PortalNewTouchFootball")
    if newTouch then
        local frame = newTouch:FindFirstChild("TransparentFrame")
        if frame and frame:IsA("BasePart") then
            transparentFrameCache = frame
            return frame
        end
    end
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj.Name == "TransparentFrame" and obj:IsA("BasePart") then
            transparentFrameCache = obj
            return obj
        end
    end
    return nil
end

local function teleportarProTransparentFrame()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local frame = encontrarTransparentFrame()
    if not frame then return end
    local targetPos = frame.Position + Vector3.new(0, 3, 0)
    if not posicaoValida(targetPos) then return end
    hrp.CFrame = CFrame.new(targetPos)
    pararMeuMovimento()
end

local function garantirTeam(continuar)
    if tenhoTeam() then continuar(); return end
    teleportarProTransparentFrame()
    task.spawn(function()
        local tempo = 0
        while not tenhoTeam() and tempo < TEAM_WAIT_TIMEOUT do
            task.wait(0.1)
            tempo = tempo + 0.1
        end
        if tenhoTeam() then continuar() end
    end)
end

