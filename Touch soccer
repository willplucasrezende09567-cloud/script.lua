-- =======================================================
-- 🏃 SPEED LOOP AUTOMÁTICO
-- =======================================================
local function aplicarSpeed()
    local char = player.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health > 0 then
            humanoid.WalkSpeed = WALK_SPEED
        end
    end
end

task.spawn(function()
    while true do
        if speedLoopAtivo then
            aplicarSpeed()
        end
        task.wait(0.2)
    end
end)

-- Reaplica o speed após respawn se estiver ativo
player.CharacterAdded:Connect(function()
    task.wait(1)
    if speedLoopAtivo then
        aplicarSpeed()
    end
end)

-- Ativação do Botão
btnMain.MouseButton1Click:Connect(function()
    seguirBolaAtivado = not seguirBolaAtivado
    speedLoopAtivo = seguirBolaAtivado

    if seguirBolaAtivado then
        btnMain.Text = "skill [ON]"
        btnMain.TextColor3 = Color3.fromRGB(0, 255, 255)
        btnStroke.Color = Color3.fromRGB(0, 255, 255)
        btnMain.BackgroundColor3 = Color3.fromRGB(0, 100, 100)
        aplicarSpeed()
    else
        btnMain.Text = "skill [OFF]"
        btnMain.TextColor3 = Color3.fromRGB(150, 150, 150)
        btnStroke.Color = Color3.fromRGB(80, 80, 80)
        btnMain.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
        -- Restaura velocidade padrão
        local char = player.Character
        if char then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.WalkSpeed = 16
                humanoid.PlatformStand = false
                humanoid.AutoRotate = true
            end
        end
    end
end)

-- =======================================================
-- LÓGICA DA FUNÇÃO (SÓ ATIVA SE A BOLA EXISTIR)
-- =======================================================
local function encontrarBola()
    local campo = workspace:FindFirstChild("FootballField")
    if campo then
        local bola = campo:FindFirstChild("SoccerBall") or campo:FindFirstChild("ServerSoccerBall")
        if bola then return bola end
    end
    for _, obj in pairs(workspace:GetDescendants()) do
        if (obj.Name == "SoccerBall" or obj.Name == "ServerSoccerBall") and obj:IsA("BasePart") then
            return obj
        end
    end
    return nil
end

runService.RenderStepped:Connect(function()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end

    if seguirBolaAtivado then
        if not bolaAlvo or not bolaAlvo.Parent then
            bolaAlvo = encontrarBola()
        end

        if bolaAlvo then
            humanoid.PlatformStand = true
            humanoid.AutoRotate = false

            local targetPos = Vector3.new(
                bolaAlvo.Position.X,
                alturaFixa,
                bolaAlvo.Position.Z
            )

            local camera = workspace.CurrentCamera
            local camLook = camera.CFrame.LookVector
            local flatLook = Vector3.new(camLook.X, 0, camLook.Z).Unit

            local baseCFrame = CFrame.new(targetPos, targetPos + flatLook)
            hrp.CFrame = baseCFrame * CFrame.Angles(math.rad(inclinacaoX), 0, 0)

            hrp.Velocity = Vector3.new(0, 0, 0)
            hrp.RotVelocity = Vector3.new(0, 0, 0)
        else
            humanoid.PlatformStand = false
            humanoid.AutoRotate = true
        end
    end
end)
