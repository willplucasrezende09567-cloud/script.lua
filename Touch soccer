-- =======================================================
-- 🔍 ENCONTRAR BOLA
-- =======================================================
local function encontrarBola()
    local campo = workspace:FindFirstChild("FootballField")
    if campo then
        local bola = campo:FindFirstChild("SoccerBall") or campo:FindFirstChild("ServerSoccerBall")
        if bola then return bola end
    end
    for _, obj in pairs(workspace:GetDescendants()) do
        if (obj.Name == "SoccerBall" or obj.Name == "ServerSoccerBall") and obj:IsA("BasePart") then
            return obj
        end
    end
    return nil
end

local function bolaValida()
    if not bolaAlvo then return false end
    if not bolaAlvo.Parent then return false end
    if not bolaAlvo:IsDescendantOf(workspace) then return false end
    if not bolaAlvo:IsA("BasePart") then return false end
    return true
end

-- =======================================================
-- 🌀 FLING BALL
-- =======================================================
local function pausarFlingAgora()
    if not flingRodandoAgora then return end
    flingRodandoAgora = false

    if flingAnimConnection then
        flingAnimConnection:Disconnect()
        flingAnimConnection = nil
    end
    if flingAnimationTrack then
        flingAnimationTrack:Stop()
        flingAnimationTrack = nil
    end

    for part, value in pairs(originalCanCollide) do
        if part and part.Parent then part.CanCollide = value end
    end
    originalCanCollide = {}

    local char = player.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
            humanoid.AutoRotate = true
        end
    end
end

local function ativarFlingAgora()
    if flingRodandoAgora then return end
    local char = player.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    originalCanCollide = {}
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            originalCanCollide[part] = part.CanCollide
            part.CanCollide = false
        end
    end

    humanoid.PlatformStand = true
    humanoid.AutoRotate = false
    flingRodandoAgora = true
    flingAngle = 0

    if not flingAnimationId then
        flingAnimationId = extrairAnimationId(FLING_ANIMATION_ASSET_ID)
    end
    if flingAnimationId then
        if flingAnimConnection then flingAnimConnection:Disconnect() end
        flingAnimConnection = criarLoopAnimacao(humanoid, flingAnimationId,
            function(t) flingAnimationTrack = t end,
            function() return flingRodandoAgora end
        )
    end
end

function desativarFlingBall()
    flingBallAtivado = false
    pausarFlingAgora()

    if flingConnection then
        flingConnection:Disconnect()
        flingConnection = nil
    end

    atualizarVisualFling(false)
end

local function ativarFlingBall()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    ativarFlingAgora()

    if flingConnection then flingConnection:Disconnect() end
    flingConnection = runService.Heartbeat:Connect(function(dt)
        if not flingBallAtivado then return end
        local c = player.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h then return end

        if not bolaValida() then
            bolaAlvo = encontrarBola()
        end

        if not bolaValida() then
            pausarFlingAgora()
            return
        end

        if not flingRodandoAgora then
            ativarFlingAgora()
        end

        flingAngle = flingAngle + dt * FLING_VELOCIDADE
        local offset = Vector3.new(
            math.cos(flingAngle) * FLING_RAIO,
            0,
            math.sin(flingAngle) * FLING_RAIO
        )
        local targetPos = bolaAlvo.Position + Vector3.new(0, FLING_ALTURA, 0) + offset

        h.CFrame = CFrame.new(targetPos)
        h.AssemblyLinearVelocity = offset.Unit * FLING_FORCA
        h.AssemblyAngularVelocity = Vector3.new(0, FLING_FORCA * 2, 0)

        if h.Velocity.Magnitude < 1 then
            h.AssemblyLinearVelocity = offset.Unit * FLING_FORCA
        end
    end)
end

