-- =======================================================
-- 🎯 AUTO-DETECÇÃO DE GOL
-- =======================================================
local function encontrarSpawnMaisProximo(minhaPos, prefixo)
    local melhorDist = math.huge
    local melhorPos = nil

    local campo = workspace:FindFirstChild("FootballField")
    if not campo then return nil, math.huge end

    local prefixoLower = prefixo:lower()
    local padrao = "^" .. prefixoLower .. "[_%-]?%d+$"

    for _, sp in pairs(campo:GetDescendants()) do
        if sp:IsA("BasePart") then
            local nomeLower = sp.Name:lower()
            if nomeLower:match(padrao) then
                local d = (minhaPos - sp.Position).Magnitude
                if d < melhorDist then
                    melhorDist = d
                    melhorPos = sp.Position
                end
            end
        end
    end

    return melhorPos, melhorDist
end

local function detectarGolAutomatico(forcar)
    if not AUTO_GOL_ATIVADO then return end
    if golJaDetectadoNesseSpawn and not forcar then return end
    if not tenhoTeam() then return end
    if not existeBolaNoMapa() then return end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local minhaPos = hrp.Position
    local posA, distA = encontrarSpawnMaisProximo(minhaPos, "SpawnA")
    local posB, distB = encontrarSpawnMaisProximo(minhaPos, "SpawnB")

    if not posA or not posB then return end

    local golDetectado
    if distA < distB then
        golDetectado = 2
    else
        golDetectado = 1
    end

    golSelecionado = golDetectado
    golJaDetectadoNesseSpawn = true
end

-- ►►► NOVO: sincroniza o gol com o time atual (roda mesmo em modo manual) ◄◄◄
local function sincronizarGolComTeam()
    golJaDetectadoNesseSpawn = false
    task.spawn(function()
        for _ = 1, 10 do
            task.wait(0.3)
            if tenhoTeam() and existeBolaNoMapa() then
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then continue end

                local minhaPos = hrp.Position
                local posA, distA = encontrarSpawnMaisProximo(minhaPos, "SpawnA")
                local posB, distB = encontrarSpawnMaisProximo(minhaPos, "SpawnB")
                if not posA or not posB then continue end

                -- Perto do SpawnA → ataca o Goal B (2)
                -- Perto do SpawnB → ataca o Goal A (1)
                local novoGol = (distA < distB) and 2 or 1
                golSelecionado = novoGol
                golJaDetectadoNesseSpawn = true
                atualizarBotoesGoalGlobal()

                if AUTO_GOL_ATIVADO and not seguirBolaAtivado then
                    ativarSkill()
                end
                return
            end
        end
    end)
end
