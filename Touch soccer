-- =======================================================
-- 🌀 FLING BALL
-- =======================================================
local function pausarFlingAgora()
    if not flingRodandoAgora then return end
    flingRodandoAgora = false
    for part, value in pairs(originalCanCollide) do
        if part and part.Parent then part.CanCollide = value end
    end
    originalCanCollide = {}
    local char = player.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
            humanoid.AutoRotate = true
        end
    end
    pararMeuMovimento()
end

local function ativarFlingAgora()
    if flingRodandoAgora then return end
    local char = player.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    originalCanCollide = {}
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            originalCanCollide[part] = part.CanCollide
            part.CanCollide = false
        end
    end
    humanoid.PlatformStand = true
    humanoid.AutoRotate = false
    flingRodandoAgora = true
    flingAngle = 0
end

function desativarFlingBall()
    flingBallAtivado = false
    pausarFlingAgora()
    if flingConnection then
        flingConnection:Disconnect()
        flingConnection = nil
    end
    headFlingZerarAte = tick() + HEAD_FLING_ZERAR_DURACAO
    pararMeuMovimento()
    atualizarVisualFling(false)
end

local function ativarFlingBall()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end
    ativarFlingAgora()
    if flingConnection then flingConnection:Disconnect() end
    flingConnection = runService.Heartbeat:Connect(function(dt)
        if not flingBallAtivado then return end
        local c = player.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h then return end
        if not bolaAlvo or not bolaAlvo.Parent then
            bolaAlvo = encontrarBola()
        end
        if not bolaAlvo or not bolaAlvo.Parent then pausarFlingAgora(); return end
        if not flingRodandoAgora then ativarFlingAgora() end
        flingAngle = flingAngle + dt * FLING_VELOCIDADE
        local offset = Vector3.new(math.cos(flingAngle) * FLING_RAIO, 0, math.sin(flingAngle) * FLING_RAIO)
        local targetPos = bolaAlvo.Position + Vector3.new(0, FLING_ALTURA, 0) + offset
        h.CFrame = CFrame.new(targetPos)
        h.AssemblyLinearVelocity = offset.Unit * FLING_FORCA
        h.AssemblyAngularVelocity = Vector3.new(0, FLING_FORCA * 2, 0)
        if h.Velocity.Magnitude < 1 then
            h.AssemblyLinearVelocity = offset.Unit * FLING_FORCA
        end
    end)
end

