end

local function startFreezeAll()
    isFreezing = true
    freezeThread = task.spawn(function()
        while isFreezing do
            local ball = getBall()
            if ball then
                safeFire(TOKEN, USER_ID, "", ball.Position, Vector3.new(0,0,0), Vector3.new(0,0,0))
            end
            task.wait(CONFIG_VALUES.freezeDelay)
        end
    end)
end

local function stopFreeze()
    isFreezing = false
    if freezeThread then task.cancel(freezeThread) freezeThread = nil end
end

local function startBoostAll()
    boostAllThread = task.spawn(function()
        while isBoostingAll do
            local ball = getBall()
            if ball then
                local vel = ball.Velocity
                local speed = vel.Magnitude
                if speed > 5 and speed < CONFIG_VALUES.boostMaxSpeed then
                    local targetSpeed = math.min(speed * boostMultiplier, CONFIG_VALUES.boostMaxSpeed)
                    safeFire(TOKEN, USER_ID, "", ball.Position, vel.Unit * targetSpeed, Vector3.new(0,0,0))
                end
            end
            task.wait(CONFIG_VALUES.boostDelay)
        end
    end)
end

