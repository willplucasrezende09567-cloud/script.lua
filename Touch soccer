-- =======================================================
-- LÓGICA DA FUNÇÃO (SÓ ATIVA SE A BOLA EXISTIR)
-- =======================================================
local function encontrarBola()
    local campo = workspace:FindFirstChild("FootballField")
    if campo then
        local bola = campo:FindFirstChild("SoccerBall") or campo:FindFirstChild("ServerSoccerBall")
        if bola then return bola end
    end
    for _, obj in pairs(workspace:GetDescendants()) do
        if (obj.Name == "SoccerBall" or obj.Name == "ServerSoccerBall") and obj:IsA("BasePart") then
            return obj
        end
    end
    return nil
end

runService.RenderStepped:Connect(function()
    local camera = workspace.CurrentCamera
    if not camera then return end

    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end

    if seguirBolaAtivado then
        if not bolaAlvo or not bolaAlvo.Parent then
            bolaAlvo = encontrarBola()
        end

        if bolaAlvo then
            humanoid.PlatformStand = true
            humanoid.AutoRotate = false

            local targetPos = Vector3.new(
                bolaAlvo.Position.X,
                alturaFixa,
                bolaAlvo.Position.Z
            )

            -- 🎯 DIREÇÃO: se tem gol selecionado, vira pro gol. Senão, segue a câmera.
            local lookDir
            if golSelecionado > 0 then
                local goal = GOALS[golSelecionado]
                if goal then
                    local dir = goal.pos - targetPos
                    lookDir = Vector3.new(dir.X, 0, dir.Z).Unit
                end
            end
            if not lookDir then
                local camLook = camera.CFrame.LookVector
                lookDir = Vector3.new(camLook.X, 0, camLook.Z).Unit
            end

            -- 🎥 CÂMERA NÃO É MAIS MOVIDA — só rotaciona o personagem
            local baseCFrame = CFrame.new(targetPos, targetPos + lookDir)
            hrp.CFrame = baseCFrame * CFrame.Angles(math.rad(inclinacaoX), 0, 0)

            hrp.Velocity = Vector3.new(0, 0, 0)
            hrp.RotVelocity = Vector3.new(0, 0, 0)
        else
            -- 🟥 BOLA SUMIU: só reseta o humanoid, MANTÉM golSelecionado ativado
            humanoid.PlatformStand = false
            humanoid.AutoRotate = true
        end
    end
end)
