    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    ativarHeadFlingAgora()

    if headFlingConnection then headFlingConnection:Disconnect() end
    headFlingConnection = runService.Heartbeat:Connect(function(dt)
        if not headFlingAtivado then return end
        local c = player.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h then return end

        -- Sem alvo válido: pausa (mantém botão ON)
        if not headFlingAlvo or not headFlingAlvo.Parent or not headFlingAlvo.Character then
            pausarHeadFlingAgora()
            return
        end

        local alvoChar = headFlingAlvo.Character
        local alvoHRP = alvoChar:FindFirstChild("HumanoidRootPart")
        local alvoHum = alvoChar:FindFirstChildOfClass("Humanoid")

        if not alvoHRP or not alvoHum or alvoHum.Health <= 0 then
            pausarHeadFlingAgora()
            return
        end

        -- 🔍 Verifica se o alvo foi arremessado (velocidade subiu muito)
        local velAlvo = alvoHRP.AssemblyLinearVelocity
        local velMag = velAlvo.Magnitude
        if velMag > HEAD_FLING_VEL_LIMITE then
            -- 🎯 Alvo arremessado! Para automaticamente (mantém botão ON)
            pausarHeadFlingAgora()
            return
        end

        -- Retoma se pausado e alvo voltou
        if not headFlingRodandoAgora then
            ativarHeadFlingAgora()
        end

        -- 🚶 Detecta se o alvo está andando
        local velFlat = Vector3.new(velAlvo.X, 0, velAlvo.Z)
        local alvoAndando = velFlat.Magnitude > 3

        local targetPos
        if alvoAndando then
            -- 3 studs na frente da direção que ele tá indo
            local dir = velFlat.Unit
            targetPos = alvoHRP.Position + dir * HEAD_FLING_FRENTE + Vector3.new(0, HEAD_FLING_ALTURA, 0)
        else
            -- Em cima da cabeça
            targetPos = alvoHRP.Position + Vector3.new(0, HEAD_FLING_ALTURA + 2, 0)
        end

        -- 💥 Teleporta + empurra PRA BAIXO
        h.CFrame = CFrame.new(targetPos)
        h.AssemblyLinearVelocity = Vector3.new(0, -HEAD_FLING_FORCA, 0)
        h.AssemblyAngularVelocity = Vector3.new(0, HEAD_FLING_FORCA, 0)
    end)
end

