-- =======================================================
-- 🔄 AUTO-REJOIN (autorj estilo Infinity Yield)
-- =======================================================
local REJOIN_PLACE_ID = game.PlaceId
local REJOIN_JOB_ID = game.JobId
local rejoinJaDisparou = false

local function tentarRejoin(motivo)
    if not AUTO_REJOIN_ATIVADO then return end
    if rejoinJaDisparou then return end
    rejoinJaDisparou = true

    print("🔄 [autorj] Detectado:", motivo, "— tentando reconectar...")

    task.spawn(function()
        for tentativa = 1, AUTO_REJOIN_TENTATIVAS do
            task.wait(AUTO_REJOIN_DELAY)
            local sucesso = pcall(function()
                TeleportService:TeleportToPlaceInstance(REJOIN_PLACE_ID, REJOIN_JOB_ID, player)
            end)
            if sucesso then
                print("✅ [autorj] Rejoin enviado! Tentativa", tentativa)
                break
            else
                warn("⚠️ [autorj] Tentativa", tentativa, "falhou, tentando de novo...")
            end
        end
    end)
end

if AUTO_REJOIN_ATIVADO then
    -- 🎯 Detecta kick via mudança de parent do LocalPlayer
    task.spawn(function()
        while true do
            task.wait(0.1)
            if not player or not player.Parent then
                tentarRejoin("player saiu / kick (AncestryChanged)")
                break
            end
        end
    end)

    -- 🎯 Detecta kick via PlayerRemoving (quando o servidor te remove)
    Players.PlayerRemoving:Connect(function(plr)
        if plr == player then
            tentarRejoin("PlayerRemoving (kick do servidor)")
        end
    end)

    -- 🎯 Detecta fechamento do jogo (game.OnClose)
    game.OnClose = function()
        tentarRejoin("game.OnClose (servidor fechando)")
    end
end

