local function posicaoValida(pos)
    if not pos then return false end
    if pos.X ~= pos.X then return false end
    if pos.Y ~= pos.Y then return false end
    if pos.Z ~= pos.Z then return false end
    if pos.Magnitude > 1e8 then return false end
    if pos.Y < -500 then return false end
    return true
end

