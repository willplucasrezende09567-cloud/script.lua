-- ============================================================
local function processCommand(msg)
    local m = msg:lower():gsub("^%s+", ""):gsub("%s+$", "")
    
    if m == ";cmdbar2" then toggleCmdBar(); return end
    if m == ";cmds" then toggleCmds(); return end
    
    if m == ";loop goal a" then
        stopEverything(); selectedGoalIndex = 1; updateGoalButtons()
        isActive = true; setBtnActive(Button, "AUTO-GOL: ATIVADO")
        startAutoGoal(); return
    end
    if m == ";loop goal b" then
        stopEverything(); selectedGoalIndex = 2; updateGoalButtons()
        isActive = true; setBtnActive(Button, "AUTO-GOL: ATIVADO")
        startAutoGoal(); return
    end
    if m == ";unloop goal a" or m == ";unloop goal b" then
        isActive = false
        if loopThread then task.cancel(loopThread) loopThread = nil end
        setBtnInactive(Button, "AUTO-GOL: DESATIVADO"); return
    end
    if m == ";gol a" then fireSingleKick(1); return end
    if m == ";gol b" then fireSingleKick(2); return end
    
    if m == ";bringball" then
        stopEverything(); isBringing = true
        setBtnActive(BringBtn, "BRING BALL: ATIVADO")
        startBring(); return
    end
    if m == ";unbringball" then
        isBringing = false
        if bringThread then task.cancel(bringThread) bringThread = nil end
        setBtnInactive(BringBtn, "BRING BALL: DESATIVADO"); return
    end
    
    if m == ";loopbring" then
        stopEverything(); isLoopBringing = true
        setBtnActive(LoopBringBtn, "LOOP BRING: ATIVADO")
        startLoopBring(); return
    end
    if m == ";unloopbring" then
        isLoopBringing = false
        if loopBringThread then task.cancel(loopBringThread) loopBringThread = nil end
        setBtnInactive(LoopBringBtn, "LOOP BRING: DESATIVADO"); return
    end
    
    if m == ";skyball" then
        stopEverything(); isSkying = true
        setBtnActive(SkyBtn, "SKY BALL: ATIVADO")
        startSky(); return
    end
    if m == ";unskyball" then
        isSkying = false
        if skyThread then task.cancel(skyThread) skyThread = nil end
        setBtnInactive(SkyBtn, "SKY BALL: DESATIVADO"); return
    end
    
    if m == ";freezeball all" or m == ";freezeball" then
        stopEverything(); setBtnActive(FreezeAllBtn, "FREEZE ALL: ATIVADO")
        startFreezeAll(); return
    end
    if m == ";unfreezeball all" or m == ";unfreezeball" then
        stopFreeze()
        setBtnInactive(FreezeAllBtn, "FREEZE ALL: DESATIVADO"); return
    end
    
    if m == ";boostme" then
        if not oldNamecall then return end
        stopEverything(); isBoostingMe = true
        setBtnActive(BoostMeBtn, "BOOST ME: ATIVADO (" .. boostMultiplier .. "x)"); return
    end
    if m == ";unboostme" then
        isBoostingMe = false
        setBtnInactive(BoostMeBtn, "BOOST ME: DESATIVADO"); return
    end
    if m == ";boostall" then
        stopEverything(); isBoostingAll = true
        setBtnActive(BoostAllBtn, "BOOST ALL: ATIVADO (" .. boostMultiplier .. "x)")
        startBoostAll(); return
    end
    if m == ";unboostall" then
        isBoostingAll = false
        if boostAllThread then task.cancel(boostAllThread) boostAllThread = nil end
        setBtnInactive(BoostAllBtn, "BOOST ALL: DESATIVADO"); return
    end
    
    if m == ";touchgoal" then
        stopEverything(); isTouchGoal = true
        setBtnActive(TouchGoalBtn, "TOUCH GOAL: ATIVADO")
        startTouchGoal(); return
    end
    if m == ";untouchgoal" then
        isTouchGoal = false
        if touchGoalThread then task.cancel(touchGoalThread) touchGoalThread = nil end
        setBtnInactive(TouchGoalBtn, "TOUCH GOAL: DESATIVADO"); return
    end
    
    if m == ";moveball" then
        stopEverything(); isMoveBall = true
        setBtnActive(MoveBallBtn, "MOVE BALL: ATIVADO")
        startMoveBall(); return
    end
    if m == ";unmoveball" then
        isMoveBall = false
        if moveBallThread then task.cancel(moveBallThread) moveBallThread = nil end
        setBtnInactive(MoveBallBtn, "MOVE BALL: DESATIVADO"); return
    end
    
    if m == ";orbitball" then
        stopEverything(); isOrbitBall = true
        setBtnActive(OrbitBallBtn, "ORBIT BALL: ATIVADO")
        startOrbitBall(); return
    end
    if m == ";unorbitball" then
        isOrbitBall = false
        if orbitBallThread then task.cancel(orbitBallThread) orbitBallThread = nil end
        setBtnInactive(OrbitBallBtn, "ORBIT BALL: DESATIVADO"); return
    end
    
    local mult = m:match("^;boostmult%s+(%d+)$")
    if mult then
        local v = math.clamp(tonumber(mult), 1, 6)
        Knob.Position = UDim2.new((v-1)/5, -11, 0.5, -11); updateDots(v); return
    end
end

