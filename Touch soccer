local function resetarBotaoSkill()
    seguirBolaAtivado = false
    speedLoopAtivo = false
    atualizarVisualSkill(false)
end

local function resetarSpeed()
    local char = player.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = 16
            humanoid.PlatformStand = false
            humanoid.AutoRotate = true
        end
    end
    headFlingZerarAte = tick() + HEAD_FLING_ZERAR_DURACAO
