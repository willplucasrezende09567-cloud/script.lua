local function pausarWallPhaseAgora()
    if not wallPhaseRodandoAgora then return end
    wallPhaseRodandoAgora = false
    if wallPhaseAnimConnection then wallPhaseAnimConnection:Disconnect(); wallPhaseAnimConnection = nil end
    if wallPhaseAnimationTrack then wallPhaseAnimationTrack:Stop(); wallPhaseAnimationTrack = nil end
    for part, value in pairs(originalCanCollide) do
        if part and part.Parent then part.CanCollide = value end
    end
    originalCanCollide = {}
    local char = player.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
            humanoid.AutoRotate = true
        end
    end
    pararMeuMovimento()
end

local function ativarWallPhaseAgora()
    if wallPhaseRodandoAgora then return end
    local char = player.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    originalCanCollide = {}
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            originalCanCollide[part] = part.CanCollide
            part.CanCollide = false
        end
    end
    humanoid.PlatformStand = true
    humanoid.AutoRotate = false
    wallPhaseRodandoAgora = true
    if not wallPhaseAnimationId then
        wallPhaseAnimationId = extrairAnimationId(WALL_PHASE_ANIMATION_ASSET_ID)
    end
    if wallPhaseAnimationId then
        if wallPhaseAnimConnection then wallPhaseAnimConnection:Disconnect() end
        wallPhaseAnimConnection = criarLoopAnimacao(humanoid, wallPhaseAnimationId,
            function(t) wallPhaseAnimationTrack = t end,
            function() return wallPhaseRodandoAgora end
        )
    end
end

function desativarWallPhase()
    wallPhaseAtivado = false
    pausarWallPhaseAgora()
    if wallPhaseConnection then
        wallPhaseConnection:Disconnect()
        wallPhaseConnection = nil
    end
    headFlingZerarAte = tick() + HEAD_FLING_ZERAR_DURACAO
    pararMeuMovimento()
    atualizarVisualWallPhase(false)
end

local function ativarWallPhase()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end
    ativarWallPhaseAgora()
    if wallPhaseConnection then wallPhaseConnection:Disconnect() end
    wallPhaseConnection = runService.Heartbeat:Connect(function(dt)
        if not wallPhaseAtivado then return end
        local c = player.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h then return end
        if not bolaAlvo or not bolaAlvo.Parent then
            bolaAlvo = encontrarBola()
        end
        if not bolaAlvo or not bolaAlvo.Parent then pausarWallPhaseAgora(); return end
        if not wallPhaseRodandoAgora then ativarWallPhaseAgora() end
        local targetPos = Vector3.new(bolaAlvo.Position.X, WALL_PHASE_ALTURA, bolaAlvo.Position.Z)
        local camera = workspace.CurrentCamera
        local lookDir
        if golSelecionado > 0 then
            local goal = GOALS[golSelecionado]
            if goal then
                local dir = goal.pos - targetPos
                lookDir = Vector3.new(dir.X, 0, dir.Z).Unit
            end
        end
        if not lookDir and camera then
            local camLook = camera.CFrame.LookVector
            lookDir = Vector3.new(camLook.X, 0, camLook.Z).Unit
        end
        if not lookDir then lookDir = Vector3.new(0, 0, 1) end
        local baseCFrame = CFrame.new(targetPos, targetPos + lookDir)
        h.CFrame = baseCFrame * CFrame.Angles(math.rad(WALL_PHASE_INCLINACAO), 0, 0)
        h.Velocity = Vector3.new(0, 0, 0)
        h.RotVelocity = Vector3.new(0, 0, 0)
        if wallPhaseAnimationTrack and wallPhaseAnimationTrack.IsPlaying == false then
            pcall(function() wallPhaseAnimationTrack:Play(0) end)
        end
    end)
end

