local function iniciarSpectate(alvoPlayer)
    if not SPECTATE_ATIVADO then return end
    if not alvoPlayer or not alvoPlayer.Character then return end
    local camera = workspace.CurrentCamera
    if not camera then return end
    local humanoid = alvoPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    if not spectateOriginalSubject then
        spectateOriginalSubject = camera.CameraSubject
        spectateOriginalType = camera.CameraType
    end
    camera.CameraSubject = humanoid
    camera.CameraType = Enum.CameraType.Custom
end

local function pararSpectate()
    if not SPECTATE_ATIVADO then return end
    local camera = workspace.CurrentCamera
    if not camera then return end
    local meuHumanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if meuHumanoid then
        camera.CameraSubject = meuHumanoid
    elseif spectateOriginalSubject then
        camera.CameraSubject = spectateOriginalSubject
    end
    if spectateOriginalType then
        camera.CameraType = spectateOriginalType
    end
    spectateOriginalSubject = nil
    spectateOriginalType = nil
end

