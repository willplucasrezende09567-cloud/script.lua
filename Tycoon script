-- ==========================================
-- 3. LÓGICA DO AUTO ARMAS
-- ==========================================

local function teleportLoop()
    while isRunning do
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").Health > 0 then
            
            local hrp = char.HumanoidRootPart
            local targets = {}
            
            for _, v in pairs(game.Workspace:GetDescendants()) do
                if (v:IsA("Model") or v:IsA("Folder")) and string.lower(v.Name):find("gear") then
                    local part = v:FindFirstChild("Colour_2")
                    if part and part:IsA("BasePart") then
                        table.insert(targets, part)
                    end
                end
            end

            if #targets > 0 then
                for i, part in ipairs(targets) do
                    if not isRunning then break end
                    if not char.Parent then break end
                    
                    hrp.CFrame = part.CFrame + Vector3.new(0, 5, 0)
                    task.wait(0.05) 
                end
            end
        end
        task.wait(0.2)
    end
end


-- ==========================================
-- 4. FUNÇÕES DROP E EQUIP
-- ==========================================

local function dropTools()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local dropCFrame = hrp.CFrame * CFrame.new(0, -2, -3)

    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = workspace
            if tool:FindFirstChild("Handle") then
                tool.Handle.CFrame = dropCFrame
            end
        end
    end

    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = workspace
            if tool:FindFirstChild("Handle") then
                tool.Handle.CFrame = dropCFrame
            end
        end
    end
    
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Sistema", Text = "Ferramentas dropadas!", Duration = 2
    })
end

local function equipTools()
    local char = player.Character
    if not char then return end

    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = char
        end
    end
    
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Sistema", Text = "Ferramentas equipadas!", Duration = 2
    })
end


-- ==========================================
-- 5. LÓGICA DO KILL ALL
-- ==========================================

local function killAllLoop()
    local players = game:GetService("Players")
    
    while getgenv().killall do
        pcall(function()
            local char = player.Character or player.CharacterAdded:Wait()
            local knife = char:FindFirstChildOfClass("Tool") or player.Backpack:FindFirstChildOfClass("Tool")
            
            if knife and knife.Parent == player.Backpack then 
                knife.Parent = char 
            end
            
            if knife then
                for _, targetPlayer in ipairs(players:GetPlayers()) do
                    if targetPlayer ~= player and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        task.spawn(function()
                            knife:Activate()
                            firetouchinterest(targetPlayer.Character.HumanoidRootPart, knife.Handle, 0)
                            firetouchinterest(targetPlayer.Character.HumanoidRootPart, knife.Handle, 1)
                        end)
                        task.wait(0.2)
                    end
                end
            end
        end)
        task.wait()
    end
end


