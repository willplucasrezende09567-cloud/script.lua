local player = game.Players.LocalPlayer

-- Variáveis de controle
local isRunning = false
getgenv().killall = false -- Começa desativado

-- ==========================================
-- 1. TELEPORTE AUTOMÁTICO PARA "Touch to claim!"
-- ==========================================
task.spawn(function()
    task.wait(1) -- Espera 1 segundo para garantir que o jogo carregou tudo
    
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    
    local targetPart = nil
    
    -- Procura em todo o Workspace
    for _, v in pairs(game.Workspace:GetDescendants()) do
        if v.Name == "Touch to claim!" then
            -- Se for uma parte, usa ela. Se for um Modelo/Pasta, pega a primeira parte dentro.
            if v:IsA("BasePart") then
                targetPart = v
            else
                targetPart = v:FindFirstChildWhichIsA("BasePart")
            end
            
            if targetPart then break end -- Para no primeiro que encontrar
        end
    end
    
    -- Se encontrou, teleporta
    if targetPart then
        hrp.CFrame = targetPart.CFrame + Vector3.new(0, 5, 0)
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Sistema", 
            Text = "Teleportado para Touch to claim!", 
            Duration = 3
        })
    else
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Aviso", 
            Text = "Nenhum 'Touch to claim!' encontrado.", 
            Duration = 3
        })
    end
end)


