-- ==================== HELPERS ====================
local function isCharacterPart(part)
    if not part then return true end
    local curr = part
    while curr and curr ~= Workspace do
        if curr:FindFirstChildOfClass("Humanoid") then return true end
        if Players:GetPlayerFromCharacter(curr) then return true end
        if curr:IsA("Accessory") or curr:IsA("Tool") then return true end
        curr = curr.Parent
    end
    return false
end

local function isActivePart(part)
    for _, data in pairs(modeData) do
        if data.set[part] then return true end
    end
    return false
end

local function clearMovers(v)
    for _, x in ipairs(v:GetChildren()) do
        if x:IsA("BodyMover") or x:IsA("RocketPropulsion")
        or x:IsA("AlignPosition") or x:IsA("Torque")
        or x:IsA("LinearVelocity") 
        or x.Name == "IY_Force" or x.Name == "NexusGravidBV" or x.Name:sub(1, 6) == "__nyx" then
            x:Destroy()
        end
    end
end

local function trackPart(mode, part)
    modeData[mode].set[part] = true
    table.insert(modeData[mode].list, part)
end

local function RetainPart(Part)
    if not Part or not Part:IsA("BasePart") then return end
    if not Part:IsDescendantOf(Workspace) then return end
    if isCharacterPart(Part) then return end
    nyxNetSet[Part] = true
    Part.CanCollide = false
    pcall(function() Part:SetNetworkOwner(LP) end)
end

local function ReleasePart(Part)
    if nyxNetSet[Part] then nyxNetSet[Part] = nil end
end

local function pushSimRadius()
    pcall(function() sethiddenproperty(LP, "SimulationRadius", math.huge) end)
    pcall(function() sethiddenproperty(LP, "MaxSimulationRadius", math.huge) end)
    pcall(function() LP.ReplicationFocus = Workspace end)
end

local function freezePart(part)
    if not part or not part.Parent then return end
    clearMovers(part)
    pcall(function()
        part.AssemblyLinearVelocity = Vector3.zero
        part.AssemblyAngularVelocity = Vector3.zero
    end)
    part.Anchored   = true
    part.CanCollide = true
    if not frozenSet[part] then
        frozenSet[part] = true
        table.insert(_G.NYX_CP_FROZEN, part)
    end
    ReleasePart(part)
end

-- CORREÇÃO: Só congela se a part NÃO ESTIVER ANCORADA
local function freezeTimePart(v)
    if not v or not v:IsA("BasePart") then return end
    if isCharacterPart(v) then return end
    if v.Anchored then return end -- AQUI: Ignora o chão e o que já tá preso
    
    if not frozenSet[v] then
        frozenSet[v] = true
        table.insert(_G.NYX_CP_FROZEN, v)
        trackPart("FREEZE", v)
    end
    
    pcall(function() v:SetNetworkOwner(LP) end)
    nyxNetSet[v] = true 
    
    clearMovers(v)
    v.AssemblyLinearVelocity = Vector3.zero
    v.AssemblyAngularVelocity = Vector3.zero
    v.Anchored = true
    v.CanCollide = true
end

local function unfreezeAll()
    local count = #_G.NYX_CP_FROZEN
    for _, p in ipairs(_G.NYX_CP_FROZEN) do
        if p and p.Parent then
            pcall(function()
                p.Anchored = false
                p.CanCollide = true
            end)
        end
    end
    _G.NYX_CP_FROZEN = {}
    frozenSet = {}
    return count
end

