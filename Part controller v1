-- ==================== MODES ====================
local function pullPart(v)
    if not v or not v:IsA("BasePart") then return end
    if v.Anchored or isActivePart(v) or frozenSet[v] then return end
    if isCharacterPart(v) or v.Parent == Folder then return end
    clearMovers(v); v.CanCollide = false

    local bv = Instance.new("BodyVelocity")
    bv.Name = "__nyxPullBV"
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.P = 5000
    bv.Velocity = Vector3.zero
    bv.Parent = v

    RetainPart(v); trackPart("PULL", v)
end

local function risePart(v)
    if not v or not v:IsA("BasePart") then return end
    if v.Anchored or isActivePart(v) or frozenSet[v] then return end
    if isCharacterPart(v) then return end
    clearMovers(v); v.CanCollide = false

    local bv = Instance.new("BodyVelocity")
    bv.Name = "__nyxRiseBV"
    bv.Velocity = Vector3.new(0, CFG.RISE_SPEED, 0)
    bv.MaxForce = Vector3.new(0, math.huge, 0)
    bv.P = 5000; bv.Parent = v

    RetainPart(v); trackPart("RISE", v)
end

local function sinkPart(v)
    if not v or not v:IsA("BasePart") then return end
    if v.Anchored or isActivePart(v) or frozenSet[v] then return end
    if isCharacterPart(v) then return end
    clearMovers(v); v.CanCollide = false

    local bv = Instance.new("BodyVelocity")
    bv.Name = "__nyxSinkBV"
    bv.Velocity = Vector3.new(0, -CFG.SINK_SPEED, 0)
    bv.MaxForce = Vector3.new(0, math.huge, 0)
    bv.P = 5000; bv.Parent = v

    RetainPart(v); trackPart("SINK", v)
end

local function vortexPart(v)
    if not v or not v:IsA("BasePart") then return end
    if v.Anchored or isActivePart(v) or frozenSet[v] then return end
    if isCharacterPart(v) then return end
    clearMovers(v); v.CanCollide = false
    RetainPart(v); trackPart("VORTEX", v)
end

local function repelPart(v)
    if not v or not v:IsA("BasePart") then return end
    if v.Anchored or isActivePart(v) or frozenSet[v] then return end
    if isCharacterPart(v) then return end
    clearMovers(v); v.CanCollide = false
    RetainPart(v); trackPart("REPEL", v)
end

local function launchPart(v, dir)
    if not v or not v:IsA("BasePart") then return end
    if v.Anchored or isActivePart(v) or frozenSet[v] then return end
    if isCharacterPart(v) then return end
    clearMovers(v); v.CanCollide = false

    local bv = Instance.new("BodyVelocity")
    bv.Name = "__nyxLaunchBV"
    bv.Velocity = dir * CFG.LAUNCH_SPEED
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.P = 5000; bv.Parent = v

    RetainPart(v); trackPart("LAUNCH", v)
end

local function orbitPart(v)
    if not v or not v:IsA("BasePart") then return end
    if v.Anchored or isActivePart(v) or frozenSet[v] then return end
    if isCharacterPart(v) then return end
    clearMovers(v); v.CanCollide = false

    local bp = Instance.new("BodyPosition")
    bp.Name = "__nyxOrbitBP"
    bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bp.P = 100000; bp.D = 1000; bp.Parent = v

    local bg = Instance.new("BodyGyro")
    bg.Name = "__nyxOrbitBG"
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 10000; bg.D = 1000; bg.Parent = v

    orbitOffsets[v] = { offset = math.random() * math.pi * 2, height = math.random(-3, 3) }
    RetainPart(v); trackPart("ORBIT", v)
end

-- ==================== STOP ====================
local function stopCurrentMode()
    local mode = currentMode
    currentMode = "NONE"
    local data = modeData[mode]
    if data then
        for _, p in ipairs(data.list) do
            if p and p.Parent then pcall(freezePart, p) end
        end
        modeData[mode] = { list = {}, set = {} }
    end
    if mode == "ORBIT" then orbitOffsets = {} end
    if mode == "PULL" then
        BlackHoleVisual.Transparency = 1
        BlackHoleCore.Transparency = 1
        BH_Light.Enabled = false
    end
end

-- ==================== LOOPS ====================
addConn(RunService.RenderStepped:Connect(function()
    if currentMode == "PULL" and savedPosition then
        PullTarget.CFrame = CFrame.new(savedPosition)
        BlackHoleVisual.CFrame = CFrame.new(savedPosition) * CFrame.Angles(math.random(), math.random(), math.random())
        BlackHoleCore.CFrame = BlackHoleVisual.CFrame
        
        BlackHoleVisual.Transparency = 0.5
        BlackHoleCore.Transparency = 0
        BH_Light.Enabled = true
    end
end))

addConn(RunService.Heartbeat:Connect(function()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if currentMode == "PULL" and savedPosition then
        local list = modeData.PULL.list
        for i = #list, 1, -1 do
            local p = list[i]
            if not p or not p.Parent then
                modeData.PULL.set[p] = nil; table.remove(list, i)
            elseif isCharacterPart(p) then
                clearMovers(p); modeData.PULL.set[p] = nil; table.remove(list, i)
            else
                local bv = p:FindFirstChild("__nyxPullBV")
                local dist = (p.Position - savedPosition).Magnitude
                
                if dist <= CFG.FREEZE_DIST then
                    freezePart(p); modeData.PULL.set[p] = nil; table.remove(list, i)
                else
                    if bv then
                        local dir = (savedPosition - p.Position).Unit
                        local suctionSpeed = math.clamp(1000 / (dist + 1), 30, 300)
                        bv.Velocity = dir * suctionSpeed
                    end
                end
            end
        end
        return
    end

    if not root then return end
    local center = root.Position

    if currentMode == "VORTEX" then
        for _, p in ipairs(modeData.VORTEX.list) do
            if p and p.Parent and not p.Anchored then
                local off = p.Position - center
                off = Vector3.new(off.X, 0, off.Z)
                if off.Magnitude > 1 then
                    local tangent = Vector3.new(-off.Z, 0, off.X).Unit
                    local inward  = -off.Unit * (CFG.VORTEX_SPEED * 0.15)
                    pcall(function() p.AssemblyLinearVelocity = tangent * CFG.VORTEX_SPEED + inward + Vector3.new(0, 2, 0) end)
                end
            end
        end
    elseif currentMode == "REPEL" then
        for _, p in ipairs(modeData.REPEL.list) do
            if p and p.Parent and not p.Anchored then
                local off = p.Position - center
                if off.Magnitude > 0.5 then
                    pcall(function() p.AssemblyLinearVelocity = off.Unit * CFG.REPEL_SPEED end)
                end
            end
        end
    elseif currentMode == "ORBIT" then
        local currentTime = tick() * CFG.ORBIT_SPEED
        for part, data in pairs(orbitOffsets) do
            if part and part.Parent then
                local bp = part:FindFirstChild("__nyxOrbitBP")
                local bg = part:FindFirstChild("__nyxOrbitBG")
                if bp and bg then
                    local angle = currentTime + data.offset
                    local targetPos = center + Vector3.new(
                        math.cos(angle) * CFG.ORBIT_DIST,
                        data.height,
                        math.sin(angle) * CFG.ORBIT_DIST
                    )
                    bp.Position = targetPos
                    bg.CFrame = CFrame.new(part.Position, center)
                else
                    orbitOffsets[part] = nil
                end
            else
                orbitOffsets[part] = nil
            end
        end
    end
end))

