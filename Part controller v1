_G.NYX_CP_RUNNING = true

task.spawn(function()
    while _G.NYX_CP_RUNNING and ScreenGui.Parent do
        task.wait(CFG.CAPTURE_INTERVAL)
        local m = currentMode
        if m == "RISE" or m == "SINK" or m == "VORTEX" or m == "REPEL" or m == "ORBIT" or m == "FREEZE" then
            local char = LP.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                local pos = root.Position
                for _, v in ipairs(Workspace:GetDescendants()) do
                    local isFreeze = (m == "FREEZE")
                    local radius = isFreeze and CFG.FREEZE_RADIUS or CFG.CAPTURE_RADIUS
                    
                    -- AQUI: Filtro global pra ignorar o que já tá ancorado no mapa
                    if v:IsA("BasePart") and not v.Anchored and not isCharacterPart(v) and (v.Position - pos).Magnitude <= radius then
                        if isFreeze then
                            if not frozenSet[v] then
                                freezeTimePart(v)
                            end
                        else
                            if not isActivePart(v) and not frozenSet[v] then
                                if m == "RISE" then risePart(v)
                                elseif m == "SINK" then sinkPart(v)
                                elseif m == "VORTEX" then vortexPart(v)
                                elseif m == "REPEL" then repelPart(v)
                                elseif m == "ORBIT" then orbitPart(v)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

